include "test"
| include "jq"
|

def assert_jq(program, input, expected):
  let result = jq_run_first(program, input)
  | assert_eq(result, expected)
end

def assert_jq_multi(program, input, expected):
  let result = jq_run(program, input)
  | assert_eq(result, expected)
end

# ===== Identity and Literals =====

def test_identity():
  assert_jq(".", 42, 42)
  | assert_jq(".", "hello", "hello")
  | assert_jq(".", None, None)
  | assert_jq(".", true, true)
  | assert_jq(".", [1,2,3], [1,2,3])
  | assert_jq(".", {"a":1}, {"a":1})
end

def test_literals():
  assert_jq("42", None, 42)
  | assert_jq("\"hello\"", None, "hello")
  | assert_jq("null", None, None)
  | assert_jq("true", None, true)
  | assert_jq("false", None, false)
end

# ===== Field Access =====

def test_field_access():
  assert_jq(".foo", {"foo": 42}, 42)
  | assert_jq(".foo.bar", {"foo": {"bar": 99}}, 99)
  | assert_jq(".missing", {"foo": 1}, None)
  | assert_jq(".foo", None, None)
end

# ===== Array Index =====

def test_array_index():
  assert_jq(".[0]", [1,2,3], 1)
  | assert_jq(".[2]", [1,2,3], 3)
  | assert_jq(".[-1]", [1,2,3], 3)
  | assert_jq(".[10]", [1,2,3], None)
end

# ===== Chained Selectors =====

def test_chained_selectors():
  assert_jq_multi(".[].test", [{"test": 1}, {"test": 2}], [1, 2])
  | assert_jq_multi(".users[].name", {"users": [{"name": "Ada"}, {"name": "Lin"}]}, ["Ada", "Lin"])
  | assert_jq_multi(".[].items[]", [{"items": [1, 2]}, {"items": [3]}], [1, 2, 3])
end

# ===== Array/String Slice =====

def test_slice():
  assert_jq(".[1:3]", [1,2,3,4,5], [2,3])
  | assert_jq(".[0:2]", "hello", "he")
  | assert_jq(".[:2]", [1,2,3], [1,2])
  | assert_jq(".[2:]", [1,2,3,4], [3,4])
end

# ===== Pipe =====

def test_pipe():
  assert_jq(". | . + 1", 5, 6)
  | assert_jq(".a | . * 2", {"a": 5}, 10)
end

# ===== Comma (stream) =====

def test_comma():
  assert_jq_multi("1, 2, 3", None, [1, 2, 3])
  | assert_jq_multi(".a, .b", {"a": 1, "b": 2}, [1, 2])
end

# ===== Array Constructor =====

def test_array_constructor():
  assert_jq("[1, 2, 3]", None, [1, 2, 3])
  | assert_jq("[.[] | . * 2]", [1,2,3], [2,4,6])
  | assert_jq("[.a, .b]", {"a": 1, "b": 2}, [1, 2])
end

# ===== Object Constructor =====

def test_object_constructor():
  assert_jq("{a: 1, b: 2}", None, {"a": 1, "b": 2})
  | assert_jq("{x: .foo}", {"foo": 42}, {"x": 42})
end

# ===== Arithmetic =====

def test_arithmetic():
  assert_jq(". + 1", 5, 6)
  | assert_jq(". - 1", 5, 4)
  | assert_jq(". * 3", 4, 12)
  | assert_jq(". / 2", 10, 5)
  | assert_jq(". % 3", 7, 1)
  | assert_jq(".a + .b", {"a": 1, "b": 2}, 3)
end

# ===== String Operations =====

def test_string_ops():
  assert_jq(". + \" world\"", "hello", "hello world")
  | assert_jq("startswith(\"he\")", "hello", true)
  | assert_jq("endswith(\"lo\")", "hello", true)
  | assert_jq("ascii_downcase", "HELLO", "hello")
  | assert_jq("ascii_upcase", "hello", "HELLO")
  | assert_jq("split(\",\")", "a,b,c", ["a","b","c"])
  | assert_jq("join(\",\")", ["a","b","c"], "a,b,c")
  | assert_jq("ltrimstr(\"he\")", "hello", "llo")
  | assert_jq("rtrimstr(\"llo\")", "hello", "he")
end

# ===== Comparison =====

def test_comparison():
  assert_jq(". == 42", 42, true)
  | assert_jq(". != 42", 43, true)
  | assert_jq(". < 10", 5, true)
  | assert_jq(". > 10", 5, false)
  | assert_jq(". <= 5", 5, true)
  | assert_jq(". >= 5", 5, true)
end

# ===== Boolean Logic =====

def test_boolean():
  assert_jq("true and false", None, false)
  | assert_jq("true or false", None, true)
  | assert_jq("true | not", None, false)
  | assert_jq("null | not", None, true)
end

# ===== Alternative Operator =====

def test_alternative():
  assert_jq(". // 42", None, 42)
  | assert_jq(". // 42", false, 42)
  | assert_jq(". // 42", 99, 99)
end

# ===== If-Then-Else =====

def test_if_then_else():
  assert_jq("if . > 0 then \"pos\" else \"neg\" end", 5, "pos")
  | assert_jq("if . > 0 then \"pos\" else \"neg\" end", -3, "neg")
  | assert_jq("if . == 1 then \"one\" elif . == 2 then \"two\" else \"other\" end", 2, "two")
end

# ===== Try-Catch =====

def test_try_catch():
  assert_jq("try .foo catch \"err\"", "not_object", "err")
  | assert_jq("try error(\"boom\") catch \"caught\"", None, "caught")
end

# ===== Length =====

def test_length():
  assert_jq("length", [1,2,3], 3)
  | assert_jq("length", "hello", 5)
  | assert_jq("length", {"a":1,"b":2}, 2)
  | assert_jq("length", None, 0)
  | assert_jq("length", -5, 5)
end

# ===== Keys and Values =====

def test_keys_values():
  assert_jq("keys", {"b":2,"a":1}, ["a","b"])
  | assert_jq("keys", [10,20,30], [0,1,2])
  | assert_jq("[.[] | values]", {"a":1,"b":None}, [1])
  | assert_jq("values", 42, 42)
  | assert_jq_multi("values", None, [])
end

# ===== Has =====

def test_has():
  assert_jq("has(\"foo\")", {"foo":1}, true)
  | assert_jq("has(\"bar\")", {"foo":1}, false)
  | assert_jq("has(0)", [1,2,3], true)
  | assert_jq("has(5)", [1,2,3], false)
end

# ===== Map and Select =====

def test_map_select():
  assert_jq("map(. * 2)", [1,2,3], [2,4,6])
  | assert_jq("map(select(. > 2))", [1,2,3,4], [3,4])
  | assert_jq("[.[] | select(. > 2)]", [1,2,3,4], [3,4])
end

# ===== Type Builtins =====

def test_type_builtins():
  assert_jq("type", 42, "number")
  | assert_jq("type", "hello", "string")
  | assert_jq("type", true, "boolean")
  | assert_jq("type", None, "null")
  | assert_jq("type", [1,2], "array")
  | assert_jq("type", {"a":1}, "object")
end

# ===== Sorting =====

def test_sorting():
  assert_jq("sort", [3,1,2], [1,2,3])
  | assert_jq("sort_by(.age)", [{"age":3},{"age":1},{"age":2}], [{"age":1},{"age":2},{"age":3}])
  | assert_jq("reverse", [1,2,3], [3,2,1])
end

# ===== Unique and Group =====

def test_unique_group():
  assert_jq("unique", [1,2,1,3,2], [1,2,3])
  | assert_jq("unique_by(.x)", [{"x":1,"y":1},{"x":2},{"x":1,"y":2}], [{"x":1,"y":1},{"x":2}])
  | assert_jq("group_by(.x) | length", [{"x":1},{"x":2},{"x":1}], 2)
end

# ===== Min and Max =====

def test_min_max():
  assert_jq("min", [3,1,2], 1)
  | assert_jq("max", [3,1,2], 3)
  | assert_jq("min_by(.age)", [{"age":3},{"age":1}], {"age":1})
  | assert_jq("max_by(.age)", [{"age":3},{"age":1}], {"age":3})
end

# ===== Flatten =====

def test_flatten():
  assert_jq("flatten", [[1,2],[3,[4]]], [1,2,3,4])
  | assert_jq("flatten(1)", [[1,[2]],[3]], [1,[2],3])
end

def test_transpose_walk_del():
  assert_jq("transpose", [[1,2],[3,4]], [[1,3],[2,4]])
  | assert_jq("walk(if type == \"number\" then . + 1 else . end)", {"a": [1, {"b": 2}]}, {"a": [2, {"b": 3}]})
  | assert_jq("del(.a, .nested.x)", {"a": 1, "b": 2, "nested": {"x": 3, "y": 4}}, {"b": 2, "nested": {"y": 4}})
  | assert_jq("setpath([3]; 9)", [], [None, None, None, 9])
end

# ===== Add =====

def test_add():
  assert_jq("add", [1,2,3], 6)
  | assert_jq("add", ["a","b","c"], "abc")
  | assert_jq("add", [[1,2],[3,4]], [1,2,3,4])
end

# ===== Any and All =====

def test_any_all():
  assert_jq("any(.[]; . > 3)", [1,2,3,4], true)
  | assert_jq("any(.[]; . > 10)", [1,2,3,4], false)
  | assert_jq("all(.[]; . > 0)", [1,2,3,4], true)
  | assert_jq("all(.[]; . > 2)", [1,2,3,4], false)
end

# ===== Reduce =====

def test_reduce():
  assert_jq("reduce .[] as $x (0; . + $x)", [1,2,3,4], 10)
  | assert_jq("reduce .[] as $x (\"\"; . + $x)", ["a","b","c"], "abc")
end

# ===== As Binding =====

def test_as_binding():
  assert_jq(". as $x | $x * $x", 5, 25)
  | assert_jq("[.[] as $x | $x * 2]", [1,2,3], [2,4,6])
end

# ===== Entry Operations =====

def test_entry_ops():
  assert_jq("to_entries | length", {"a":1,"b":2}, 2)
  | assert_jq("to_entries[0].key", {"a":1}, "a")
  | assert_jq("from_entries", [{"key":"a","value":1}], {"a":1})
  | assert_jq("with_entries({key: .key, value: (.value + 1)})", {"a":1,"b":2}, {"a":2,"b":3})
end

# ===== Contains =====

def test_contains():
  assert_jq("contains(\"lo\")", "hello", true)
  | assert_jq("contains([2,3])", [1,2,3,4], true)
end

# ===== Index/Rindex =====

def test_index_rindex():
  assert_jq("index(2)", [1,2,3,2], 1)
  | assert_jq("rindex(2)", [1,2,3,2], 3)
  | assert_jq("index(\"l\")", "hello", 2)
end

# ===== Math =====

def test_math():
  assert_jq("floor", 3.7, 3)
  | assert_jq("ceil", 3.2, 4)
  | assert_jq("round", 3.5, 4)
  | assert_jq("sqrt", 9, 3)
  | assert_jq("fabs", -5, 5)
  | assert_jq("isfinite", 42, true)
  | assert_jq("isnormal", 0, false)
  | assert_jq_multi("finites", 42, [42])
end

# ===== User Defined Functions =====

def test_user_functions():
  assert_jq("def double: . * 2; double", 5, 10)
  | assert_jq("def add(x): . + x; add(3)", 5, 8)
  | assert_jq("def sq: . * .; [1,2,3] | map(sq)", None, [1,4,9])
end

# ===== Range =====

def test_range():
  assert_jq_multi("[range(3)]", None, [[0,1,2]])
  | assert_jq_multi("[range(2;5)]", None, [[2,3,4]])
end

# ===== Recurse =====

def test_recurse():
  let result = jq_run(".. | numbers", {"a": 1, "b": {"c": 2}})
  | assert(contains(result, 1))
  | assert(contains(result, 2))
end

# ===== Path Operations =====

def test_paths():
  assert_jq("getpath([\"a\",\"b\"])", {"a":{"b":42}}, 42)
  | assert_jq("setpath([\"a\"]; 99)", {}, {"a":99})
  | assert_jq("delpaths([[\"a\"]])", {"a":1,"b":2}, {"b":2})
end

# ===== String Tests =====

def test_string_builtins():
  assert_jq("test(\"^[0-9]+$\")", "123", true)
  | assert_jq("test(\"^[0-9]+$\")", "abc", false)
  | assert_jq("gsub(\"a\"; \"x\")", "banana", "bxnxnx")
  | assert_jq("tostring", 42, "42")
  | assert_jq("tonumber", "42", 42)
  | assert_jq("explode", "ab", [97, 98])
  | assert_jq("implode", [97, 98], "ab")
end

# ===== First/Last/Limit =====

def test_first_last_limit():
  assert_jq_multi("first(range(3))", None, [0])
  | assert_jq_multi("last(range(3))", None, [2])
  | assert_jq_multi("[limit(2; range(5))]", None, [[0,1]])
end

# ===== Foreach =====

def test_foreach():
  assert_jq("[foreach .[] as $x (0; . + $x)]", [1,2,3,4], [1,3,6,10])
end

# ===== Object Merge =====

def test_object_merge():
  assert_jq(". + {b: 3}", {"a": 1, "b": 2}, {"a": 1, "b": 3})
end

# ===== Null Propagation =====

def test_null_propagation():
  assert_jq(".foo.bar", None, None)
  | assert_jq(".[5]", [1,2,3], None)
end

# ===== Assignment =====

def test_assignment():
  assert_jq(".a = 1", {"b": 2}, {"b": 2, "a": 1})
  | assert_jq(".a |= . + 1", {"a": 1}, {"a": 2})
  | assert_jq(".[] += 1", [1, 2, 3], [2, 3, 4])
  | assert_jq(".a.b.c = 1", None, {"a": {"b": {"c": 1}}})
  | assert_jq(".[-1] = 9", [1, 2, 3], [1, 2, 9])
  | assert_jq(".a //= 5", {"a": None}, {"a": 5})
  | assert_jq(".[] |= empty", [1, 2, 3, 4, 5], [])
  | assert_jq("(.a, .b) = 9", {}, {"a": 9, "b": 9})
  | assert_jq(".[1:3] = [\"x\"]", [1, 2, 3, 4], [1, "x", 4])
  | assert_jq_multi(".a = (1, 2)", {}, [{"a": 1}, {"a": 2}])
end

# ===== Paths =====

def test_path_expressions():
  assert_jq("[paths]", {"a": [1, {"b": 2}]}, [["a"], ["a", 0], ["a", 1], ["a", 1, "b"]])
  | assert_jq("[path(..)]", [[1]], [[], [0], [0, 0]])
  | assert_jq("[path(.a[].b?)]", {"a": [{"b": 1}, {"c": 2}]}, [["a", 0, "b"], ["a", 1, "b"]])
  | assert_jq("del(.[] | select(. > 2))", [1, 2, 3, 4], [1, 2])
  | assert_jq("del(.[1], .[-1], .[0:1])", [0, 1, 2, 3, 4], [2, 3])
  | assert_jq("to_entries", {"a": 1}, [{"key": "a", "value": 1}])
  | assert_jq("pick(.a, .b.c)", {"a": 1, "b": {"c": 2, "d": 3}, "e": 4}, {"a": 1, "b": {"c": 2}})
  | assert_jq("[tostream] | fromstream(.[])", {"a": [1, {"b": 2}]}, {"a": [1, {"b": 2}]})
  | assert_jq("try path(1 | .a) catch .", None, "Invalid path expression near attempt to access element \"a\" of 1")
end

# ===== Destructuring =====

def test_destructuring():
  assert_jq(". as [$a, [$b]] | [$a, $b]", [1, [2]], [1, 2])
  | assert_jq(". as {a: $x, b: [$y, $z]} | [$x, $y, $z]", {"a": 1, "b": [2, 3]}, [1, 2, 3])
  | assert_jq(". as {$a, $b} | $a + $b", {"a": 1, "b": 2}, 3)
  | assert_jq_multi(".[] as [$a] ?// $a | $a", [[1], 2], [1, 2])
  | assert_jq("reduce .[] as [$a, $b] (0; . + $a * $b)", [[1, 2], [3, 4]], 14)
  | assert_jq("1 + 2 as $x | $x * 2", None, 6)
end

# ===== Control flow =====

def test_control_flow():
  assert_jq_multi("[label $out | 1, 2, break $out, 3]", None, [[1, 2]])
  | assert_jq_multi("[limit(3; repeat(1))]", None, [[1, 1, 1]])
  | assert_jq_multi("first(range(1000000000))", None, [0])
  | assert_jq("[first(1, error(\"x\"))]", None, [1])
  | assert_jq("isempty(empty)", None, true)
  | assert_jq_multi("[.[] | (1 / .)?]", [1, 0, 2], [[1, 0.5]])
  | assert_jq_multi("[foreach range(5) as $x (0; . + $x; [$x, .])]", None, [[[0, 0], [1, 1], [2, 3], [3, 6], [4, 10]]])
  | assert_jq("[until(. > 100; . * 2)]", 1, [128])
  | assert_jq("[.[] | if . > 2 then \"big\" elif . > 1 then \"mid\" else \"small\" end]", [1, 2, 3], ["small", "mid", "big"])
end

# ===== Errors =====

def test_errors():
  assert_jq("try error(\"x\") catch .", None, "x")
  | assert_jq("try error({a: 1}) catch .a", None, 1)
  | assert_jq("try error(null) catch .", None, None)
  | assert_jq("try (\"a\" + 1) catch .", None, "string (\"a\") and number (1) cannot be added")
  | assert_jq("try ({} | .[0]) catch .", None, "Cannot index object with number (0)")
  | assert_jq("[.[] | try tonumber catch \"bad\"]", ["1", "a"], [1, "bad"])
  | assert_jq("[try (1, 2, error(\"x\"), 3)]", None, [1, 2])
  | assert_jq("try (null | implode) catch .", None, "implode input must be an array")
  | assert_jq("try ((1, 2) | error) catch .", None, 1)
  | assert_jq("(try error(\"a\") catch .), (try error(\"b\") catch .)", None, "a")
end

# ===== Evaluation order =====

def test_cartesian_order():
  assert_jq_multi("[(1, 2) + (10, 20)]", None, [[11, 12, 21, 22]])
  | assert_jq_multi("{a: (1, 2), b: (3, 4)}", None, [{"a": 1, "b": 3}, {"a": 1, "b": 4}, {"a": 2, "b": 3}, {"a": 2, "b": 4}])
  | assert_jq_multi("[range(0, 1; 3, 4)]", None, [[0, 1, 2, 0, 1, 2, 3, 1, 2, 1, 2, 3]])
  | assert_jq_multi("\"\\(1, 2)-\\(3, 4)\"", None, ["1-3", "2-3", "1-4", "2-4"])
end

# ===== Sorting and comparison =====

def test_ordering():
  assert_jq("sort", [3, "a", None, [1], {"a": 1}, true, false, 1.5], [None, false, true, 1.5, 3, "a", [1], {"a": 1}])
  | assert_jq("sort_by(.a, .b)", [{"a": 1, "b": 2}, {"a": 1, "b": 1}, {"a": 0, "b": 3}], [{"a": 0, "b": 3}, {"a": 1, "b": 1}, {"a": 1, "b": 2}])
  | assert_jq("{a: 1} < {a: 2}, {a: 2} < {b: 1}", None, true)
  | assert_jq("[{\"a\": 2, \"i\": 1}, {\"a\": 1, \"i\": 2}, {\"a\": 2, \"i\": 3}] | max_by(.a).i", None, 3)
  | assert_jq("group_by(.a) | map(length)", [{"a": 1}, {"a": 2}, {"a": 1}], [2, 1])
end

# ===== Numbers and strings =====

def test_number_formatting():
  assert_jq("[1, 1.5, 1e17 + 0, 1e-5 + 0, 0.1 + 0.2, 123456789012345680000 + 0] | tojson", None, "[1,1.5,1e+17,1e-05,0.30000000000000004,123456789012345680000]")
  | assert_jq("[10 / 4, 7 % 3, -7 % 3, 5 % -2]", None, [2.5, 1, -1, 1])
  | assert_jq("[1e1000, -1e1000] | tojson", None, "[1.7976931348623157e+308,-1.7976931348623157e+308]")
  | assert_jq("\"abc\" * 2", None, "abcabc")
  | assert_jq("\"a,b\" / \",\"", None, ["a", "b"])
  | assert_jq("{a: {b: 1}} * {a: {c: 2}}", None, {"a": {"b": 1, "c": 2}})
end

# Exponent notation: mq prints 1e21 and up, and non-zero magnitudes below 1e-6, with an
# exponent, and jq.mq has to turn that into jq's text.
def test_number_formatting_large_and_small_magnitudes():
  assert_jq("[1e300 + 0, -1e300 + 0, 1.5e22 + 0, 1e21 + 0, 1e20 + 0] | tojson", None, "[1e+300,-1e+300,1.5e+22,1e+21,1e+20]")
  | assert_jq("[1e-7 + 0, -2.5e-10 + 0, 1e-6 + 0, 1.5e-5 + 0, 1e-4 + 0] | tojson", None, "[1e-07,-2.5e-10,1e-06,1.5e-05,0.0001]")
  | assert_jq("[5e-324 + 0, 2.2250738585072014e-308 + 0, 1.7976931348623157e308 + 0] | tojson", None, "[5e-324,2.2250738585072014e-308,1.7976931348623157e+308]")
  | assert_jq("[1e17 + 0, 123456789012345678 + 0, 12345678909876543212345 + 0] | tojson", None, "[1e+17,123456789012345680,12345678909876543000000]")
  | assert_jq("[1e300 + 0, 1e-7 + 0] | map(tostring)", None, ["1e+300", "1e-07"])
  | assert_jq("1e-7 + 0 | tojson | fromjson", None, 1e-7)
end

# Inputs of 32 characters or more are matched by mq's native regex engine when the pattern
# allows it, and by the engine in jq.mq otherwise (lookahead below). Expected values come from jq.
def test_regex_long_input():
  let text = "日本語 日本語 日本語 日本語 foo123 bar45 BAZ6 ١٢٣ qux"
  | assert_jq("[match(\"(?<w>[a-z]+)(?<d>[0-9]+)(x)?\"; \"g\")] | map([.offset, .length, .string, (.captures | map([.offset, .length, .string, .name]))])", text, [[16, 6, "foo123", [[16, 3, "foo", "w"], [19, 3, "123", "d"], [-1, 0, None, None]]], [23, 5, "bar45", [[23, 3, "bar", "w"], [26, 2, "45", "d"], [-1, 0, None, None]]]])
  | assert_jq("[match(\"[a-z]+(?=[0-9])\"; \"g\") | [.offset, .string]]", text, [[16, "foo"], [23, "bar"]])
  | assert_jq("[match(\"\\\\d+\"; \"g\") | [.offset, .string]]", text, [[19, "123"], [26, "45"], [32, "6"], [34, "١٢٣"]])
  | assert_jq("[match(\"baz\"; \"gi\") | [.offset, .string]]", text, [[29, "BAZ"]])
  | assert_jq("gsub(\"[0-9]+\"; \"#\")", text, "日本語 日本語 日本語 日本語 foo# bar# BAZ# ١٢٣ qux")
  | assert_jq("[scan(\"(\\\\w)(\\\\d)\")]", text, [["o", "1"], ["2", "3"], ["r", "4"], ["Z", "6"], ["١", "٢"]])
  | assert_jq("[match(\"\\\\bba\\\\w+\"; \"g\") | [.offset, .string]]", text, [[23, "bar45"]])
  | assert_jq("test(\"qux$\")", text, true)
  | assert_jq("test(\"quux$\")", text, false)
  | assert_jq("capture(\"(?<w>[a-z]+)(?<d>[0-9]+)\")", text, {"w": "foo", "d": "123"})
  | assert_jq("[match(\"日本語|foo\"; \"g\") | .offset]", text, [0, 4, 8, 12, 16])
  | assert_jq("[splits(\"\\\\s+\")] | length", text, 9)
end

# jq refuses to work on values nested more than 10000 levels and on paths of more than 10000 keys.
def test_depth_limits():
  assert_jq("reduce range(10000) as $_ ([]; [.]) as $x | $x | contains($x)", None, true)
  | assert_jq("try (reduce range(10001) as $_ ([]; [.]) as $x | $x | contains($x)) catch .", None, "Containment check too deep")
  | assert_jq("try (reduce range(10001) as $_ ({}; {a: .}) as $x | $x * $x) catch .", None, "Object merge too deep")
  | assert_jq("try (reduce range(10001) as $_ ([]; [.]) as $x | [$x, $x] | sort) catch .", None, "Comparison too deep")
  | assert_jq("try (reduce range(10001) as $_ ([]; [.]) as $x | [$x, $x] | unique) catch .", None, "Comparison too deep")
  | assert_jq("try setpath([range(10001) | 0]; 0) catch .", None, "Path too deep")
  | assert_jq("try getpath([range(10001) | 0]) catch .", None, "Path too deep")
  | assert_jq("try delpaths([[range(10001) | 0]]) catch .", None, "Path too deep")
  | assert_jq("reduce range(10000) as $_ ([]; [.]) | tojson | [contains(\"skipped\"), length]", None, [false, 20002])
  | assert_jq("reduce range(10001) as $_ ([]; [.]) | tojson | [contains(\"<skipped: too deep>\"), length]", None, [true, 20021])
end

def test_strindices_errors():
  assert_jq("try _strindices(\"abc\") catch .", 123, "number (123) cannot be searched, as it is not a string")
  | assert_jq("try _strindices(123) catch .", "abc", "number (123) is not a string")
end

# ===== API options =====

def test_api_inputs():
  assert_eq(jq_run_opts("[input, input]", None, {inputs: [1, 2, 3]}), [[1, 2]])
  | assert_eq(jq_run_opts("[inputs]", None, {inputs: [1, None, "a"]}), [[1, None, "a"]])
  | assert_eq(jq_run_opts("input | [., ([inputs] | length)]", None, {inputs: [7, 8, 9]}), [[7, 2]])
  | assert_eq(jq_run_opts("[limit(2; inputs)], input", None, {inputs: [1, 2, 3, 4]}), [[1, 2], 3])
  | assert_eq(jq_run_opts("try input catch .", None, {inputs: []}), ["No more inputs"])
  | assert_eq(jq_run_opts("[inputs]", None, dict()), [[]])
  | assert_eq(jq_run_opts("input_filename", None, {filename: "a.json"}), ["a.json"])
  | assert_eq(jq_run_opts("input_filename", None, dict()), [None])
end

def test_api_named_arguments():
  assert_eq(jq_run_opts("$frame + 1", None, {named: {frame: 6}}), [7])
  | assert_eq(jq_run_opts("[$a, $b]", None, {named: {a: "x", b: [1]}}), [["x", [1]]])
  | assert_eq(jq_run_opts("$ARGS", None, {named: {a: 1}, positional: ["p", "q"]}), [{"positional": ["p", "q"], "named": {"a": 1}}])
  | assert_eq(jq_run_opts("$ARGS", None, dict()), [{"positional": [], "named": {}}])
end

def test_api_results_keep_outputs_before_an_error():
  assert_eq(jq_run_result("1, 2, error(\"boom\"), 3", None, dict()), {"outputs": [1, 2], "error": "boom"})
  | assert_eq(jq_run_result("1, 2", None, dict()), {"outputs": [1, 2], "error": None})
  | assert_eq(jq_run_result("error({a: 1})", None, dict()), {"outputs": [], "error": "jq: error (not a string): {\"a\":1}"})
  | assert_eq(jq_run_result("1, (label $f | break $f), 2", None, dict()), {"outputs": [1, 2], "error": None})
  | assert_eq(jq_run_result("[inputs] | length", None, {inputs: [1, 2]}), {"outputs": [2], "error": None})
end

def test_division_by_tiny_divisors():
  assert_jq("[1 / 1e-17, -1 / 1e-17, 7 / 3e-300, 1 / 3e-16] | tojson", None, "[1e+17,-1e+17,2.3333333333333332e+300,3333333333333333.5]")
  | assert_jq("[1e300 / 1e-300, 1 / 5e-324] | tojson", None, "[1.7976931348623157e+308,1.7976931348623157e+308]")
  | assert_jq("try (1 / 0) catch .", None, "number (1) and number (0) cannot be divided because the divisor is zero")
end

def test_formats():
  assert_jq("@base64", "hello", "aGVsbG8=")
  | assert_jq("@base64 | @base64d", "hello", "hello")
  | assert_jq("@csv", [1, "a\"b", None], "1,\"a\"\"b\",")
  | assert_jq("@tsv", ["a\tb", 1], "a\\tb\t1")
  | assert_jq("@html", "<a&b>", "&lt;a&amp;b&gt;")
  | assert_jq("@uri", "a b&c", "a%20b%26c")
  | assert_jq("@sh", "it's", "'it'\\''s'")
  | assert_jq("@json \"v=\\(.)\"", [1, 2], "v=[1,2]")
  | assert_jq("tojson | fromjson", {"a": [1, 2.5, None]}, {"a": [1, 2.5, None]})
end

# ===== Regular expressions =====

def test_regex():
  assert_jq("test(\"B\"; \"i\")", "abc", true)
  | assert_jq("[match(\"a+\"; \"g\") | .string]", "aabaa", ["aa", "aa"])
  | assert_jq("match(\"(?<x>b)(c)?\") | .captures | map(.name)", "ab", ["x", None])
  | assert_jq("capture(\"(?<y>\\\\d+)-(?<m>\\\\d+)\")", "2024-05", {"y": "2024", "m": "05"})
  | assert_jq("sub(\"(?<x>b)\"; \"[\\(.x)]\")", "abc", "a[b]c")
  | assert_jq("gsub(\"\"; \"-\")", "ab", "-a-b-")
  | assert_jq("[scan(\"(a)(b)\")]", "abab", [["a", "b"], ["a", "b"]])
  | assert_jq("[splits(\", *\")]", "a, b,c", ["a", "b", "c"])
  | assert_jq("[match(\"(?<=b)c\"; \"g\") | .offset]", "abcabc", [2, 5])
  | assert_jq("test(\"^(\\\\w)\\\\1$\")", "aa", true)
  | assert_jq("[match(\"\"; \"g\") | .offset]", "ab", [0, 1, 2])
end

# ===== Dates =====

def test_dates():
  assert_jq("gmtime", 1425599507, [2015, 2, 5, 23, 51, 47, 4, 63])
  | assert_jq("gmtime | mktime", 1425599507, 1425599507)
  | assert_jq("todate", 1425599507, "2015-03-05T23:51:47Z")
  | assert_jq("fromdate", "2015-03-05T23:51:47Z", 1425599507)
  | assert_jq("strftime(\"%A, %B %d, %Y\")", 1435677542, "Tuesday, June 30, 2015")
  | assert_jq("strptime(\"%Y-%m-%d\") | mktime", "2024-02-29", 1709164800)
end

# ===== Functions =====

def test_function_semantics():
  assert_jq("def f(g): [g, g]; f(1, 2)", None, [1, 2, 1, 2])
  | assert_jq("def f($a; $b): $a + $b; f(1; 2)", None, 3)
  | assert_jq("def fac: if . <= 1 then 1 else . * (. - 1 | fac) end; 10 | fac", None, 3628800)
  | assert_jq("def a: 1; def b: a; def a: 2; b", None, 1)
  | assert_jq("def f: def g: 3; g * 2; f", None, 6)
  | assert_jq("[recurse(if . < 20 then . * 2 else empty end)]", 1, [1, 2, 4, 8, 16, 32])
  | assert_jq("walk(if type == \"number\" then . + 1 else . end)", [1, [2, {"a": 3}]], [2, [3, {"a": 4}]])
  | assert_jq("[.[] | select(type == \"number\")] | add", [1, "a", 2], 3)
end

# ===== Large inputs =====

def test_large_inputs():
  assert_jq("[range(50000)] | length", None, 50000)
  | assert_jq("reduce range(50000) as $i (0; . + $i)", None, 1249975000)
  | assert_jq("[range(5000) | tostring] | join(\",\") | length", None, 23889)
end
