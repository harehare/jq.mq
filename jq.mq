# jq.mq — A jq interpreter implemented in mq
#
# Evaluates jq programs against arbitrary input values.
# Programs are lexed, parsed into an AST, compiled into mq closures
# (continuation-passing style, so generators, `limit`, `first`, `label/break`
# and mid-stream errors behave like real jq) and then evaluated.
#
# API:
#   jq_run(program, input)        -> array of outputs
#   jq_run_first(program, input)  -> first output, or None
#   jq_compile(program)           -> compiled program
#   jq_eval(compiled, input)      -> array of outputs

import "json"

# ===== Lexer =====

def _jq_hex_digit(c):
  let cp = first(explode(c))
  | if (cp >= 48 && cp <= 57): cp - 48
    elif (cp >= 65 && cp <= 70): cp - 55
    elif (cp >= 97 && cp <= 102): cp - 87
    else: error("jq: invalid hex digit: " + c)
end

def _jq_hex_to_int(hex):
  fold(to_array(downcase(hex)), 0, fn(acc, c): acc * 16 + _jq_hex_digit(c);)
end

def _jq_is_ident_start(c):
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
end

def _jq_is_ident_char(c):
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_" || (c >= "0" && c <= "9")
end

def _jq_is_digit(c):
  c >= "0" && c <= "9"
end

# Reads an identifier (with optional `::` module separators) starting at pos.
def _jq_read_ident(s, pos, n):
  var j = pos
  | let _ = while (j < n && _jq_is_ident_char(s[j])): j += 1 end
  | let _ = while (j + 2 < n && s[j] == ":" && s[j + 1] == ":" && _jq_is_ident_start(s[j + 2])):
      do
        j += 2
        | let _ = while (j < n && _jq_is_ident_char(s[j])): j += 1 end
        | j
      end
    end
  | slice(s, pos, j)
end

# Reads a number literal starting at pos; returns the matched text.
def _jq_read_number(s, pos, n):
  var j = pos
  | let _ = while (j < n && _jq_is_digit(s[j])): j += 1 end
  | let _ = if (j < n && s[j] == "."): do
      j += 1
      | let _ = while (j < n && _jq_is_digit(s[j])): j += 1 end
      | j
    end
  | let _ = if (j < n && (s[j] == "e" || s[j] == "E")):
      do
        var k = j + 1
        | let _ = if (k < n && (s[k] == "+" || s[k] == "-")): k += 1
        | if (k < n && _jq_is_digit(s[k])): do
            let _ = while (k < n && _jq_is_digit(s[k])): k += 1 end
            | j = k
            | j
          end
      end
  | slice(s, pos, j)
end

def _jq_parse_num(m):
  try: to_number(m)
  catch: if (is_regex_match(m, "[eE]-")): 0 else: infinite()
end

def _jq_codepoint_str(cp):
  if (cp >= 55296 && cp <= 57343): implode([65533])
  elif (cp > 1114111): implode([65533])
  else: implode([cp])
end

# Lexes the body of a string literal starting right after the opening quote.
# Returns {parts, end_pos}; parts are {t: "text", v} or {t: "interp", v: source}.
def _jq_lex_str_body(s, start):
  var i = start
  | var parts = []
  | var cur = ""
  | let n = len(s)
  | var closed = false
  | let _ = while (i < n && !closed):
      let c = s[i]
      | if (c == "\""): do closed = true | i += 1 | closed end
        elif (c == "\\"):
          do
            let nc = if (i + 1 < n): s[i + 1] else: ""
            | if (nc == "("):
                do
                  if (cur != ""): do parts += [{t: "text", v: cur}] | cur = "" | parts end
                  | var depth = 1
                  | var j = i + 2
                  | let _ = while (j < n && depth > 0):
                      let d = s[j]
                      | if (d == "("): do depth += 1 | j += 1 | depth end
                        elif (d == ")"): do depth -= 1 | j += 1 | depth end
                        elif (d == "\""):
                          do
                            j += 1
                            | let _ = while (j < n && s[j] != "\""):
                                if (s[j] == "\\"): j += 2 else: j += 1
                              end
                            | j += 1
                            | depth
                          end
                        else: do j += 1 | depth end
                    end
                  | if (depth > 0): error("jq: syntax error: unterminated string interpolation")
                  | parts += [{t: "interp", v: slice(s, i + 2, j - 1)}]
                  | i = j
                  | parts
                end
              elif (nc == "n"): do cur = cur + "\n" | i += 2 | cur end
              elif (nc == "r"): do cur = cur + "\r" | i += 2 | cur end
              elif (nc == "t"): do cur = cur + "\t" | i += 2 | cur end
              elif (nc == "\\"): do cur = cur + "\\" | i += 2 | cur end
              elif (nc == "\""): do cur = cur + "\"" | i += 2 | cur end
              elif (nc == "/"): do cur = cur + "/" | i += 2 | cur end
              elif (nc == "b"): do cur = cur + implode([8]) | i += 2 | cur end
              elif (nc == "f"): do cur = cur + implode([12]) | i += 2 | cur end
              elif (nc == "u"):
                do
                  if (i + 6 > n): error("jq: syntax error: invalid \\u escape")
                  | let cp = _jq_hex_to_int(slice(s, i + 2, i + 6))
                  | if (cp >= 55296 && cp <= 56319 && i + 12 <= n && s[i + 6] == "\\" && s[i + 7] == "u"):
                      do
                        let lo = _jq_hex_to_int(slice(s, i + 8, i + 12))
                        | if (lo >= 56320 && lo <= 57343):
                            do
                              cur = cur + implode([65536 + ((cp - 55296) * 1024) + (lo - 56320)])
                              | i += 12
                              | cur
                            end
                          else: do cur = cur + implode([65533]) | i += 6 | cur end
                      end
                    else: do cur = cur + _jq_codepoint_str(cp) | i += 6 | cur end
                end
              else: error("jq: syntax error: invalid escape in string literal")
          end
        else: do cur = cur + c | i += 1 | cur end
    end
  | if (!closed): error("jq: syntax error: unterminated string literal")
  | if (cur != ""): parts += [{t: "text", v: cur}]
  | {parts: parts, end_pos: i}
end

def _jq_keywords():
  ["def", "if", "then", "elif", "else", "end", "as", "reduce", "foreach", "try", "catch",
   "label", "import", "include", "and", "or", "__loc__"]
end

def _jq_lex(src):
  let s = to_string(src)
  | var pos = 0
  | var tokens = []
  | let n = len(s)
  | let kws = _jq_keywords()
  | let _ = while (pos < n):
      let c = s[pos]
      | let c2 = if (pos + 1 < n): s[pos + 1] else: ""
      | let c3 = if (pos + 2 < n): s[pos + 2] else: ""
      | if (c == " " || c == "\t" || c == "\n" || c == "\r"): pos += 1
        elif (c == "#"):
          do
            let _ = while (pos < n && s[pos] != "\n"): pos += 1 end
            | pos
          end
        elif (c == "."):
          if (c2 == "."): do tokens += [{t: "dotdot"}] | pos += 2 | pos end
          elif (_jq_is_digit(c2)):
            do
              let m = _jq_read_number(s, pos + 1, n)
              | tokens += [{t: "num", v: to_number("0." + m)}]
              | pos += 1 + len(m)
              | pos
            end
          elif (_jq_is_ident_start(c2)):
            do
              var j = pos + 1
              | let _ = while (j < n && _jq_is_ident_char(s[j])): j += 1 end
              | tokens += [{t: "field", v: slice(s, pos + 1, j)}]
              | pos = j
              | pos
            end
          else: do tokens += [{t: "dot"}] | pos += 1 | pos end
        elif (c == "?" && c2 == "/" && c3 == "/"):
          do tokens += [{t: "altdestr"}] | pos += 3 | pos end
        elif (c == "|" && c2 == "="): do tokens += [{t: "op", v: "|="}] | pos += 2 | pos end
        elif (c == "|"): do tokens += [{t: "pipe"}] | pos += 1 | pos end
        elif (c == ","): do tokens += [{t: "comma"}] | pos += 1 | pos end
        elif (c == ":"): do tokens += [{t: "colon"}] | pos += 1 | pos end
        elif (c == ";"): do tokens += [{t: "semi"}] | pos += 1 | pos end
        elif (c == "("): do tokens += [{t: "lparen"}] | pos += 1 | pos end
        elif (c == ")"): do tokens += [{t: "rparen"}] | pos += 1 | pos end
        elif (c == "["): do tokens += [{t: "lbracket"}] | pos += 1 | pos end
        elif (c == "]"): do tokens += [{t: "rbracket"}] | pos += 1 | pos end
        elif (c == "{"): do tokens += [{t: "lbrace"}] | pos += 1 | pos end
        elif (c == "}"): do tokens += [{t: "rbrace"}] | pos += 1 | pos end
        elif (c == "?"): do tokens += [{t: "question"}] | pos += 1 | pos end
        elif (c == "@"):
          do
            if (!_jq_is_ident_start(c2)): error("jq: syntax error: invalid format string after @")
            | var j = pos + 1
            | let _ = while (j < n && _jq_is_ident_char(s[j])): j += 1 end
            | tokens += [{t: "format", v: slice(s, pos + 1, j)}]
            | pos = j
            | pos
          end
        elif (c == "$"):
          do
            if (!_jq_is_ident_start(c2)): error("jq: syntax error: invalid variable name after $")
            | let name = _jq_read_ident(s, pos + 1, n)
            | tokens += [{t: "var", v: name}]
            | pos += 1 + len(name)
            | pos
          end
        elif (c == "="):
          if (c2 == "="): do tokens += [{t: "op", v: "=="}] | pos += 2 | pos end
          else: do tokens += [{t: "op", v: "="}] | pos += 1 | pos end
        elif (c == "!"):
          if (c2 == "="): do tokens += [{t: "op", v: "!="}] | pos += 2 | pos end
          else: error("jq: syntax error: unexpected '!'")
        elif (c == "<"):
          if (c2 == "="): do tokens += [{t: "op", v: "<="}] | pos += 2 | pos end
          else: do tokens += [{t: "op", v: "<"}] | pos += 1 | pos end
        elif (c == ">"):
          if (c2 == "="): do tokens += [{t: "op", v: ">="}] | pos += 2 | pos end
          else: do tokens += [{t: "op", v: ">"}] | pos += 1 | pos end
        elif (c == "+" || c == "-" || c == "*" || c == "%"):
          if (c2 == "="): do tokens += [{t: "op", v: c + "="}] | pos += 2 | pos end
          else: do tokens += [{t: "op", v: c}] | pos += 1 | pos end
        elif (c == "/"):
          if (c2 == "/" && c3 == "="): do tokens += [{t: "op", v: "//="}] | pos += 3 | pos end
          elif (c2 == "/"): do tokens += [{t: "op", v: "//"}] | pos += 2 | pos end
          elif (c2 == "="): do tokens += [{t: "op", v: "/="}] | pos += 2 | pos end
          else: do tokens += [{t: "op", v: "/"}] | pos += 1 | pos end
        elif (c == "\""):
          do
            let r = _jq_lex_str_body(s, pos + 1)
            | tokens += [{t: "str", parts: r["parts"]}]
            | pos = r["end_pos"]
            | pos
          end
        elif (_jq_is_digit(c)):
          do
            let m = _jq_read_number(s, pos, n)
            | tokens += [{t: "num", v: _jq_parse_num(m)}]
            | pos += len(m)
            | pos
          end
        elif (_jq_is_ident_start(c)):
          do
            let m = _jq_read_ident(s, pos, n)
            | let tok = if (contains(kws, m)): {t: "kw", v: m} else: {t: "ident", v: m}
            | tokens += [tok]
            | pos += len(m)
            | pos
          end
        else: error("jq: syntax error: unexpected character '" + c + "'")
    end
  | tokens
end

# ===== Parser =====
#
# Every parse function returns [node, next_pos].

def _jq_tt(tokens, pos):
  if (pos >= len(tokens)): "eof" else: tokens[pos]["t"]
end

def _jq_tv(tokens, pos):
  if (pos >= len(tokens)): None else: tokens[pos]["v"]
end

def _jq_is_kw(tokens, pos, v):
  _jq_tt(tokens, pos) == "kw" && _jq_tv(tokens, pos) == v
end

def _jq_is_op(tokens, pos, v):
  _jq_tt(tokens, pos) == "op" && _jq_tv(tokens, pos) == v
end

def _jq_describe_tok(tokens, pos):
  let tt = _jq_tt(tokens, pos)
  | if (tt == "eof"): "end of input"
    elif (is_none(_jq_tv(tokens, pos))): tt
    else: to_string(_jq_tv(tokens, pos))
end

def _jq_expect(tokens, pos, tt):
  if (_jq_tt(tokens, pos) != tt):
    error("jq: syntax error: expected '" + tt + "' but got '" + _jq_describe_tok(tokens, pos) + "'")
  else: pos + 1
end

def _jq_expect_kw(tokens, pos, v):
  if (!_jq_is_kw(tokens, pos, v)):
    error("jq: syntax error: expected '" + v + "' but got '" + _jq_describe_tok(tokens, pos) + "'")
  else: pos + 1
end

def _jq_lit(v):
  {type: "literal", value: v}
end

# String token -> AST. Interpolated parts are parsed here, once, at compile time.
def _jq_parse_str_tok(tok, fmt):
  let parts = tok["parts"]
  | if (is_empty(parts)): _jq_lit("")
    elif (len(parts) == 1 && parts[0]["t"] == "text" && is_none(fmt)): _jq_lit(parts[0]["v"])
    else:
      {type: "str", fmt: fmt,
       parts: map(parts, fn(p): if (p["t"] == "text"): p["v"] else: _jq_parse(p["v"]);)}
end

def _jq_parse_call(tokens, pos):
  let name = _jq_tv(tokens, pos)
  | if (_jq_tt(tokens, pos + 1) == "lparen"): do
      var args = []
      | var cur = pos + 2
      | var done = false
      | let _ = while (!done):
          do
            let r = _jq_parse_pipe(tokens, cur)
            | args += [r[0]]
            | cur = r[1]
            | if (_jq_tt(tokens, cur) == "semi"): cur += 1
              else: done = true
          end
        end
      | let end_pos = _jq_expect(tokens, cur, "rparen")
      | [{type: "call", name: name, args: args}, end_pos]
    end
    elif (name == "null"): [_jq_lit(None), pos + 1]
    elif (name == "true"): [_jq_lit(true), pos + 1]
    elif (name == "false"): [_jq_lit(false), pos + 1]
    else: [{type: "call", name: name, args: []}, pos + 1]
end

def _jq_parse_array_ctor(tokens, pos):
  if (_jq_tt(tokens, pos) == "rbracket"):
    [{type: "array", expr: None}, pos + 1]
  else: do
    let r = _jq_parse_pipe(tokens, pos)
    | let end_pos = _jq_expect(tokens, r[1], "rbracket")
    | [{type: "array", expr: r[0]}, end_pos]
  end
end

# Object values: pipe chain without the comma operator.
def _jq_parse_obj_value(tokens, pos):
  let r = _jq_parse_binop(tokens, pos, 2)
  | if (_jq_tt(tokens, r[1]) == "pipe"): do
      let r2 = _jq_parse_obj_value(tokens, r[1] + 1)
      | [{type: "pipe", left: r[0], right: r2[0]}, r2[1]]
    end
    else: r
end

def _jq_parse_object_entry(tokens, pos):
  let tt = _jq_tt(tokens, pos)
  | let tv = _jq_tv(tokens, pos)
  | if (tt == "ident" || tt == "kw"): do
      if (_jq_tt(tokens, pos + 1) == "colon"): do
          let r = _jq_parse_obj_value(tokens, pos + 2)
          | [{key: _jq_lit(tv), val: r[0]}, r[1]]
        end
        else: [{key: _jq_lit(tv), val: {type: "field", base: {type: "identity"}, name: tv}}, pos + 1]
    end
    elif (tt == "num"): do
      let end_pos = _jq_expect(tokens, pos + 1, "colon")
      | let r = _jq_parse_obj_value(tokens, end_pos)
      | [{key: _jq_lit(tv), val: r[0]}, r[1]]
    end
    elif (tt == "var"): do
      if (_jq_tt(tokens, pos + 1) == "colon"): do
        let r = _jq_parse_obj_value(tokens, pos + 2)
        | [{key: {type: "var_ref", name: tv}, val: r[0]}, r[1]]
      end
      elif (tv == "__loc__"):
        [{key: _jq_lit("__loc__"), val: {type: "loc"}}, pos + 1]
      else: [{key: _jq_lit(tv), val: {type: "var_ref", name: tv}}, pos + 1]
    end
    elif (tt == "str" || tt == "format"): do
      let key_r = if (tt == "format"): do
          if (_jq_tt(tokens, pos + 1) != "str"): error("jq: syntax error: format as object key needs a string")
          | [_jq_parse_str_tok(tokens[pos + 1], tv), pos + 2]
        end
        else: [_jq_parse_str_tok(tokens[pos], None), pos + 1]
      | if (_jq_tt(tokens, key_r[1]) == "colon"): do
          let r = _jq_parse_obj_value(tokens, key_r[1] + 1)
          | [{key: key_r[0], val: r[0]}, r[1]]
        end
        else: [{key: key_r[0], val: {type: "index", base: {type: "identity"}, idx: key_r[0]}}, key_r[1]]
    end
    elif (tt == "lparen"): do
      let key_r = _jq_parse_pipe(tokens, pos + 1)
      | let p1 = _jq_expect(tokens, key_r[1], "rparen")
      | let p2 = _jq_expect(tokens, p1, "colon")
      | let r = _jq_parse_obj_value(tokens, p2)
      | [{key: key_r[0], val: r[0]}, r[1]]
    end
    else: error("jq: syntax error: unexpected '" + _jq_describe_tok(tokens, pos) + "' in object construction")
end

def _jq_parse_object_ctor(tokens, pos):
  var entries = []
  | var cur = pos
  | var done = false
  | let _ = if (_jq_tt(tokens, cur) == "rbrace"): done = true
  | let _ = while (!done):
      do
        let r = _jq_parse_object_entry(tokens, cur)
        | entries += [r[0]]
        | cur = r[1]
        | if (_jq_tt(tokens, cur) == "comma"): cur += 1
          else: done = true
      end
    end
  | let end_pos = _jq_expect(tokens, cur, "rbrace")
  | [{type: "object", entries: entries}, end_pos]
end

def _jq_parse_if(tokens, pos):
  let r_cond = _jq_parse_pipe(tokens, pos)
  | let pos2 = _jq_expect_kw(tokens, r_cond[1], "then")
  | let r_then = _jq_parse_pipe(tokens, pos2)
  | let nxt = r_then[1]
  | if (_jq_is_kw(tokens, nxt, "elif")): do
      let r_rest = _jq_parse_if(tokens, nxt + 1)
      | [{type: "if", cond: r_cond[0], then: r_then[0], orelse: r_rest[0]}, r_rest[1]]
    end
    elif (_jq_is_kw(tokens, nxt, "else")): do
      let r_else = _jq_parse_pipe(tokens, nxt + 1)
      | let end_pos = _jq_expect_kw(tokens, r_else[1], "end")
      | [{type: "if", cond: r_cond[0], then: r_then[0], orelse: r_else[0]}, end_pos]
    end
    else: do
      let end_pos = _jq_expect_kw(tokens, nxt, "end")
      | [{type: "if", cond: r_cond[0], then: r_then[0], orelse: None}, end_pos]
    end
end

# ----- Patterns (destructuring) -----

def _jq_parse_pattern(tokens, pos):
  let tt = _jq_tt(tokens, pos)
  | if (tt == "var"): [{kind: "var", name: _jq_tv(tokens, pos)}, pos + 1]
    elif (tt == "lbracket"): do
      var items = []
      | var cur = pos + 1
      | var done = false
      | let _ = while (!done):
          do
            let r = _jq_parse_pattern(tokens, cur)
            | items += [r[0]]
            | cur = r[1]
            | if (_jq_tt(tokens, cur) == "comma"): cur += 1
              else: done = true
          end
        end
      | [{kind: "arr", items: items}, _jq_expect(tokens, cur, "rbracket")]
    end
    elif (tt == "lbrace"): do
      var entries = []
      | var cur = pos + 1
      | var done = false
      | let _ = while (!done):
          do
            let t2 = _jq_tt(tokens, cur)
            | let v2 = _jq_tv(tokens, cur)
            | let entry_r = if (t2 == "var"): do
                if (_jq_tt(tokens, cur + 1) == "colon"): do
                    let pr = _jq_parse_pattern(tokens, cur + 2)
                    | [{key: _jq_lit(v2), bind: v2, pat: pr[0]}, pr[1]]
                  end
                  else: [{key: _jq_lit(v2), bind: v2, pat: None}, cur + 1]
              end
              elif (t2 == "ident" || t2 == "kw"): do
                let pr = _jq_parse_pattern(tokens, _jq_expect(tokens, cur + 1, "colon"))
                | [{key: _jq_lit(v2), bind: None, pat: pr[0]}, pr[1]]
              end
              elif (t2 == "str"): do
                let key = _jq_parse_str_tok(tokens[cur], None)
                | let pr = _jq_parse_pattern(tokens, _jq_expect(tokens, cur + 1, "colon"))
                | [{key: key, bind: None, pat: pr[0]}, pr[1]]
              end
              elif (t2 == "lparen"): do
                let kr = _jq_parse_pipe(tokens, cur + 1)
                | let p1 = _jq_expect(tokens, kr[1], "rparen")
                | let pr = _jq_parse_pattern(tokens, _jq_expect(tokens, p1, "colon"))
                | [{key: kr[0], bind: None, pat: pr[0]}, pr[1]]
              end
              else: error("jq: syntax error: invalid object pattern")
            | entries += [entry_r[0]]
            | cur = entry_r[1]
            | if (_jq_tt(tokens, cur) == "comma"): cur += 1
              else: done = true
          end
        end
      | [{kind: "obj", entries: entries}, _jq_expect(tokens, cur, "rbrace")]
    end
    else: error("jq: syntax error: invalid pattern, got '" + _jq_describe_tok(tokens, pos) + "'")
end

# Patterns := Pattern ('?//' Pattern)*
def _jq_parse_patterns(tokens, pos):
  let r = _jq_parse_pattern(tokens, pos)
  | var pats = [r[0]]
  | var cur = r[1]
  | let _ = while (_jq_tt(tokens, cur) == "altdestr"):
      do
        let r2 = _jq_parse_pattern(tokens, cur + 1)
        | pats += [r2[0]]
        | cur = r2[1]
        | pats
      end
    end
  | [pats, cur]
end

# ----- reduce / foreach / label / try -----

def _jq_parse_reduce(tokens, pos):
  let r_src = _jq_parse_binop(tokens, pos, 2)
  | let p1 = _jq_expect_kw(tokens, r_src[1], "as")
  | let r_pat = _jq_parse_patterns(tokens, p1)
  | let p2 = _jq_expect(tokens, r_pat[1], "lparen")
  | let r_init = _jq_parse_pipe(tokens, p2)
  | let p3 = _jq_expect(tokens, r_init[1], "semi")
  | let r_upd = _jq_parse_pipe(tokens, p3)
  | let end_pos = _jq_expect(tokens, r_upd[1], "rparen")
  | [{type: "reduce", src: r_src[0], pats: r_pat[0], init: r_init[0], update: r_upd[0]}, end_pos]
end

def _jq_parse_foreach(tokens, pos):
  let r_src = _jq_parse_binop(tokens, pos, 2)
  | let p1 = _jq_expect_kw(tokens, r_src[1], "as")
  | let r_pat = _jq_parse_patterns(tokens, p1)
  | let p2 = _jq_expect(tokens, r_pat[1], "lparen")
  | let r_init = _jq_parse_pipe(tokens, p2)
  | let p3 = _jq_expect(tokens, r_init[1], "semi")
  | let r_upd = _jq_parse_pipe(tokens, p3)
  | if (_jq_tt(tokens, r_upd[1]) == "semi"): do
      let r_ext = _jq_parse_pipe(tokens, r_upd[1] + 1)
      | let end_pos = _jq_expect(tokens, r_ext[1], "rparen")
      | [{type: "foreach", src: r_src[0], pats: r_pat[0], init: r_init[0],
          update: r_upd[0], extract: r_ext[0]}, end_pos]
    end
    else: do
      let end_pos = _jq_expect(tokens, r_upd[1], "rparen")
      | [{type: "foreach", src: r_src[0], pats: r_pat[0], init: r_init[0],
          update: r_upd[0], extract: None}, end_pos]
    end
end

def _jq_parse_label(tokens, pos):
  if (_jq_tt(tokens, pos) != "var"): error("jq: syntax error: expected $name after 'label'")
  | let lname = _jq_tv(tokens, pos)
  | let p1 = _jq_expect(tokens, pos + 1, "pipe")
  | let r = _jq_parse_pipe(tokens, p1)
  | [{type: "label", name: lname, body: r[0]}, r[1]]
end

def _jq_parse_try(tokens, pos):
  let r = _jq_parse_unary(tokens, pos)
  | if (_jq_is_kw(tokens, r[1], "catch")): do
      let r2 = _jq_parse_unary(tokens, r[1] + 1)
      | [{type: "try", body: r[0], handler: r2[0]}, r2[1]]
    end
    else: [{type: "try", body: r[0], handler: None}, r[1]]
end

# ----- Primary terms -----

def _jq_parse_primary(tokens, pos):
  let tt = _jq_tt(tokens, pos)
  | let tv = _jq_tv(tokens, pos)
  | if (tt == "num"): [_jq_lit(tv), pos + 1]
    elif (tt == "str"): [_jq_parse_str_tok(tokens[pos], None), pos + 1]
    elif (tt == "format"): do
      if (_jq_tt(tokens, pos + 1) == "str"):
        [_jq_parse_str_tok(tokens[pos + 1], tv), pos + 2]
      else: [{type: "format", name: tv}, pos + 1]
    end
    elif (tt == "field"): [{type: "field", base: {type: "identity"}, name: tv}, pos + 1]
    elif (tt == "dot"): do
      if (_jq_tt(tokens, pos + 1) == "str"):
        [{type: "index", base: {type: "identity"}, idx: _jq_parse_str_tok(tokens[pos + 1], None)}, pos + 2]
      else: [{type: "identity"}, pos + 1]
    end
    elif (tt == "dotdot"): [{type: "recurse_all"}, pos + 1]
    elif (tt == "var"): do
      if (tv == "__loc__"): [{type: "loc"}, pos + 1]
      else: [{type: "var_ref", name: tv}, pos + 1]
    end
    elif (tt == "lparen"): do
      let r = _jq_parse_pipe(tokens, pos + 1)
      | [r[0], _jq_expect(tokens, r[1], "rparen")]
    end
    elif (tt == "lbracket"): _jq_parse_array_ctor(tokens, pos + 1)
    elif (tt == "lbrace"): _jq_parse_object_ctor(tokens, pos + 1)
    elif (tt == "kw" && tv == "if"): _jq_parse_if(tokens, pos + 1)
    elif (tt == "kw" && tv == "try"): _jq_parse_try(tokens, pos + 1)
    elif (tt == "kw" && tv == "reduce"): _jq_parse_reduce(tokens, pos + 1)
    elif (tt == "kw" && tv == "foreach"): _jq_parse_foreach(tokens, pos + 1)
    elif (tt == "kw" && tv == "label"): _jq_parse_label(tokens, pos + 1)
    elif (tt == "kw" && tv == "def"): _jq_parse_def(tokens, pos + 1)
    elif (tt == "ident" && tv == "break" && _jq_tt(tokens, pos + 1) == "var"):
      [{type: "break", name: _jq_tv(tokens, pos + 1)}, pos + 2]
    elif (tt == "ident"): _jq_parse_call(tokens, pos)
    else: error("jq: syntax error: unexpected '" + _jq_describe_tok(tokens, pos) + "'")
end

# Handles what follows `[` in a postfix position.
def _jq_parse_bracket(tokens, pos, base):
  # pos points just after '['
  if (_jq_tt(tokens, pos) == "rbracket"):
    [{type: "iter", base: base}, pos + 1]
  elif (_jq_tt(tokens, pos) == "colon"): do
    let r_to = _jq_parse_pipe(tokens, pos + 1)
    | [{type: "slice", base: base, from: None, to: r_to[0]}, _jq_expect(tokens, r_to[1], "rbracket")]
  end
  else: do
    let r_idx = _jq_parse_pipe(tokens, pos)
    | if (_jq_tt(tokens, r_idx[1]) == "colon"): do
        let p3 = r_idx[1] + 1
        | if (_jq_tt(tokens, p3) == "rbracket"):
            [{type: "slice", base: base, from: r_idx[0], to: None}, p3 + 1]
          else: do
            let r_to = _jq_parse_pipe(tokens, p3)
            | [{type: "slice", base: base, from: r_idx[0], to: r_to[0]}, _jq_expect(tokens, r_to[1], "rbracket")]
          end
      end
      else: [{type: "index", base: base, idx: r_idx[0]}, _jq_expect(tokens, r_idx[1], "rbracket")]
  end
end

# `T?` : for an access like `B.foo?` only the access itself is guarded (errors
# raised while evaluating B still propagate); for any other term the whole term is.
def _jq_make_opt(node):
  let ty = node["type"]
  | if ((ty == "field" || ty == "index" || ty == "iter" || ty == "slice") && node["base"]["type"] != "identity"):
      {type: "pipe", left: node["base"],
       right: {type: "try", body: set(node, "base", {type: "identity"}), handler: None}}
    else: {type: "try", body: node, handler: None}
end

# Postfix chain: .foo, ."foo", .[..], [..], ?, and `as` bindings.
def _jq_parse_postfix(tokens, pos, allow_as):
  let r = _jq_parse_primary(tokens, pos)
  | var node = r[0]
  | var cur = r[1]
  | var done = false
  | let _ = while (!done):
      let tt = _jq_tt(tokens, cur)
      | if (tt == "field"): do
          node = {type: "field", base: node, name: _jq_tv(tokens, cur)}
          | cur += 1
          | node
        end
        elif (tt == "dot" && _jq_tt(tokens, cur + 1) == "lbracket"): do
          let br = _jq_parse_bracket(tokens, cur + 2, node)
          | node = br[0]
          | cur = br[1]
          | node
        end
        elif (tt == "dot" && _jq_tt(tokens, cur + 1) == "str"): do
          node = {type: "index", base: node, idx: _jq_parse_str_tok(tokens[cur + 1], None)}
          | cur += 2
          | node
        end
        elif (tt == "lbracket"): do
          let br = _jq_parse_bracket(tokens, cur + 1, node)
          | node = br[0]
          | cur = br[1]
          | node
        end
        elif (tt == "question"): do
          node = _jq_make_opt(node)
          | cur += 1
          | node
        end
        else: done = true
    end
  | [node, cur]
end

def _jq_parse_unary(tokens, pos):
  if (_jq_is_op(tokens, pos, "-")): do
    let r = _jq_parse_unary(tokens, pos + 1)
    | [{type: "neg", inner: r[0]}, r[1]]
  end
  else: _jq_parse_postfix(tokens, pos, false)
end

# ----- Binary operators -----
# prec: ',' 1 | '//' 2 (right) | assignment 3 (nonassoc) | or 4 | and 5
#       | comparison 6 (nonassoc) | + - 7 | * / % 8

def _jq_binop_prec(tokens, pos):
  let tt = _jq_tt(tokens, pos)
  | let tv = _jq_tv(tokens, pos)
  | if (tt == "op"): do
      if (tv == "//"): 2
      elif (tv == "=" || tv == "|=" || tv == "+=" || tv == "-=" || tv == "*=" || tv == "/=" || tv == "%=" || tv == "//="): 3
      elif (tv == "==" || tv == "!=" || tv == "<" || tv == "<=" || tv == ">" || tv == ">="): 6
      elif (tv == "+" || tv == "-"): 7
      elif (tv == "*" || tv == "/" || tv == "%"): 8
      else: -1
    end
    elif (tt == "kw" && tv == "or"): 4
    elif (tt == "kw" && tv == "and"): 5
    else: -1
end

def _jq_make_binop(tokens, pos, left, right):
  let tt = _jq_tt(tokens, pos)
  | let tv = _jq_tv(tokens, pos)
  | if (tt == "kw" && tv == "or"): {type: "or", left: left, right: right}
    elif (tt == "kw" && tv == "and"): {type: "and", left: left, right: right}
    elif (tv == "//"): {type: "alt", left: left, right: right}
    elif (_jq_binop_prec(tokens, pos) == 3): {type: "assign", op: tv, left: left, right: right}
    else: {type: "binop", op: tv, left: left, right: right}
end

def _jq_parse_binop(tokens, pos, min_prec):
  let r = _jq_parse_unary(tokens, pos)
  | var left = r[0]
  | var cur = r[1]
  | var done = false
  | let _ = while (!done):
      let prec = _jq_binop_prec(tokens, cur)
      | if (prec >= min_prec && prec > 0): do
          let next_min = if (prec == 2): prec else: prec + 1
          | let rr = _jq_parse_binop(tokens, cur + 1, next_min)
          | left = _jq_make_binop(tokens, cur, left, rr[0])
          | cur = rr[1]
          | left
        end
        else: done = true
    end
  | [left, cur]
end

# An operand of the comma operator: a binary-operator expression, optionally
# followed by `as PATTERNS | body` (which binds everything to its left, up to a comma).
def _jq_parse_noc(tokens, pos):
  let r = _jq_parse_binop(tokens, pos, 2)
  | if (_jq_is_kw(tokens, r[1], "as")): do
      let r_pat = _jq_parse_patterns(tokens, r[1] + 1)
      | let p1 = _jq_expect(tokens, r_pat[1], "pipe")
      | let r_body = _jq_parse_pipe(tokens, p1)
      | [{type: "bind", src: r[0], pats: r_pat[0], body: r_body[0]}, r_body[1]]
    end
    else: r
end

def _jq_parse_comma(tokens, pos):
  let r = _jq_parse_noc(tokens, pos)
  | var left = r[0]
  | var cur = r[1]
  | let _ = while (_jq_tt(tokens, cur) == "comma"):
      do
        let rr = _jq_parse_noc(tokens, cur + 1)
        | left = {type: "comma", left: left, right: rr[0]}
        | cur = rr[1]
        | left
      end
    end
  | [left, cur]
end

def _jq_parse_pipe(tokens, pos):
  if (_jq_is_kw(tokens, pos, "def")): _jq_parse_def(tokens, pos + 1)
  else: do
    let r = _jq_parse_comma(tokens, pos)
    | if (_jq_tt(tokens, r[1]) == "pipe"): do
        let r2 = _jq_parse_pipe(tokens, r[1] + 1)
        | [{type: "pipe", left: r[0], right: r2[0]}, r2[1]]
      end
      else: r
  end
end

def _jq_parse_def(tokens, pos):
  if (_jq_tt(tokens, pos) != "ident"): error("jq: syntax error: expected function name after 'def'")
  | let fname = _jq_tv(tokens, pos)
  | var params = []
  | var cur = pos + 1
  | let _ = if (_jq_tt(tokens, cur) == "lparen"): do
      cur += 1
      | var done = false
      | let _ = while (!done):
          do
            if (_jq_tt(tokens, cur) == "ident"): params += [_jq_tv(tokens, cur)]
              elif (_jq_tt(tokens, cur) == "var"): params += ["$" + _jq_tv(tokens, cur)]
              else: error("jq: syntax error: invalid function parameter")
            | cur += 1
            | if (_jq_tt(tokens, cur) == "semi"): cur += 1
              else: done = true
          end
        end
      | cur = _jq_expect(tokens, cur, "rparen")
      | cur
    end
  | let p1 = _jq_expect(tokens, cur, "colon")
  | let r_body = _jq_parse_pipe(tokens, p1)
  | let p2 = _jq_expect(tokens, r_body[1], "semi")
  | let r_next = if (_jq_tt(tokens, p2) == "eof" || _jq_tt(tokens, p2) == "rparen"):
      [{type: "identity"}, p2]
    else: _jq_parse_pipe(tokens, p2)
  | [{type: "def", name: fname, params: params, body: r_body[0], next: r_next[0]}, r_next[1]]
end

def _jq_parse(src):
  let tokens = _jq_lex(src)
  | if (is_empty(tokens)): {type: "identity"}
    else: do
      let r = _jq_parse_pipe(tokens, 0)
      | if (_jq_tt(tokens, r[1]) != "eof"):
          error("jq: syntax error: unexpected '" + _jq_describe_tok(tokens, r[1]) + "'")
        else: r[0]
    end
end

def jq_ast(program):
  _jq_parse(program)
end

# ===== Values =====

def _jq_tn(v):
  let t = type(v)
  | if (t == "dict"): "object"
    elif (t == "bool"): "boolean"
    elif (t == "None"): "null"
    else: t
end

def _jq_truthy(v):
  !is_none(v) && v != false
end

# null < false < true < numbers < strings < arrays < objects
def _jq_rank(v):
  let t = type(v)
  | if (t == "None"): 0
    elif (t == "bool"): if (v): 2 else: 1
    elif (t == "number"): 3
    elif (t == "string"): 4
    elif (t == "array"): 5
    else: 6
end

# ----- JSON serialization -----

def _jq_pad_hex(c):
  let digits = "0123456789abcdef"
  | let d3 = floor(c / 4096)
  | let d2 = floor((c - d3 * 4096) / 256)
  | let d1 = floor((c - d3 * 4096 - d2 * 256) / 16)
  | let d0 = c - d3 * 4096 - d2 * 256 - d1 * 16
  | "\\u" + digits[d3] + digits[d2] + digits[d1] + digits[d0]
end

def _jq_json_str(s):
  if (!is_regex_match(s, "[\"\\\\\\x00-\\x1f\\x7f]")): "\"" + s + "\""
  else: do
    var out = "\""
    | let _ = foreach (c, explode(s)):
        if (c == 34): out += "\\\""
        elif (c == 92): out += "\\\\"
        elif (c == 10): out += "\\n"
        elif (c == 13): out += "\\r"
        elif (c == 9): out += "\\t"
        elif (c == 8): out += "\\b"
        elif (c == 12): out += "\\f"
        elif (c < 32 || c == 127): out += _jq_pad_hex(c)
        else: out += implode([c])
      end
    | out + "\""
  end
end

# Formats the text mq prints for a number the way jq does. mq prints plain decimals, and
# exponent notation (1.5e22, 1e-7) for magnitudes of 1e21 and up or below 1e-6.
def _jq_numstr_slow(s):
  let neg = starts_with(s, "-")
  | let unsigned = if (neg): slice(s, 1, len(s)) else: s
  | let epos = index(unsigned, "e")
  | let body = if (epos >= 0): slice(unsigned, 0, epos) else: unsigned
  | let exp = if (epos >= 0): to_number(slice(unsigned, epos + 1, len(unsigned))) else: 0
  | let dot = index(body, ".")
  | let ip = if (dot >= 0): slice(body, 0, dot) else: body
  | let fp = if (dot >= 0): slice(body, dot + 1, len(body)) else: ""
  | let all = ip + fp
  | var lead = 0
  | let _ = while (lead < len(all) && all[lead] == "0"): lead += 1 end
  | var stop = len(all)
  | let _ = while (stop > lead && all[stop - 1] == "0"): stop -= 1 end
  | let digits = slice(all, lead, stop)
  | let nd = len(digits)
  | let decpt = len(ip) - lead + exp
  | let sign = if (neg): "-" else: ""
  | if (nd == 0): "0"
    elif (decpt <= -4 || decpt > nd + 15): do
      let e = decpt - 1
      | let ea = if (e < 0): 0 - e else: e
      | let es = (if (e < 0): "-" else: "+") + (if (ea < 10): "0" else: "") + to_string(ea)
      | let mant = if (nd == 1): digits else: slice(digits, 0, 1) + "." + slice(digits, 1, nd)
      | sign + mant + "e" + es
    end
    elif (decpt <= 0): sign + "0." + fold(range(0 - decpt - 1), "", fn(a, _): a + "0";) + digits
    elif (decpt >= nd): sign + digits + fold(range(decpt - nd - 1), "", fn(a, _): a + "0";)
    else: sign + slice(digits, 0, decpt) + "." + slice(digits, decpt, nd)
end

def _jq_numstr(n):
  if (n != n): "null"
  elif (n == infinite()): "1.7976931348623157e+308"
  elif (n == -infinite()): "-1.7976931348623157e+308"
  else: do
    let s = to_string(n)
    | if (is_regex_match(s, "^-?[0-9]{1,16}$")): s
      else: _jq_numstr_slow(s)
  end
end

def _jq_tojson(v):
  let t = type(v)
  | if (t == "string"): _jq_json_str(v)
    elif (t == "number"): _jq_numstr(v)
    elif (t == "None"): "null"
    elif (t == "bool"): if (v): "true" else: "false"
    elif (t == "array"): "[" + join(map(v, fn(x): _jq_tojson(x);), ",") + "]"
    elif (t == "dict"): do
      var parts = []
      | let _ = foreach (k, keys(v)): parts += [_jq_json_str(k) + ":" + _jq_tojson(v[k])] end
      | "{" + join(parts, ",") + "}"
    end
    else: to_string(v)
end

def _jq_tostring(v):
  if (is_string(v)): v else: _jq_tojson(v)
end

def _jq_utf8_len(s):
  fold(explode(s), 0, fn(a, c): a + (if (c < 128): 1 elif (c < 2048): 2 elif (c < 65536): 3 else: 4);)
end

# jq-style truncated value dump used in error messages: type (value)
def _jq_trunc_dump(s):
  if (_jq_utf8_len(s) <= 28): s
  else: do
    var bytes = 0
    | var out = ""
    | var stop = false
    | let cps = explode(s)
    | let _ = foreach (c, cps):
        if (!stop):
          do
            let w = if (c < 128): 1 elif (c < 2048): 2 elif (c < 65536): 3 else: 4
            | if (bytes + w > 25): stop = true
              else: do bytes += w | out += implode([c]) end
          end
      end
    | out + "..." + implode([cps[len(cps) - 1]])
  end
end

def _jq_dump(v):
  _jq_tn(v) + " (" + _jq_trunc_dump(_jq_tojson(v)) + ")"
end

# ----- Errors -----
# A jq error is an mq error carrying the jq value: `error(v)` raises it and `e["value"]`
# reads it back. Break signals are strings starting with \u0002; an error raised downstream
# of a `try` is wrapped in a dict keyed \u0003 while it passes through the `try`.

def _jq_is_break(v):
  is_string(v) && starts_with(v, "\u0002")
end

def _jq_is_passing(v):
  is_dict(v) && has(v, "\u0003")
end

# Runs `run(k2)`, forwarding outputs to `k`. Errors raised by `k` (downstream) are
# not seen by `handler`; errors raised by `run` itself are passed to handler(value).
def _jq_try_run(run, k, handler):
  try:
    run(fn(x): try: k(x) catch(e): error({"\u0003": e["value"]});)
  catch(e):
    do
      let v = e["value"]
      | if (_jq_is_passing(v)): error(v["\u0003"])
        else: handler(v)
    end
end

# ----- Comparison and sorting -----

def _jq_cmp(a, b):
  let ra = _jq_rank(a)
  | let rb = _jq_rank(b)
  | if (ra != rb): if (ra < rb): -1 else: 1
    elif (ra == 3): if (a != a): -1 elif (b != b): 1 elif (a < b): -1 elif (a == b): 0 else: 1
    elif (ra == 4): if (a < b): -1 elif (a == b): 0 else: 1
    elif (ra == 5): do
      let la = len(a)
      | let lb = len(b)
      | let m = if (la < lb): la else: lb
      | var i = 0
      | var res = 0
      | let _ = while (res == 0 && i < m):
          do res = _jq_cmp(a[i], b[i]) | i += 1 | res end
        end
      | if (res != 0): res
        elif (la < lb): -1
        elif (la > lb): 1
        else: 0
    end
    elif (ra == 6): do
      let ka = sort(keys(a))
      | let kb = sort(keys(b))
      | let kc = _jq_cmp(ka, kb)
      | if (kc != 0): kc
        else: do
          var i = 0
          | var res = 0
          | let n = len(ka)
          | let _ = while (res == 0 && i < n):
              do res = _jq_cmp(a[ka[i]], b[ka[i]]) | i += 1 | res end
            end
          | res
        end
    end
    else: 0
end

def _jq_merge_sorted(l, r):
  var out = []
  | var i = 0
  | var j = 0
  | let nl = len(l)
  | let nr = len(r)
  | let _ = while (i < nl && j < nr):
      if (_jq_cmp(r[j], l[i]) < 0): do out += [r[j]] | j += 1 | out end
      else: do out += [l[i]] | i += 1 | out end
    end
  | let _ = while (i < nl): do out += [l[i]] | i += 1 | out end end
  | let _ = while (j < nr): do out += [r[j]] | j += 1 | out end end
  | out
end

def _jq_msort(arr):
  let n = len(arr)
  | if (n < 2): arr
    else: do
      let mid = floor(n / 2)
      | _jq_merge_sorted(_jq_msort(slice(arr, 0, mid)), _jq_msort(slice(arr, mid, n)))
    end
end

def _jq_all_numbers(arr):
  fold(arr, true, fn(a, x): a && is_number(x) && x == x;)
end

def _jq_all_strings(arr):
  fold(arr, true, fn(a, x): a && is_string(x);)
end

def _jq_sort(arr):
  if (len(arr) < 2): arr
  elif (_jq_all_numbers(arr) || _jq_all_strings(arr)): sort(arr)
  else: _jq_msort(arr)
end

# pairs: array of [key, value]; sorts stably by key using jq ordering.
# Keys may be single-element arrays (as produced by sort_by); those take a fast path.
def _jq_sort_pairs(pairs):
  let n = len(pairs)
  | if (n < 2): pairs
    else: do
      let ks = map(pairs, fn(p): p[0];)
      | let wrapped = fold(ks, true, fn(a, x): a && is_array(x) && len(x) == 1;)
      | let flat = if (wrapped): map(ks, fn(x): x[0];) else: ks
      | let all_num = fold(flat, true, fn(a, x): a && is_number(x) && x == x;)
      | let all_str = fold(flat, true, fn(a, x): a && is_string(x);)
      | if (all_num || all_str): do
          var idx = []
          | let _ = foreach (i, range(n - 1)): idx += [[flat[i], i]] end
          | map(sort(idx), fn(e): pairs[e[1]];)
        end
        else: do
          let tagged = map(range(n - 1), fn(i): [pairs[i][0], i, pairs[i][1]];)
          | map(_jq_msort_pairs(tagged), fn(t): [t[0], t[2]];)
        end
    end
end

def _jq_merge_pairs(l, r):
  var out = []
  | var i = 0
  | var j = 0
  | let nl = len(l)
  | let nr = len(r)
  | let _ = while (i < nl && j < nr):
      if (_jq_cmp(r[j][0], l[i][0]) < 0): do out += [r[j]] | j += 1 | out end
      else: do out += [l[i]] | i += 1 | out end
    end
  | let _ = while (i < nl): do out += [l[i]] | i += 1 | out end end
  | let _ = while (j < nr): do out += [r[j]] | j += 1 | out end end
  | out
end

def _jq_msort_pairs(arr):
  let n = len(arr)
  | if (n < 2): arr
    else: do
      let mid = floor(n / 2)
      | let merged = _jq_merge_pairs(_jq_msort_pairs(slice(arr, 0, mid)), _jq_msort_pairs(slice(arr, mid, n)))
      | merged
    end
end

# ----- Arithmetic -----

def _jq_binop_err(a, b, verb):
  error(_jq_dump(a) + " and " + _jq_dump(b) + " cannot be " + verb)
end

def _jq_add(a, b):
  let ta = type(a)
  | let tb = type(b)
  | if (ta == "number" && tb == "number"): a + b
    elif (ta == "None"): b
    elif (tb == "None"): a
    elif (ta == "string" && tb == "string"): a + b
    elif (ta == "array" && tb == "array"): a + b
    elif (ta == "dict" && tb == "dict"): do
      var acc = a
      | let _ = foreach (k, keys(b)): acc = set(acc, k, b[k]) end
      | acc
    end
    else: _jq_binop_err(a, b, "added")
end

def _jq_sub(a, b):
  let ta = type(a)
  | let tb = type(b)
  | if (ta == "number" && tb == "number"): a - b
    elif (ta == "array" && tb == "array"):
      fold(a, [], fn(acc, x): if (fold(b, false, fn(f, y): f || x == y;)): acc else: acc + [x];)
    else: _jq_binop_err(a, b, "subtracted")
end

def _jq_deep_merge(a, b):
  var acc = a
  | let _ = foreach (k, keys(b)):
      if (is_dict(acc[k]) && is_dict(b[k]) && contains(keys(acc), k)): acc = set(acc, k, _jq_deep_merge(acc[k], b[k]))
      else: acc = set(acc, k, b[k])
    end
  | acc
end

def _jq_repeat_str(s, n):
  if (n != n || n < 0): None
  elif (len(s) * n > 536870911): error("Repeat string result too long")
  elif (s == ""): ""
  else: do
    var times = floor(n)
    | var out = ""
    | var chunk = s
    | let _ = while (times > 0):
        do
          if (times % 2 == 1): out += chunk
          | times = floor(times / 2)
          | if (times > 0): chunk = chunk + chunk
        end
      end
    | out
  end
end

def _jq_mul(a, b):
  let ta = type(a)
  | let tb = type(b)
  | if (ta == "number" && tb == "number"): a * b
    elif (ta == "string" && tb == "number"): _jq_repeat_str(a, b)
    elif (ta == "number" && tb == "string"): _jq_repeat_str(b, a)
    elif (ta == "dict" && tb == "dict"): _jq_deep_merge(a, b)
    else: _jq_binop_err(a, b, "multiplied")
end

def _jq_div(a, b):
  let ta = type(a)
  | let tb = type(b)
  | if (ta == "number" && tb == "number"):
      if (b == 0): error(_jq_dump(a) + " and " + _jq_dump(b) + " cannot be divided because the divisor is zero")
      else: a / b
    elif (ta == "string" && tb == "string"): _jq_split_str(a, b)
    else: _jq_binop_err(a, b, "divided")
end

def _jq_trunc(x):
  if (x < 0): ceil(x) else: floor(x)
end

def _jq_mod_int(x):
  if (x >= 9223372036854775807): 9223372036854775807
  elif (x <= -9223372036854775808): -9223372036854775808
  else: _jq_trunc(x)
end

def _jq_mod(a, b):
  let ta = type(a)
  | let tb = type(b)
  | if (ta == "number" && tb == "number"): do
      if (a != a || b != b): nan()
      else: do
        let ai = _jq_mod_int(a)
        | let bi = _jq_mod_int(b)
        | if (bi == 0): error(_jq_dump(a) + " and " + _jq_dump(b) + " cannot be divided (remainder) because the divisor is zero")
          elif (ai <= -9223372036854775808 && bi >= 9223372036854775807): -1
          else: ai % bi
      end
    end
    else: _jq_binop_err(a, b, "divided")
end

def _jq_split_str(s, sep):
  if (s == ""): []
  elif (sep == ""): map(explode(s), fn(c): implode([c]);)
  else: split(s, sep)
end

# ----- Indexing, slicing, iteration -----

def _jq_field(v, name):
  let t = type(v)
  | if (t == "dict"): v[name]
    elif (t == "None"): None
    else: error("Cannot index " + _jq_tn(v) + " with " + _jq_dump(name))
end

def _jq_subarray_indices(a, b):
  let la = len(a)
  | let lb = len(b)
  | if (lb == 0): None
    else: do
      var res = []
      | var i = 0
      | let _ = while (i + lb <= la):
          do
            if (slice(a, i, i + lb) == b): res += [i]
            | i += 1
            | res
          end
        end
      | res
    end
end

def _jq_slice_bounds(n, from_v, to_v):
  var s = if (is_none(from_v)): 0 elif (from_v != from_v): 0 else: from_v
  | var e = if (is_none(to_v)): n elif (to_v != to_v): n else: to_v
  | if (s < 0): s = s + n
  | if (e < 0): e = e + n
  | if (s < 0): s = 0
  | if (s > n): s = n
  | if (e > n): e = n
  | let fs = floor(s)
  | let ce = ceil(e)
  | [fs, if (ce < fs): fs else: ce]
end

def _jq_slice_idx(v, from_v, to_v):
  let t = type(v)
  | if (t == "None"): None
    elif (t == "array" || t == "string"): do
      if ((!is_none(from_v) && !is_number(from_v)) || (!is_none(to_v) && !is_number(to_v))):
        error("Start and end indices of an array slice must be numbers")
      else: do
        let b = _jq_slice_bounds(len(v), from_v, to_v)
        | slice(v, b[0], b[1])
      end
    end
    else: error("Cannot index " + _jq_tn(v) + " with object")
end

def _jq_index(v, i):
  let t = type(v)
  | let ti = type(i)
  | if (t == "dict"):
      if (ti == "string"): v[i]
      else: error("Cannot index object with " + _jq_dump(i))
    elif (t == "array"):
      if (ti == "number"): do
        if (i != i): None
        else: do
          let fi = floor(i)
          | let j = if (fi < 0): len(v) + fi else: fi
          | if (j < 0 || j >= len(v)): None else: v[j]
        end
      end
      elif (ti == "array"): _jq_subarray_indices(v, i)
      elif (ti == "dict"): _jq_slice_idx(v, i["start"], i["end"])
      else: error("Cannot index array with " + _jq_dump(i))
    elif (t == "None"):
      if (ti == "string" || ti == "number" || ti == "None"): None
      elif (ti == "dict"): None
      else: error("Cannot index null with " + _jq_dump(i))
    elif (t == "string" && ti == "dict"): _jq_slice_idx(v, i["start"], i["end"])
    else: error("Cannot index " + _jq_tn(v) + " with " + _jq_dump(i))
end

def _jq_iter(v, kont):
  let t = type(v)
  | if (t == "array"): foreach (x, v): kont(x) end
    elif (t == "dict"): foreach (k, keys(v)): kont(v[k]) end
    else: error("Cannot iterate over " + (if (t == "None"): "null" else: _jq_dump(v)))
end

# ----- Paths -----

def _jq_getpath(v, p):
  if (!is_array(p)): error("Path must be specified as an array")
  else: do
    var cur = v
    | var i = 0
    | let n = len(p)
    | let _ = while (i < n && !is_none(cur)):
        do cur = _jq_index(cur, p[i]) | i += 1 | cur end
      end
    | cur
  end
end

def _jq_setpath(v, p, nv):
  if (is_empty(p)): nv
  else: do
    let h = p[0]
    | let rest = slice(p, 1, len(p))
    | let t = type(v)
    | let th = type(h)
    | if (th == "string"):
        if (t == "dict" || t == "None"): do
          let base = if (t == "None"): dict() else: v
          | set(base, h, _jq_setpath(base[h], rest, nv))
        end
        else: error("Cannot index " + _jq_tn(v) + " with " + _jq_dump(h))
      elif (th == "number"):
        if (t == "array" || t == "None"): do
          let arr = if (t == "None"): [] else: v
          | let n = len(arr)
          | let fi = floor(h)
          | let idx = if (fi < 0): n + fi else: fi
          | if (h != h): error("Cannot set array element at NaN index")
            elif (idx < 0): error("Out of bounds negative array index")
            elif (idx > 536870911): error("Array index too large")
            else: do
              let child = if (idx < n): arr[idx] else: None
              | let nc = _jq_setpath(child, rest, nv)
              | if (idx < n): set(arr, idx, nc)
                else: arr + fold(range(idx - n - 1), [], fn(a, _): a + [None];) + [nc]
            end
        end
        else: error("Cannot index " + _jq_tn(v) + " with " + _jq_dump(h))
      elif (th == "dict"):
        if (t == "array" || t == "None"): do
          let arr = if (t == "None"): [] else: v
          | let b = _jq_slice_bounds(len(arr), h["start"], h["end"])
          | let cur = slice(arr, b[0], b[1])
          | let nc = _jq_setpath(cur, rest, nv)
          | if (!is_array(nc)): error("A slice of an array can only be assigned another array")
            else: slice(arr, 0, b[0]) + nc + slice(arr, b[1], len(arr))
        end
        elif (t == "string"): error("Cannot update string slices")
        else: error("Cannot update field at object index of " + _jq_tn(v))
      else: error("Cannot update field at array index of " + _jq_tn(v))
  end
end

# Deletes all `paths` (non-empty arrays) from v in one pass, resolving negative
# indices and slices against the original value.
def _jq_dels(v, paths):
  let t = type(v)
  | if (t == "None"): None
    elif (t == "dict"): do
      var acc = v
      | var subs = {}
      | var order = []
      | let _ = foreach (p, paths):
          do
            let h = p[0]
            | if (!is_string(h)): error("Cannot delete field at object index of " + _jq_tn(v))
              elif (len(p) == 1): acc = if (contains(keys(acc), h)): del(acc, h) else: acc
              else: do
                if (is_none(subs[h])): order += [h]
                | subs = set(subs, h, (if (is_none(subs[h])): [] else: subs[h]) + [slice(p, 1, len(p))])
              end
          end
        end
      | let _ = foreach (h, order):
          if (contains(keys(acc), h)): acc = set(acc, h, _jq_dels(acc[h], subs[h]))
        end
      | acc
    end
    elif (t == "array"): do
      let n = len(v)
      | var removed = {}
      | var subs = {}
      | let _ = foreach (p, paths):
          do
            let h = p[0]
            | let th = type(h)
            | if (th == "number"): do
                let fi = floor(h)
                | let idx = if (fi < 0): n + fi else: fi
                | if (h == h && idx >= 0 && idx < n): do
                    if (len(p) == 1): removed = set(removed, to_string(idx), true)
                    else: subs = set(subs, to_string(idx), (if (is_none(subs[to_string(idx)])): [] else: subs[to_string(idx)]) + [slice(p, 1, len(p))])
                  end
              end
              elif (th == "dict"): do
                let b = _jq_slice_bounds(n, h["start"], h["end"])
                | if (len(p) == 1): foreach (i, range(b[1] - b[0] - 1)): removed = set(removed, to_string(b[0] + i), true) end
              end
              else: error("Cannot delete field at object index of array")
          end
        end
      | var out = []
      | let _ = foreach (i, if (n == 0): [] else: range(n - 1)):
          do
            let ks = to_string(i)
            | if (is_none(removed[ks])):
                out += [if (is_none(subs[ks])): v[i] else: _jq_dels(v[i], subs[ks])]
          end
        end
      | out
    end
    else: error("Cannot delete field at " + (if (type(paths[0][0]) == "string"): "object" else: "array") + " index of " + _jq_tn(v))
end

def _jq_delpaths(v, paths):
  if (!is_array(paths)): error("Paths must be specified as an array")
  else: do
    let _ = foreach (p, paths): if (!is_array(p)): error("Path must be specified as an array") end
    | if (is_empty(paths)): v
      elif (fold(paths, false, fn(a, p): a || is_empty(p);)): None
      else: _jq_dels(v, paths)
  end
end

# ===== Compiler =====
#
# Value closures:  fn(v, env, k)      -> calls k(output) for every output
# Path closures:   fn(p, v, env, k)   -> calls k(path, output); path is None for
#                                        values that are not paths.
# `env` is a dict: "$name" -> variable, "name/arity" -> function record,
# "*label*name" -> break id.

def _jq_uid():
  to_string(rand())
end

# Runs c(v, env, ...) and returns [found, first_output], stopping the generator early.
def _jq_first_out(c, v, env):
  var res = None
  | var got = false
  | let id = "\u0002" + _jq_uid()
  | let _ = (try:
      c(v, env, fn(x): do res = x | got = true | error(id) end;)
    catch(e):
      if (e["value"] != id): error(e["value"]))
  | [got, res]
end

# Collects all outputs of c(v, env) into an array.
def _jq_collect(c, v, env):
  var out = []
  | let _ = c(v, env, fn(x): out += [x];)
  | out
end

def _jq_first_or_null(c, v, env):
  let r = _jq_first_out(c, v, env)
  | r[1]
end

# ----- Path helpers -----

def _jq_path_ext(p, base, comp):
  if (is_none(p)):
    error("Invalid path expression near attempt to access element " + _jq_trunc_dump(_jq_tojson(comp)) + " of " + _jq_trunc_dump(_jq_tojson(base)))
  else: p + [comp]
end

def _jq_path_iter_check(p, base):
  if (is_none(p)):
    error("Invalid path expression near attempt to iterate through " + _jq_trunc_dump(_jq_tojson(base)))
  else: p
end

def _jq_path_check(p, v):
  if (is_none(p)): error("Invalid path expression with result " + _jq_trunc_dump(_jq_tojson(v)))
  else: p
end

# ----- Pattern destructuring -----

# Compiles a pattern into fn(x, v, env, kb) calling kb(env') for each binding.
def _jq_cpat(pat):
  let kind = pat["kind"]
  | if (kind == "var"): do
      let key = "$" + pat["name"]
      | fn(x, v, env, kb): kb(set(env, key, x));
    end
    elif (kind == "arr"): do
      let subs = map(pat["items"], fn(p): _jq_cpat(p);)
      | fn(x, v, env, kb):
          if (!is_array(x) && !is_none(x)): error("Cannot index " + _jq_tn(x) + " with number")
          else: _jq_pat_arr(subs, 0, x, v, env, kb);
    end
    else: do
      let ents = map(pat["entries"], fn(e):
        {key: _jq_c(e["key"]), bind: e["bind"], pat: (if (is_none(e["pat"])): None else: _jq_cpat(e["pat"]))}
      ;)
      | fn(x, v, env, kb): _jq_pat_obj(ents, 0, x, v, env, kb);
    end
end

def _jq_pat_arr(subs, i, x, v, env, kb):
  if (i >= len(subs)): kb(env)
  else: subs[i](_jq_index(x, i), v, env, fn(env2): _jq_pat_arr(subs, i + 1, x, v, env2, kb);)
end

def _jq_pat_obj(ents, i, x, v, env, kb):
  if (i >= len(ents)): kb(env)
  else: do
    let e = ents[i]
    | e["key"](v, env, fn(key):
        if (!is_string(key)): error("Cannot index " + _jq_tn(x) + " with " + _jq_dump(key))
        else: do
          let val = _jq_field(x, key)
          | let env1 = if (is_none(e["bind"])): env else: set(env, "$" + e["bind"], val)
          | if (is_none(e["pat"])): _jq_pat_obj(ents, i + 1, x, v, env1, kb)
            else: e["pat"](val, v, env1, fn(env2): _jq_pat_obj(ents, i + 1, x, v, env2, kb);)
        end
      ;)
  end
end

def _jq_pat_vars(pat):
  let kind = pat["kind"]
  | if (kind == "var"): [pat["name"]]
    elif (kind == "arr"): fold(pat["items"], [], fn(a, p): a + _jq_pat_vars(p);)
    else: fold(pat["entries"], [], fn(a, e):
      a + (if (is_none(e["bind"])): [] else: [e["bind"]]) + (if (is_none(e["pat"])): [] else: _jq_pat_vars(e["pat"]))
    ;)
end

# Compiles the patterns of `as` / reduce / foreach.
# Returns fn(x, v, env, kb) trying alternatives left to right on errors (?//).
def _jq_cpats(pats):
  if (len(pats) == 1): _jq_cpat(pats[0])
  else: do
    let cs = map(pats, fn(p): _jq_cpat(p);)
    | let names = fold(pats, [], fn(a, p): a + _jq_pat_vars(p);)
    | fn(x, v, env, kb):
        do
          let env0 = fold(names, env, fn(e, n): set(e, "$" + n, None);)
          | _jq_pats_alt(cs, 0, x, v, env0, kb)
        end;
  end
end

def _jq_pats_alt(cs, i, x, v, env, kb):
  if (i == len(cs) - 1): cs[i](x, v, env, kb)
  else: try: cs[i](x, v, env, kb)
    catch(e):
      if (_jq_is_break(e["value"])): error(e["value"])
      else: _jq_pats_alt(cs, i + 1, x, v, env, kb)
end

# `as` with several patterns: an error raised by the body (not downstream) makes
# the next alternative run.
def _jq_bind_alt(cs, i, x, v, env, bc, k):
  if (i == len(cs) - 1): cs[i](x, v, env, fn(env2): bc(v, env2, k);)
  else: _jq_try_run(
    fn(k2): cs[i](x, v, env, fn(env2): bc(v, env2, k2););,
    k,
    fn(msg): if (_jq_is_break(msg)): error(msg) else: _jq_bind_alt(cs, i + 1, x, v, env, bc, k);)
end

def _jq_cbind1(pc, bc):
  fn(x, v, env, k): pc(x, v, env, fn(env2): bc(v, env2, k););
end

def _jq_cbindn(pats, bc):
  let cs = map(pats, fn(p): _jq_cpat(p);)
  | let names = fold(pats, [], fn(a, p): a + _jq_pat_vars(p);)
  | fn(x, v, env, k):
      _jq_bind_alt(cs, 0, x, v, fold(names, env, fn(e, n): set(e, "$" + n, None);), bc, k);
end

def _jq_cbind(pats, bc):
  if (len(pats) == 1): _jq_cbind1(_jq_cpat(pats[0]), bc)
  else: _jq_cbindn(pats, bc)
end

# ----- Strings, formats -----

def _jq_format(fmt, v):
  if (fmt == "text"): _jq_tostring(v)
  elif (fmt == "json"): _jq_tojson(v)
  elif (fmt == "html"): do
    let s = _jq_tostring(v)
    | replace(replace(replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "'", "&apos;"), "\"", "&quot;")
  end
  elif (fmt == "uri"): do
    var out = ""
    | let _ = foreach (c, explode(_jq_tostring(v))):
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95 || c == 46 || c == 126):
          out += implode([c])
        else: out += url_encode(implode([c]))
      end
    | out
  end
  elif (fmt == "csv" || fmt == "tsv"): do
    if (!is_array(v)): error(_jq_dump(v) + " cannot be " + fmt + "-formatted, only an array can be")
    else: do
      let parts = map(v, fn(x):
        let t = type(x)
        | if (t == "number"): _jq_numstr(x)
          elif (t == "bool"): if (x): "true" else: "false"
          elif (t == "None"): ""
          elif (t == "string"):
            if (fmt == "csv"): "\"" + replace(x, "\"", "\"\"") + "\""
            else: replace(replace(replace(replace(x, "\\", "\\\\"), "\t", "\\t"), "\n", "\\n"), "\r", "\\r")
          else: error(_jq_dump(x) + " is not valid in a csv row")
      ;)
      | join(parts, if (fmt == "csv"): "," else: "\t")
    end
  end
  elif (fmt == "sh"): do
    let one = fn(x):
      let t = type(x)
      | if (t == "string"): "'" + replace(x, "'", "'\\''") + "'"
        elif (t == "array" || t == "dict"): error(_jq_dump(x) + " can not be escaped for shell")
        else: _jq_tojson(x)
    ;
    | if (is_array(v)): join(map(v, one), " ") else: one(v)
  end
  elif (fmt == "base64"): base64(_jq_tostring(v))
  elif (fmt == "base64d"): base64d(_jq_tostring(v))
  elif (fmt == "urid"): url_decode(_jq_tostring(v))
  elif (fmt == "base32"): _jq_base32(_jq_tostring(v))
  elif (fmt == "base32d"): _jq_base32d(_jq_tostring(v))
  else: error(fmt + " is not a valid format")
end

def _jq_base32(s):
  let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
  | var out = ""
  | let bs = to_array(to_bytes(s))
  | var i = 0
  | let n = len(bs)
  | let _ = while (i < n):
      do
        let chunk = slice(bs, i, if (i + 5 < n): i + 5 else: n)
        | let cl = len(chunk)
        | var bits = 0
        | var nb = 0
        | var chars = ""
        | let _ = foreach (b, chunk):
            do
              bits = bits * 256 + b
              | nb += 8
              | let _ = while (nb >= 5):
                  do
                    let sh = pow(2, nb - 5)
                    | let idx = floor(bits / sh)
                    | chars += alphabet[idx]
                    | bits = bits - idx * sh
                    | nb -= 5
                  end
                end
              | nb
            end
          end
        | let _ = if (nb > 0): chars += alphabet[bits * pow(2, 5 - nb)]
        | let padded = chars + fold(range(8 - len(chars) - 1), "", fn(a, _): a + "=";)
        | out += if (len(chars) >= 8): chars else: padded
        | i += 5
      end
    end
  | out
end

def _jq_base32d(s):
  let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
  | var bits = 0
  | var nb = 0
  | var bytes = []
  | let _ = foreach (c, to_array(s)):
      if (c != "="):
        do
          let idx = index(alphabet, c)
          | bits = bits * 32 + idx
          | nb += 5
          | if (nb >= 8):
              do
                let sh = pow(2, nb - 8)
                | let b = floor(bits / sh)
                | bytes += [b]
                | bits = bits - b * sh
                | nb -= 8
              end
        end
    end
  | decode(to_bytes(bytes), "utf-8")
end

def _jq_str_go(parts, i, v, env, suffix, fmt, k):
  if (i < 0): k(suffix)
  else: do
    let p = parts[i]
    | if (is_string(p)): _jq_str_go(parts, i - 1, v, env, p + suffix, fmt, k)
      else: p(v, env, fn(x):
        _jq_str_go(parts, i - 1, v, env, (if (is_none(fmt)): _jq_tostring(x) else: _jq_format(fmt, x)) + suffix, fmt, k)
      ;)
  end
end

# ----- Objects -----

def _jq_obj_go(kcs, vcs, i, v, env, pairs, k):
  if (i >= len(kcs)): do
    var d = dict()
    | let _ = foreach (pr, pairs): d = set(d, pr[0], pr[1]) end
    | k(d)
  end
  else: kcs[i](v, env, fn(key):
    if (!is_string(key)): error("Object keys must be strings")
    else: vcs[i](v, env, fn(val): _jq_obj_go(kcs, vcs, i + 1, v, env, pairs + [[key, val]], k);)
  ;)
end

# ----- Function calls -----

def _jq_bind_params(rec, args, i, v, cenv, e, k):
  let params = rec["params"]
  | if (i >= len(params)): rec["body"](v, e, k)
    else: do
      let p = params[i]
      | let a = args[i]
      | if (starts_with(p, "$")): do
          let nm = slice(p, 1, len(p))
          | a["c"](v, cenv, fn(x):
              _jq_bind_params(rec, args, i + 1, v, cenv,
                set(set(e, p, x), nm + "/0", {c: fn(_v, _e, k2): k2(x);, cenv: None, pc: None}), k)
            ;)
        end
        else: _jq_bind_params(rec, args, i + 1, v, cenv, set(e, p + "/0", a), k)
    end
end

def _jq_call_rec(rec, args, v, env, k):
  if (is_none(rec["params"])): rec["c"](v, rec["cenv"], k)
  else: _jq_bind_params(rec, args, 0, v, env, set(rec["env"], rec["key"], rec), k)
end

def _jq_bind_params_p(rec, args, i, p, v, cenv, e, k):
  let params = rec["params"]
  | if (i >= len(params)): rec["getp"]()(p, v, e, k)
    else: do
      let pm = params[i]
      | let a = args[i]
      | if (starts_with(pm, "$")): do
          let nm = slice(pm, 1, len(pm))
          | a["c"](v, cenv, fn(x):
              _jq_bind_params_p(rec, args, i + 1, p, v, cenv,
                set(set(e, pm, x), nm + "/0", {c: fn(_v, _e, k2): k2(x);, cenv: None, pc: None}), k)
            ;)
        end
        else: _jq_bind_params_p(rec, args, i + 1, p, v, cenv, set(e, pm + "/0", a), k)
    end
end

def _jq_call_rec_p(rec, args, p, v, env, k):
  if (is_none(rec["params"])): do
    if (is_none(rec["pc"])): rec["c"](v, rec["cenv"], fn(x): k(None, x);)
    else: rec["pc"]()(p, v, rec["cenv"], k)
  end
  else: _jq_bind_params_p(rec, args, 0, p, v, env, set(rec["env"], rec["key"], rec), k)
end

# Builds argument records {c, cenv, pc} for a call at runtime.
def _jq_make_args(argcs, argps, env):
  var out = []
  | let _ = foreach (i, range(len(argcs) - 1)): out += [{c: argcs[i], cenv: env, pc: argps[i]}] end
  | out
end

# A getter that compiles the path-mode version of `ast` on first use.
def _jq_lazy_path(ast):
  var cache = None
  | fn(): if (is_none(cache)): do cache = _jq_cp(ast) | cache end else: cache;
end

# ----- Assignment -----

def _jq_arith_update(op, a, b):
  if (op == "+="): _jq_add(a, b)
  elif (op == "-="): _jq_sub(a, b)
  elif (op == "*="): _jq_mul(a, b)
  elif (op == "/="): _jq_div(a, b)
  elif (op == "%="): _jq_mod(a, b)
  else: if (_jq_truthy(a)): a else: b
end

def _jq_c_assign(ast):
  let op = ast["op"]
  | let lp = _jq_cp(ast["left"])
  | let rc = _jq_c(ast["right"])
  | if (op == "="):
      fn(v, env, k):
        rc(v, env, fn(val):
          do
            var acc = v
            | let _ = lp([], v, env, fn(p, _x): acc = _jq_setpath(acc, _jq_path_check(p, _x), val);)
            | k(acc)
          end
        ;);
    elif (op == "|="):
      fn(v, env, k):
        do
          var acc = v
          | var dels = []
          | let _ = lp([], v, env, fn(p, _x):
              do
                let pp = _jq_path_check(p, _x)
                | let r = _jq_first_out(rc, _jq_getpath(acc, pp), env)
                | if (r[0]): acc = _jq_setpath(acc, pp, r[1])
                  else: dels += [pp]
              end
            ;)
          | k(_jq_delpaths(acc, dels))
        end;
    else:
      fn(v, env, k):
        rc(v, env, fn(x):
          do
            var acc = v
            | let _ = lp([], v, env, fn(p, _x):
                do
                  let pp = _jq_path_check(p, _x)
                  | acc = _jq_setpath(acc, pp, _jq_arith_update(op, _jq_getpath(acc, pp), x))
                end
              ;)
            | k(acc)
          end
        ;);
end

# ----- Value-mode compiler -----

def _jq_binop_fn(op):
  if (op == "+"): fn(a, b): _jq_add(a, b);
  elif (op == "-"): fn(a, b): _jq_sub(a, b);
  elif (op == "*"): fn(a, b): _jq_mul(a, b);
  elif (op == "/"): fn(a, b): _jq_div(a, b);
  elif (op == "%"): fn(a, b): _jq_mod(a, b);
  elif (op == "=="): fn(a, b): a == b;
  elif (op == "!="): fn(a, b): a != b;
  elif (op == "<"): fn(a, b): _jq_cmp(a, b) < 0;
  elif (op == "<="): fn(a, b): _jq_cmp(a, b) <= 0;
  elif (op == ">"): fn(a, b): _jq_cmp(a, b) > 0;
  else: fn(a, b): _jq_cmp(a, b) >= 0;
end

def _jq_c(ast):
  let ty = ast["type"]
  | if (ty == "literal"): do
      let val = ast["value"]
      | fn(v, env, k): k(val);
    end
    elif (ty == "identity"): fn(v, env, k): k(v);
    elif (ty == "field"): do
      let name = ast["name"]
      | if (ast["base"]["type"] == "identity"): fn(v, env, k): k(_jq_field(v, name));
        else: do
          let bc = _jq_c(ast["base"])
          | fn(v, env, k): bc(v, env, fn(b): k(_jq_field(b, name)););
        end
    end
    elif (ty == "index"): do
      let bc = _jq_c(ast["base"])
      | let ic = _jq_c(ast["idx"])
      | fn(v, env, k): ic(v, env, fn(i): bc(v, env, fn(b): k(_jq_index(b, i));););
    end
    elif (ty == "iter"): do
      let bc = _jq_c(ast["base"])
      | fn(v, env, k): bc(v, env, fn(b): _jq_iter(b, k););
    end
    elif (ty == "slice"): do
      let bc = _jq_c(ast["base"])
      | let fc = if (is_none(ast["from"])): fn(v, env, k): k(None); else: _jq_c(ast["from"])
      | let tc = if (is_none(ast["to"])): fn(v, env, k): k(None); else: _jq_c(ast["to"])
      | fn(v, env, k): fc(v, env, fn(f): tc(v, env, fn(t): bc(v, env, fn(b): k(_jq_slice_idx(b, f, t)););););
    end
    elif (ty == "recurse_all"): fn(v, env, k): _jq_recurse_all(v, k);
    elif (ty == "var_ref"): do
      let name = ast["name"]
      | let key = "$" + name
      | if (name == "ENV"): fn(v, env, k): k(_jq_env_dict());
        else: fn(v, env, k): k(env[key]);
    end
    elif (ty == "loc"): fn(v, env, k): k({file: "<top-level>", line: 1});
    elif (ty == "str"): do
      let parts = map(ast["parts"], fn(p): if (is_string(p)): p else: _jq_c(p);)
      | let fmt = ast["fmt"]
      | let lastidx = len(parts) - 1
      | fn(v, env, k): _jq_str_go(parts, lastidx, v, env, "", fmt, k);
    end
    elif (ty == "format"): do
      let name = ast["name"]
      | fn(v, env, k): k(_jq_format(name, v));
    end
    elif (ty == "array"): do
      if (is_none(ast["expr"])): fn(v, env, k): k([]);
      else: do
        let ec = _jq_c(ast["expr"])
        | fn(v, env, k): k(_jq_collect(ec, v, env));
      end
    end
    elif (ty == "object"): do
      let kcs = map(ast["entries"], fn(e): _jq_c(e["key"]);)
      | let vcs = map(ast["entries"], fn(e): _jq_c(e["val"]);)
      | fn(v, env, k): _jq_obj_go(kcs, vcs, 0, v, env, [], k);
    end
    elif (ty == "neg"): do
      let ic = _jq_c(ast["inner"])
      | fn(v, env, k): ic(v, env, fn(x):
          if (is_number(x)): k(0 - x)
          else: error(_jq_dump(x) + " cannot be negated")
        ;);
    end
    elif (ty == "binop"): do
      let lc = _jq_c(ast["left"])
      | let rc = _jq_c(ast["right"])
      | let opf = _jq_binop_fn(ast["op"])
      | if (ast["right"]["type"] == "literal"): do
          let rv = ast["right"]["value"]
          | fn(v, env, k): lc(v, env, fn(a): k(opf(a, rv)););
        end
        else: fn(v, env, k): rc(v, env, fn(b): lc(v, env, fn(a): k(opf(a, b));););
    end
    elif (ty == "and"): do
      let lc = _jq_c(ast["left"])
      | let rc = _jq_c(ast["right"])
      | fn(v, env, k): lc(v, env, fn(a):
          if (!_jq_truthy(a)): k(false) else: rc(v, env, fn(b): k(_jq_truthy(b));)
        ;);
    end
    elif (ty == "or"): do
      let lc = _jq_c(ast["left"])
      | let rc = _jq_c(ast["right"])
      | fn(v, env, k): lc(v, env, fn(a):
          if (_jq_truthy(a)): k(true) else: rc(v, env, fn(b): k(_jq_truthy(b));)
        ;);
    end
    elif (ty == "alt"): do
      let lc = _jq_c(ast["left"])
      | let rc = _jq_c(ast["right"])
      | fn(v, env, k):
          do
            var found = false
            | let _ = _jq_try_run(
                fn(k2): lc(v, env, fn(x): if (_jq_truthy(x)): do found = true | k2(x) end;);,
                k,
                fn(err): if (_jq_is_break(err)): error(err) else: None;)
            | if (!found): rc(v, env, k)
          end;
    end
    elif (ty == "pipe"): do
      let lc = _jq_c(ast["left"])
      | let rc = _jq_c(ast["right"])
      | fn(v, env, k): lc(v, env, fn(x): rc(x, env, k););
    end
    elif (ty == "comma"): do
      let lc = _jq_c(ast["left"])
      | let rc = _jq_c(ast["right"])
      | fn(v, env, k): do lc(v, env, k) | rc(v, env, k) end;
    end
    elif (ty == "if"): do
      let cc = _jq_c(ast["cond"])
      | let tc = _jq_c(ast["then"])
      | let ec = if (is_none(ast["orelse"])): fn(v, env, k): k(v); else: _jq_c(ast["orelse"])
      | fn(v, env, k): cc(v, env, fn(c): if (_jq_truthy(c)): tc(v, env, k) else: ec(v, env, k););
    end
    elif (ty == "try"): do
      let bc = _jq_c(ast["body"])
      | if (is_none(ast["handler"])):
          fn(v, env, k): _jq_try_run(fn(k2): bc(v, env, k2);, k, fn(err): if (_jq_is_break(err)): error(err) else: None;);
        else: do
          let hc = _jq_c(ast["handler"])
          | fn(v, env, k): _jq_try_run(fn(k2): bc(v, env, k2);, k,
              fn(err): if (_jq_is_break(err)): error(err) else: hc(err, env, k););
        end
    end
    elif (ty == "bind"): do
      let sc = _jq_c(ast["src"])
      | let bc = _jq_c(ast["body"])
      | let bind = _jq_cbind(ast["pats"], bc)
      | fn(v, env, k): sc(v, env, fn(x): bind(x, v, env, k););
    end
    elif (ty == "reduce"): do
      let sc = _jq_c(ast["src"])
      | let pc = _jq_cpats(ast["pats"])
      | let ic = _jq_c(ast["init"])
      | let uc = _jq_c(ast["update"])
      | fn(v, env, k): ic(v, env, fn(init):
          do
            var st = init
            | let _ = sc(v, env, fn(x): pc(x, v, env, fn(env2):
                do
                  var lastv = None
                  | let _ = uc(st, env2, fn(y): lastv = y;)
                  | st = lastv
                end
              ;);)
            | k(st)
          end
        ;);
    end
    elif (ty == "foreach"): do
      let sc = _jq_c(ast["src"])
      | let pc = _jq_cpats(ast["pats"])
      | let ic = _jq_c(ast["init"])
      | let uc = _jq_c(ast["update"])
      | let has_ext = !is_none(ast["extract"])
      | let ec = if (has_ext): _jq_c(ast["extract"]) else: fn(v, env, k): k(v);
      | fn(v, env, k): ic(v, env, fn(init):
          do
            var st = init
            | sc(v, env, fn(x): pc(x, v, env, fn(env2):
                uc(st, env2, fn(y): do st = y | ec(y, env2, k) end;)
              ;);)
          end
        ;);
    end
    elif (ty == "label"): do
      let name = ast["name"]
      | let key = "*label*" + name
      | let bc = _jq_c(ast["body"])
      | fn(v, env, k):
          do
            let id = "\u0002" + _jq_uid()
            | try: bc(v, set(env, key, id), k)
              catch(e): if (e["value"] != id): error(e["value"])
          end;
    end
    elif (ty == "break"): do
      let key = "*label*" + ast["name"]
      | fn(v, env, k): error(env[key]);
    end
    elif (ty == "def"): do
      let bodyc = _jq_c(ast["body"])
      | let getp = _jq_lazy_path(ast["body"])
      | let nc = _jq_c(ast["next"])
      | let params = ast["params"]
      | let key = ast["name"] + "/" + to_string(len(params))
      | fn(v, env, k): nc(v, set(env, key, {params: params, body: bodyc, getp: getp, env: env, key: key}), k);
    end
    elif (ty == "call"): _jq_c_call(ast)
    elif (ty == "assign"): _jq_c_assign(ast)
    else: error("jq: unknown AST node type: " + ty)
end

def _jq_c_call(ast):
  let name = ast["name"]
  | let args = ast["args"]
  | let key = name + "/" + to_string(len(args))
  | let argcs = map(args, fn(a): _jq_c(a);)
  | let argps = map(args, fn(a): _jq_lazy_path(a);)
  | let fb = _jq_builtin(name, args, argcs)
  | let fallback = if (is_none(fb)): fn(v, env, k): error("jq: error: " + key + " is not defined");
      else: fb
  | if (len(args) == 0):
      fn(v, env, k):
        do
          let rec = env[key]
          | if (is_none(rec)): fallback(v, env, k)
            else: _jq_call_rec(rec, [], v, env, k)
        end;
    else:
      fn(v, env, k):
        do
          let rec = env[key]
          | if (is_none(rec)): fallback(v, env, k)
            else: _jq_call_rec(rec, _jq_make_args(argcs, argps, env), v, env, k)
        end;
end

def _jq_recurse_all(v, k):
  do
    k(v)
    | let t = type(v)
    | if (t == "array"): foreach (x, v): _jq_recurse_all(x, k) end
      elif (t == "dict"): foreach (key, keys(v)): _jq_recurse_all(v[key], k) end
  end
end

def _jq_recurse_all_p(p, v, k):
  do
    k(p, v)
    | let t = type(v)
    | if (t == "array"): foreach (i, range(len(v) - 1)): _jq_recurse_all_p(p + [i], v[i], k) end
      elif (t == "dict"): foreach (key, keys(v)): _jq_recurse_all_p(p + [key], v[key], k) end
  end
end

def _jq_env_dict():
  try: env() catch: dict()
end

# ----- Path-mode compiler -----

def _jq_cp(ast):
  let ty = ast["type"]
  | if (ty == "identity"): fn(p, v, env, k): k(p, v);
    elif (ty == "recurse_all"): fn(p, v, env, k): _jq_recurse_all_p(_jq_path_check(p, v), v, k);
    elif (ty == "field"): do
      let name = ast["name"]
      | let bp = _jq_cp(ast["base"])
      | fn(p, v, env, k): bp(p, v, env, fn(p1, b): k(_jq_path_ext(p1, b, name), _jq_field(b, name)););
    end
    elif (ty == "index"): do
      let bp = _jq_cp(ast["base"])
      | let ic = _jq_c(ast["idx"])
      | fn(p, v, env, k): ic(v, env, fn(i): bp(p, v, env, fn(p1, b): k(_jq_path_ext(p1, b, i), _jq_index(b, i));););
    end
    elif (ty == "iter"): do
      let bp = _jq_cp(ast["base"])
      | fn(p, v, env, k): bp(p, v, env, fn(p1, b):
          do
            let t = type(b)
            | let _ = _jq_path_iter_check(p1, b)
            | if (t == "array"): foreach (i, range(len(b) - 1)): k(p1 + [i], b[i]) end
              elif (t == "dict"): foreach (key, keys(b)): k(p1 + [key], b[key]) end
              else: error("Cannot iterate over " + (if (t == "None"): "null" else: _jq_dump(b)))
          end
        ;);
    end
    elif (ty == "slice"): do
      let bp = _jq_cp(ast["base"])
      | let fc = if (is_none(ast["from"])): fn(v, env, k): k(None); else: _jq_c(ast["from"])
      | let tc = if (is_none(ast["to"])): fn(v, env, k): k(None); else: _jq_c(ast["to"])
      | fn(p, v, env, k): fc(v, env, fn(f): tc(v, env, fn(t): bp(p, v, env, fn(p1, b):
          k(_jq_path_ext(p1, b, {"start": f, "end": t}), _jq_slice_idx(b, f, t));
        );););
    end
    elif (ty == "pipe"): do
      let lp = _jq_cp(ast["left"])
      | let rp = _jq_cp(ast["right"])
      | fn(p, v, env, k): lp(p, v, env, fn(p1, x): rp(p1, x, env, k););
    end
    elif (ty == "comma"): do
      let lp = _jq_cp(ast["left"])
      | let rp = _jq_cp(ast["right"])
      | fn(p, v, env, k): do lp(p, v, env, k) | rp(p, v, env, k) end;
    end
    elif (ty == "if"): do
      let cc = _jq_c(ast["cond"])
      | let tp = _jq_cp(ast["then"])
      | let ep = if (is_none(ast["orelse"])): fn(p, v, env, k): k(p, v); else: _jq_cp(ast["orelse"])
      | fn(p, v, env, k): cc(v, env, fn(c): if (_jq_truthy(c)): tp(p, v, env, k) else: ep(p, v, env, k););
    end
    elif (ty == "alt"): do
      let lp = _jq_cp(ast["left"])
      | let rp = _jq_cp(ast["right"])
      | fn(p, v, env, k):
          do
            var found = false
            | let _ = _jq_try_run(
                fn(k2): lp(p, v, env, fn(p1, x): if (_jq_truthy(x)): do found = true | k2([p1, x]) end;);,
                fn(pr): k(pr[0], pr[1]);,
                fn(err): if (_jq_is_break(err)): error(err) else: None;)
            | if (!found): rp(p, v, env, k)
          end;
    end
    elif (ty == "try"): do
      let bp = _jq_cp(ast["body"])
      | if (is_none(ast["handler"])):
          fn(p, v, env, k): _jq_try_run(fn(k2): bp(p, v, env, fn(p1, x): k2([p1, x]););, fn(pr): k(pr[0], pr[1]);,
            fn(err): if (_jq_is_break(err)): error(err) else: None;);
        else: do
          let hp = _jq_cp(ast["handler"])
          | fn(p, v, env, k): _jq_try_run(fn(k2): bp(p, v, env, fn(p1, x): k2([p1, x]););, fn(pr): k(pr[0], pr[1]);,
              fn(err): if (_jq_is_break(err)): error(err) else: hp(None, err, env, k););
        end
    end
    elif (ty == "bind"): do
      let sc = _jq_c(ast["src"])
      | let pc = _jq_cpats(ast["pats"])
      | let bp = _jq_cp(ast["body"])
      | fn(p, v, env, k): sc(v, env, fn(x): pc(x, v, env, fn(env2): bp(p, v, env2, k);););
    end
    elif (ty == "reduce"): do
      let sc = _jq_c(ast["src"])
      | let pc = _jq_cpats(ast["pats"])
      | let ip = _jq_cp(ast["init"])
      | let up = _jq_cp(ast["update"])
      | fn(p, v, env, k): ip(p, v, env, fn(ip1, init):
          do
            var sp = ip1
            | var sv = init
            | let _ = sc(v, env, fn(x): pc(x, v, env, fn(env2):
                do
                  var lp1 = None
                  | var lv = None
                  | let _ = up(sp, sv, env2, fn(p2, y): do lp1 = p2 | lv = y end;)
                  | sp = lp1
                  | sv = lv
                end
              ;);)
            | k(sp, sv)
          end
        ;);
    end
    elif (ty == "foreach"): do
      let sc = _jq_c(ast["src"])
      | let pc = _jq_cpats(ast["pats"])
      | let ip = _jq_cp(ast["init"])
      | let up = _jq_cp(ast["update"])
      | let ep = if (is_none(ast["extract"])): fn(p, v, env, k): k(p, v); else: _jq_cp(ast["extract"])
      | fn(p, v, env, k): ip(p, v, env, fn(ip1, init):
          do
            var sp = ip1
            | var sv = init
            | sc(v, env, fn(x): pc(x, v, env, fn(env2):
                up(sp, sv, env2, fn(p2, y): do sp = p2 | sv = y | ep(p2, y, env2, k) end;)
              ;);)
          end
        ;);
    end
    elif (ty == "label"): do
      let key = "*label*" + ast["name"]
      | let bp = _jq_cp(ast["body"])
      | fn(p, v, env, k):
          do
            let id = "\u0002" + _jq_uid()
            | try: bp(p, v, set(env, key, id), k)
              catch(e): if (e["value"] != id): error(e["value"])
          end;
    end
    elif (ty == "break"): do
      let key = "*label*" + ast["name"]
      | fn(p, v, env, k): error(env[key]);
    end
    elif (ty == "def"): do
      let bodyc = _jq_c(ast["body"])
      | let getp = _jq_lazy_path(ast["body"])
      | let np = _jq_cp(ast["next"])
      | let params = ast["params"]
      | let key = ast["name"] + "/" + to_string(len(params))
      | fn(p, v, env, k): np(p, v, set(env, key, {params: params, body: bodyc, getp: getp, env: env, key: key}), k);
    end
    elif (ty == "call"): _jq_cp_call(ast)
    else: do
      let vc = _jq_c(ast)
      | fn(p, v, env, k): vc(v, env, fn(x): k(None, x););
    end
end

def _jq_cp_call(ast):
  let name = ast["name"]
  | let args = ast["args"]
  | let key = name + "/" + to_string(len(args))
  | let argcs = map(args, fn(a): _jq_c(a);)
  | let argps = map(args, fn(a): _jq_lazy_path(a);)
  | let fb = _jq_builtin_p(name, args, argcs)
  | let fallback = if (is_none(fb)): do
      let vc = _jq_c(ast)
      | fn(p, v, env, k): vc(v, env, fn(x): k(None, x););
    end
    else: fb
  | fn(p, v, env, k):
      do
        let rec = env[key]
        | if (is_none(rec)): fallback(p, v, env, k)
          else: _jq_call_rec_p(rec, _jq_make_args(argcs, argps, env), p, v, env, k)
      end;
end

# ===== Native builtins =====

def _jq_n0(f): fn(v, env, k): k(f(v)); end
def _jq_n1(f, c1): fn(v, env, k): c1(v, env, fn(a): k(f(v, a));); end
def _jq_n2(f, c1, c2): fn(v, env, k): c2(v, env, fn(b): c1(v, env, fn(a): k(f(v, a, b)););); end
def _jq_n3(f, c1, c2, c3): fn(v, env, k): c3(v, env, fn(x): c2(v, env, fn(b): c1(v, env, fn(a): k(f(v, a, b, x));););); end

# ----- scalar helpers -----

def _jq_length(v):
  let t = type(v)
  | if (t == "None"): 0
    elif (t == "string" || t == "array"): len(v)
    elif (t == "dict"): len(keys(v))
    elif (t == "number"): if (v < 0): 0 - v else: v
    else: error(_jq_dump(v) + " has no length")
end

def _jq_keys(v):
  let t = type(v)
  | if (t == "dict"): sort(keys(v))
    elif (t == "array"): if (is_empty(v)): [] else: range(len(v) - 1)
    else: error(_jq_dump(v) + " has no keys")
end

def _jq_keys_unsorted(v):
  let t = type(v)
  | if (t == "dict"): keys(v)
    elif (t == "array"): if (is_empty(v)): [] else: range(len(v) - 1)
    else: error(_jq_dump(v) + " has no keys")
end

def _jq_has(v, key):
  let t = type(v)
  | let tk = type(key)
  | if (t == "dict" && tk == "string"): contains(keys(v), key)
    elif (t == "array" && tk == "number"): key >= 0 && key < len(v)
    else: error("Cannot check whether " + _jq_tn(v) + " has a " + (if (tk == "None"): "null" else: _jq_tn(key)) + " key")
end

def _jq_contains_in(a, b):
  let ta = type(a)
  | let tb = type(b)
  | if (ta == "dict" && tb == "dict"):
      fold(keys(b), true, fn(acc, key): acc && contains(keys(a), key) && _jq_contains_in(a[key], b[key]);)
    elif (ta == "array" && tb == "array"):
      fold(b, true, fn(acc, y): acc && fold(a, false, fn(f, x): f || _jq_contains_in(x, y););)
    elif (ta == "string" && tb == "string"): contains(a, b)
    else: a == b
end

def _jq_contains(a, b):
  if (type(a) != type(b)): error(_jq_dump(a) + " and " + _jq_dump(b) + " cannot have their containment checked")
  else: _jq_contains_in(a, b)
end

def _jq_tonumber(v):
  let t = type(v)
  | if (t == "number"): v
    elif (t == "string"):
      if (is_regex_match(v, "^[-+]?([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][-+]?[0-9]+)?$")): to_number(v)
      else: error(_jq_dump(v) + " cannot be parsed as a number")
    else: error(_jq_dump(v) + " cannot be parsed as a number")
end

def _jq_fromjson(v):
  if (!is_string(v)): error(_jq_dump(v) + " cannot be parsed as JSON")
  elif (is_regex_match(v, "^\\s*-?[nN]a[nN]\\s*$")): nan()
  else: try: json::json_parse(v) catch(e): error(e["message"] + " (while parsing '" + v + "')")
end

def _jq_ascii_case(v, lo, hi, delta):
  if (!is_string(v)): error(_jq_dump(v) + " cannot be case-converted")
  else: implode(map(explode(v), fn(c): if (c >= lo && c <= hi): c + delta else: c;))
end

def _jq_implode(v):
  if (!is_array(v)): error("implode input must be an array")
  else: do
    let _ = foreach (c, v):
      if (!is_number(c)): error(_jq_dump(c) + " can't be imploded, unicode codepoint needs to be numeric")
    end
    | implode(map(v, fn(c): if (c > 1114111 || (c >= 55296 && c <= 57343) || c < 0): 65533 else: floor(c);))
  end
end

def _jq_explode(v):
  if (!is_string(v)): error(_jq_dump(v) + " cannot be exploded")
  else: explode(v)
end

def _jq_startswith(v, s):
  if (!is_string(v) || !is_string(s)): error("startswith() requires string inputs")
  else: starts_with(v, s)
end

def _jq_endswith(v, s):
  if (!is_string(v) || !is_string(s)): error("endswith() requires string inputs")
  else: ends_with(v, s)
end

def _jq_ltrimstr(v, s):
  if (_jq_startswith(v, s)): slice(v, len(s), len(v)) else: v
end

def _jq_rtrimstr(v, s):
  if (_jq_endswith(v, s)): slice(v, 0, len(v) - len(s)) else: v
end

def _jq_trimstr(v, s):
  _jq_rtrimstr(_jq_ltrimstr(v, s), s)
end

def _jq_trim(v, mode):
  if (!is_string(v)): error("trim input must be a string")
  else: do
    let cps = explode(v)
    | let ws = fn(c): _jq_re_is_space(c);
    | var i = 0
    | var j = len(cps)
    | let _ = if (mode != "r"): while (i < j && ws(cps[i])): i += 1 end
    | let _ = if (mode != "l"): while (j > i && ws(cps[j - 1])): j -= 1 end
    | implode(slice(cps, i, j))
  end
end

def _jq_split1(v, sep):
  if (!is_string(v) || !is_string(sep)): error("split input and separator must be strings")
  else: _jq_split_str(v, sep)
end

def _jq_join(v, sep):
  if (!is_array(v) && !is_dict(v)): error("Cannot iterate over " + (if (is_none(v)): "null" else: _jq_dump(v)))
  else: do
    let items = if (is_array(v)): v else: map(keys(v), fn(key): v[key];)
    | var acc = None
    | let _ = foreach (x, items):
        do
          let prefix = if (is_none(acc)): "" else: _jq_add(acc, sep)
          | let piece = if (is_bool(x) || is_number(x)): _jq_tostring(x) elif (is_none(x)): "" else: x
          | acc = _jq_add(prefix, piece)
        end
      end
    | if (_jq_truthy(acc)): acc else: ""
  end
end

def _jq_indices(v, x):
  let t = type(v)
  | let tx = type(x)
  | if (t == "None"): None
    elif (t == "string" && tx == "string"): do
      if (x == ""): None
      else: do
        let cps = explode(v)
        | let ncp = explode(x)
        | _jq_subarray_indices(cps, ncp)
      end
    end
    elif (t == "array" && tx == "array"): _jq_subarray_indices(v, x)
    elif (t == "array"): do
      var res = []
      | let _ = foreach (i, range(len(v) - 1)): if (v[i] == x): res += [i] end
      | res
    end
    else: _jq_index(v, x)
end

def _jq_flatten(v, depth):
  if (depth < 0): error("flatten depth must not be negative")
  else: do
    var out = []
    | let _ = foreach (x, v):
        if (is_array(x) && depth > 0): out = out + _jq_flatten(x, depth - 1)
        else: out += [x]
      end
    | out
  end
end

def _jq_add_all(items):
  if (is_empty(items)): None
  else: fold(slice(items, 1, len(items)), items[0], fn(a, b): _jq_add(a, b);)
end

def _jq_iter_values(v):
  let t = type(v)
  | if (t == "array"): v
    elif (t == "dict"): map(keys(v), fn(key): v[key];)
    else: error("Cannot iterate over " + (if (t == "None"): "null" else: _jq_dump(v)))
end

def _jq_minmax(v, want_max):
  if (!is_array(v)): error(_jq_dump(v) + " cannot be iterated over")
  elif (is_empty(v)): None
  else: fold(slice(v, 1, len(v)), v[0], fn(a, b):
    if (want_max): (if (_jq_cmp(b, a) >= 0): b else: a)
    else: (if (_jq_cmp(b, a) < 0): b else: a);)
end

def _jq_unique(v):
  if (!is_array(v)): error(_jq_dump(v) + " cannot be sorted, as it is not an array")
  else: do
    let sorted = _jq_sort(v)
    | var out = []
    | let _ = foreach (x, sorted):
        if (is_empty(out)): out += [x]
        elif (_jq_cmp(out[len(out) - 1], x) != 0): out += [x]
      end
    | out
  end
end

def _jq_keyed(c, v, env, arr):
  map(arr, fn(x): [_jq_collect(c, x, env), x];)
end

# group consecutive equal keys of sorted pairs -> array of arrays of values
def _jq_group_sorted(pairs):
  var groups = []
  | var cur = []
  | var cur_key = None
  | var started = false
  | let _ = foreach (pr, pairs):
      if (started && _jq_cmp(cur_key, pr[0]) == 0): cur += [pr[1]]
      else: do
        if (started): groups += [cur]
        | cur = [pr[1]]
        | cur_key = pr[0]
        | started = true
      end
    end
  | if (started): groups += [cur]
  | groups
end

def _jq_pad_range(n):
  if (n <= 0): [] else: range(n - 1)
end

def _jq_tojson_arr(v):
  _jq_tojson(v)
end

# ----- sort / group / unique / min / max by -----

def _jq_by_impl(name, c, v, env):
  if (!is_array(v)): error(_jq_dump(v) + " cannot be " + (if (name == "sort_by"): "sorted, as it is not an array" else: "grouped, as it is not an array"))
  else: do
    let pairs = _jq_keyed(c, v, env, v)
    | if (name == "sort_by"): map(_jq_sort_pairs(pairs), fn(pr): pr[1];)
      elif (name == "group_by"): _jq_group_sorted(_jq_sort_pairs(pairs))
      elif (name == "unique_by"): map(_jq_group_sorted(_jq_sort_pairs(pairs)), fn(g): g[0];)
      elif (is_empty(pairs)): None
      else: do
        let want_max = name == "max_by"
        | let best = fold(slice(pairs, 1, len(pairs)), pairs[0], fn(a, b):
            if (want_max): (if (_jq_cmp(b[0], a[0]) >= 0): b else: a)
            else: (if (_jq_cmp(b[0], a[0]) < 0): b else: a);)
        | best[1]
      end
  end
end

# ----- generators -----

def _jq_range(from_v, upto, by, k):
  if (!is_number(from_v) || !is_number(upto) || !is_number(by)): error("Range bounds must be numeric")
  else: do
    var x = from_v
    | if (by > 0): while (x < upto): do k(x) | x = x + by end end
      elif (by < 0): while (x > upto): do k(x) | x = x + by end end
  end
end

def _jq_until(cc, nc, x, env, k):
  var cur = x
  | var go = true
  | let _ = while (go):
      do
        let cs = _jq_collect(cc, cur, env)
        | if (len(cs) == 1):
            if (_jq_truthy(cs[0])): do k(cur) | go = false end
            else: do
              let ns = _jq_collect(nc, cur, env)
              | if (len(ns) == 1): cur = ns[0]
                else: do
                  let _ = foreach (n, ns): _jq_until(cc, nc, n, env, k) end
                  | go = false
                end
            end
          else: do
            let _ = foreach (c, cs):
              if (_jq_truthy(c)): k(cur)
              else: foreach (n, _jq_collect(nc, cur, env)): _jq_until(cc, nc, n, env, k) end
            end
            | go = false
          end
      end
    end
end

def _jq_while(cc, uc, x, env, k):
  var cur = x
  | var go = true
  | let _ = while (go):
      do
        let cs = _jq_collect(cc, cur, env)
        | if (len(cs) == 1):
            if (_jq_truthy(cs[0])): do
              k(cur)
              | let ns = _jq_collect(uc, cur, env)
              | if (len(ns) == 1): cur = ns[0]
                else: do
                  let _ = foreach (n, ns): _jq_while(cc, uc, n, env, k) end
                  | go = false
                end
            end
            else: go = false
          else: do
            let _ = foreach (c, cs):
              if (_jq_truthy(c)): do
                k(cur)
                | foreach (n, _jq_collect(uc, cur, env)): _jq_while(cc, uc, n, env, k) end
              end
            end
            | go = false
          end
      end
    end
end

def _jq_repeat(fc, x, env, k):
  while (true): fc(x, env, k) end
end

def _jq_recurse_f(fc, x, env, k):
  var cur = x
  | var go = true
  | let _ = while (go):
      do
        k(cur)
        | let ns = _jq_collect(fc, cur, env)
        | if (len(ns) == 1): cur = ns[0]
          else: do
            let _ = foreach (n, ns): _jq_recurse_f(fc, n, env, k) end
            | go = false
          end
      end
    end
end

def _jq_recurse_fc(fc, cc, x, env, k):
  var cur = x
  | var go = true
  | let _ = while (go):
      do
        k(cur)
        | let ns = filter(_jq_collect(fc, cur, env), fn(n): fold(_jq_collect(cc, n, env), false, fn(a, c): a || _jq_truthy(c););)
        | if (len(ns) == 1): cur = ns[0]
          else: do
            let _ = foreach (n, ns): _jq_recurse_fc(fc, cc, n, env, k) end
            | go = false
          end
      end
    end
end

# path-mode recursion
def _jq_recurse_f_p(fp, p, x, env, k):
  do
    k(p, x)
    | let outs = _jq_collect_p(fp, p, x, env)
    | foreach (o, outs): _jq_recurse_f_p(fp, o[0], o[1], env, k) end
  end
end

def _jq_collect_p(cp, p, v, env):
  var out = []
  | let _ = cp(p, v, env, fn(p2, x): out += [[p2, x]];)
  | out
end

def _jq_first_out_p(cp, p, v, env):
  var res = None
  | var rp = None
  | var got = false
  | let id = "\u0002" + _jq_uid()
  | let _ = (try:
      cp(p, v, env, fn(p2, x): do res = x | rp = p2 | got = true | error(id) end;)
    catch(e):
      if (e["value"] != id): error(e["value"]))
  | [got, rp, res]
end

def _jq_math1(name):
  if (name == "floor"): fn(x): floor(x);
  elif (name == "ceil"): fn(x): ceil(x);
  elif (name == "round"): fn(x): round(x);
  elif (name == "sqrt"): fn(x): sqrt(x);
  elif (name == "fabs"): fn(x): if (x < 0): 0 - x else: x;
  elif (name == "trunc"): fn(x): _jq_trunc(x);
  elif (name == "sin"): fn(x): sin(x);
  elif (name == "cos"): fn(x): cos(x);
  elif (name == "tan"): fn(x): tan(x);
  elif (name == "asin"): fn(x): asin(x);
  elif (name == "acos"): fn(x): acos(x);
  elif (name == "atan"): fn(x): atan(x);
  elif (name == "sinh"): fn(x): sinh(x);
  elif (name == "cosh"): fn(x): cosh(x);
  elif (name == "tanh"): fn(x): tanh(x);
  elif (name == "exp"): fn(x): exp(x);
  elif (name == "exp2"): fn(x): pow(2, x);
  elif (name == "exp10"): fn(x): pow(10, x);
  elif (name == "log"): fn(x): ln(x);
  elif (name == "log2"): fn(x): log2(x);
  elif (name == "log10"): fn(x): log10(x);
  elif (name == "cbrt"): fn(x): cbrt(x);
  elif (name == "expm1"): fn(x): exp(x) - 1;
  elif (name == "log1p"): fn(x): ln(1 + x);
  elif (name == "nearbyint" || name == "rint"): fn(x): _jq_round_even(x);
  elif (name == "significand"): fn(x): if (x == 0 || x != x || x == infinite() || x == -infinite()): x else: x / pow(2, _jq_logb(x));
  elif (name == "logb"): fn(x): if (x == 0): -infinite() elif (x == infinite() || x == -infinite()): infinite() else: _jq_logb(x);
  elif (name == "frexp"): fn(x): _jq_frexp(x);
  elif (name == "modf"): fn(x): [x - _jq_trunc(x), _jq_trunc(x)];
  elif (name == "pow10"): fn(x): pow(10, x);
  else: None
end

def _jq_logb(x):
  let a = if (x < 0): 0 - x else: x
  | let g = floor(log2(a))
  | if (pow(2, g) > a): g - 1 elif (pow(2, g + 1) <= a): g + 1 else: g
end

def _jq_frexp(x):
  if (x == 0 || x != x || x == infinite() || x == -infinite()): [x, 0]
  else: do
    let e = _jq_logb(x) + 1
    | [x / pow(2, e), e]
  end
end

def _jq_round_even(x):
  let f = floor(x)
  | let d = x - f
  | if (d < 0.5): f
    elif (d > 0.5): f + 1
    elif (f % 2 == 0): f
    else: f + 1
end

def _jq_isnormal(x):
  is_number(x) && x == x && x != 0 && x != infinite() && x != -infinite() && (if (x < 0): 0 - x else: x) >= 2.2250738585072014e-308
end

def _jq_isinfinite(x):
  if (!is_number(x)): error(_jq_dump(x) + " number required")
  else: x == infinite() || x == -infinite()
end

def _jq_check_num(x):
  if (!is_number(x)): error(_jq_dump(x) + " number required") else: x
end

def _jq_bsearch(v, x):
  if (!is_array(v)): error(_jq_dump(v) + " cannot be searched from")
  else: do
    var lo = 0
    | var hi = len(v) - 1
    | var res = None
    | let _ = while (is_none(res) && lo <= hi):
        do
          let mid = floor((lo + hi) / 2)
          | let c = _jq_cmp(v[mid], x)
          | if (c == 0): res = mid
            elif (c < 0): lo = mid + 1
            else: hi = mid - 1
        end
      end
    | if (is_none(res)): -1 - lo else: res
  end
end

def _jq_builtin_names():
  ["abs/0", "add/0", "add/1", "all/0", "all/1", "all/2", "any/0", "any/1", "any/2", "arrays/0", "ascii/0",
   "ascii_downcase/0", "ascii_upcase/0", "booleans/0", "bsearch/1", "capture/1", "capture/2", "combinations/0",
   "combinations/1", "contains/1", "debug/0", "debug/1", "del/1", "delpaths/1", "empty/0", "endswith/1",
   "env/0", "error/0", "error/1", "explode/0", "first/0", "first/1", "flatten/0", "flatten/1", "floor/0",
   "from_entries/0", "fromjson/0", "getpath/1", "group_by/1", "gsub/2", "gsub/3", "has/1", "implode/0",
   "in/1", "index/1", "indices/1", "infinite/0", "inside/1", "isempty/1", "isinfinite/0", "isnan/0",
   "isnormal/0", "iterables/0", "join/1", "keys/0", "keys_unsorted/0", "last/0", "last/1", "length/0",
   "limit/2", "map/1", "map_values/1", "match/1", "match/2", "max/0", "max_by/1", "min/0", "min_by/1",
   "nan/0", "not/0", "nth/1", "nth/2", "nulls/0", "numbers/0", "objects/0", "path/1", "paths/0",
   "paths/1", "pick/1", "range/1", "range/2", "range/3", "recurse/0", "recurse/1", "recurse/2",
   "repeat/1", "reverse/0", "rindex/1", "scalars/0", "scan/1", "scan/2", "select/1", "setpath/2",
   "skip/2", "sort/0", "sort_by/1", "split/1", "split/2", "splits/1", "splits/2", "startswith/1",
   "strings/0", "sub/2", "sub/3", "test/1", "test/2", "to_entries/0", "toarray/0", "tojson/0",
   "tonumber/0", "tostring/0", "transpose/0", "type/0", "unique/0", "unique_by/1", "until/2",
   "utf8bytelength/0", "values/0", "walk/1", "while/2", "with_entries/1"]
end

# ----- the builtin table (value mode) -----

def _jq_builtin(name, args, argcs):
  let n = len(args)
  | let key = name + "/" + to_string(n)
  | let m1 = if (n == 0): _jq_math1(name) else: None
  | if (!is_none(m1)): fn(v, env, k): k(m1(_jq_check_num(v)));
    elif (key == "empty/0"): fn(v, env, k): None;
    elif (key == "not/0"): fn(v, env, k): k(!_jq_truthy(v));
    elif (key == "error/0"): fn(v, env, k): error(v);
    elif (key == "error/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): c1(v, env, fn(a): error(a););
    end
    elif (key == "type/0"): _jq_n0(fn(v): _jq_tn(v);)
    elif (key == "length/0"): _jq_n0(fn(v): _jq_length(v);)
    elif (key == "utf8bytelength/0"): _jq_n0(fn(v):
      if (!is_string(v)): error(_jq_dump(v) + " only strings have UTF-8 byte length") else: _jq_utf8_len(v);)
    elif (key == "keys/0"): _jq_n0(fn(v): _jq_keys(v);)
    elif (key == "keys_unsorted/0"): _jq_n0(fn(v): _jq_keys_unsorted(v);)
    elif (key == "has/1"): _jq_n1(fn(v, a): _jq_has(v, a);, argcs[0])
    elif (key == "contains/1"): _jq_n1(fn(v, a): _jq_contains(v, a);, argcs[0])
    elif (key == "tostring/0"): _jq_n0(fn(v): _jq_tostring(v);)
    elif (key == "tonumber/0"): _jq_n0(fn(v): _jq_tonumber(v);)
    elif (key == "tojson/0"): _jq_n0(fn(v): _jq_tojson(v);)
    elif (key == "fromjson/0"): _jq_n0(fn(v): _jq_fromjson(v);)
    elif (key == "ascii_downcase/0"): _jq_n0(fn(v): _jq_ascii_case(v, 65, 90, 32);)
    elif (key == "ascii_upcase/0"): _jq_n0(fn(v): _jq_ascii_case(v, 97, 122, -32);)
    elif (key == "explode/0"): _jq_n0(fn(v): _jq_explode(v);)
    elif (key == "implode/0"): _jq_n0(fn(v): _jq_implode(v);)
    elif (key == "startswith/1"): _jq_n1(fn(v, a): _jq_startswith(v, a);, argcs[0])
    elif (key == "endswith/1"): _jq_n1(fn(v, a): _jq_endswith(v, a);, argcs[0])
    elif (key == "ltrimstr/1"): _jq_n1(fn(v, a): _jq_ltrimstr(v, a);, argcs[0])
    elif (key == "rtrimstr/1"): _jq_n1(fn(v, a): _jq_rtrimstr(v, a);, argcs[0])
    elif (key == "trimstr/1"): _jq_n1(fn(v, a): _jq_trimstr(v, a);, argcs[0])
    elif (key == "trim/0"): _jq_n0(fn(v): _jq_trim(v, "b");)
    elif (key == "ltrim/0"): _jq_n0(fn(v): _jq_trim(v, "l");)
    elif (key == "rtrim/0"): _jq_n0(fn(v): _jq_trim(v, "r");)
    elif (key == "split/1"): _jq_n1(fn(v, a): _jq_split1(v, a);, argcs[0])
    elif (key == "join/1"): _jq_n1(fn(v, a): _jq_join(v, a);, argcs[0])
    elif (key == "indices/1" || key == "_strindices/1"): _jq_n1(fn(v, a): _jq_indices(v, a);, argcs[0])
    elif (key == "index/1"): _jq_n1(fn(v, a): do let r = _jq_indices(v, a) | if (is_none(r) || is_empty(r)): None else: r[0] end;, argcs[0])
    elif (key == "rindex/1"): _jq_n1(fn(v, a): do let r = _jq_indices(v, a) | if (is_none(r) || is_empty(r)): None else: r[len(r) - 1] end;, argcs[0])
    elif (key == "flatten/0"): _jq_n0(fn(v): _jq_flatten(_jq_iter_values(v), 1000000000);)
    elif (key == "flatten/1"): _jq_n1(fn(v, d): _jq_flatten(_jq_iter_values(v), d);, argcs[0])
    elif (key == "add/0"): _jq_n0(fn(v): _jq_add_all(_jq_iter_values(v));)
    elif (key == "add/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): k(_jq_add_all(_jq_collect(c1, v, env)));
    end
    elif (key == "sort/0"): _jq_n0(fn(v): if (!is_array(v)): error(_jq_dump(v) + " cannot be sorted, as it is not an array") else: _jq_sort(v);)
    elif (key == "reverse/0"): _jq_n0(fn(v):
      if (is_array(v)): reverse(v)
      else: do
        let n = _jq_length(v)
        | if (n == 0): [] else: error("Cannot index " + _jq_tn(v) + " with number (" + _jq_numstr(n - 1) + ")")
      end;)
    elif (key == "unique/0"): _jq_n0(fn(v): _jq_unique(v);)
    elif (key == "min/0"): _jq_n0(fn(v): _jq_minmax(v, false);)
    elif (key == "max/0"): _jq_n0(fn(v): _jq_minmax(v, true);)
    elif (key == "sort_by/1" || key == "group_by/1" || key == "unique_by/1" || key == "min_by/1" || key == "max_by/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): k(_jq_by_impl(name, c1, v, env));
    end
    elif (key == "map/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): k(_jq_collect(fn(v2, env2, k2): _jq_iter(v2, fn(x): c1(x, env2, k2);); , v, env));
    end
    elif (key == "select/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): c1(v, env, fn(c): if (_jq_truthy(c)): k(v););
    end
    elif (key == "range/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): c1(v, env, fn(a): _jq_range(0, a, 1, k););
    end
    elif (key == "range/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): c1(v, env, fn(a): c2(v, env, fn(b): _jq_range(a, b, 1, k);););
    end
    elif (key == "range/3"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | let c3 = argcs[2]
      | fn(v, env, k): c1(v, env, fn(a): c2(v, env, fn(b): c3(v, env, fn(by): _jq_range(a, b, by, k););););
    end
    elif (key == "first/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): do let r = _jq_first_out(c1, v, env) | if (r[0]): k(r[1]) end;
    end
    elif (key == "last/1"): do
      let c1 = argcs[0]
      | fn(v, env, k):
          do
            var res = None
            | var got = false
            | let _ = c1(v, env, fn(x): do res = x | got = true end;)
            | if (got): k(res)
          end;
    end
    elif (key == "isempty/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): do let r = _jq_first_out(c1, v, env) | k(!r[0]) end;
    end
    elif (key == "limit/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): c1(v, env, fn(n):
          if (n > 0): do
            var cnt = 0
            | let id = "\u0002" + _jq_uid()
            | _jq_try_run(
                fn(k2): c2(v, env, fn(x): do cnt += 1 | k2(x) | if (cnt >= n): error(id) end;);,
                k,
                fn(msg): if (msg != id): error(msg))
          end
          elif (n < 0): error("limit doesn't support negative count")
        ;);
    end
    elif (key == "skip/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): c1(v, env, fn(n):
          if (n < 0): error("skip doesn't support negative count")
          else: do
            var cnt = 0
            | c2(v, env, fn(x): do cnt += 1 | if (cnt > n): k(x) end;)
          end
        ;);
    end
    elif (key == "nth/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): c1(v, env, fn(n):
          if (n < 0): error("nth doesn't support negative indices")
          else: do
            var cnt = 0
            | let id = "\u0002" + _jq_uid()
            | var res = None
            | var got = false
            | let _ = (try:
                c2(v, env, fn(x): do
                  if (cnt >= n): do res = x | got = true | error(id) end
                  | cnt += 1
                end;)
              catch(e): if (e["value"] != id): error(e["value"]))
            | if (got): k(res)
          end
        ;);
    end
    elif (key == "until/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): _jq_until(c1, c2, v, env, k);
    end
    elif (key == "while/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): _jq_while(c1, c2, v, env, k);
    end
    elif (key == "repeat/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): _jq_repeat(c1, v, env, k);
    end
    elif (key == "recurse/0"): fn(v, env, k): _jq_recurse_all(v, k);
    elif (key == "recurse/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): _jq_recurse_f(c1, v, env, k);
    end
    elif (key == "recurse/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): _jq_recurse_fc(c1, c2, v, env, k);
    end
    elif (key == "any/0"): fn(v, env, k): k(fold(_jq_iter_values(v), false, fn(a, x): a || _jq_truthy(x);));
    elif (key == "all/0"): fn(v, env, k): k(fold(_jq_iter_values(v), true, fn(a, x): a && _jq_truthy(x);));
    elif (key == "any/1" || key == "all/1" || key == "any/2" || key == "all/2"): do
      let is_any = name == "any"
      | let gen = if (n == 2): argcs[0] else: fn(v, env, k): _jq_iter(v, k);
      | let cond = if (n == 2): argcs[1] else: argcs[0]
      | fn(v, env, k):
          do
            let r = _jq_first_out(fn(v2, env2, k2):
              gen(v2, env2, fn(x): cond(x, env2, fn(c):
                if (is_any): (if (_jq_truthy(c)): k2(true)) else: (if (!_jq_truthy(c)): k2(true));
              ););
            , v, env)
            | k(if (is_any): r[0] else: !r[0])
          end;
    end
    elif (key == "path/1"): do
      let fp = _jq_cp(args[0])
      | fn(v, env, k): fp([], v, env, fn(p, x): k(_jq_path_check(p, x)););
    end
    elif (key == "getpath/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): c1(v, env, fn(p): k(_jq_getpath(v, p)););
    end
    elif (key == "setpath/2"): _jq_n2(fn(v, p, x): if (!is_array(p)): error("Path must be specified as an array") else: _jq_setpath(v, p, x);, argcs[0], argcs[1])
    elif (key == "delpaths/1"): _jq_n1(fn(v, ps): _jq_delpaths(v, ps);, argcs[0])
    elif (key == "tojson/0"): _jq_n0(fn(v): _jq_tojson(v);)
    elif (key == "format/1"): _jq_n1(fn(v, f): _jq_format(f, v);, argcs[0])
    elif (key == "env/0"): fn(v, env, k): k(_jq_env_dict());
    elif (key == "input/0"): fn(v, env, k): error("No more inputs");
    elif (key == "inputs/0"): fn(v, env, k): None;
    elif (key == "debug/0"): fn(v, env, k): k(v);
    elif (key == "stderr/0"): fn(v, env, k): k(v);
    elif (key == "input_line_number/0"): fn(v, env, k): k(0);
    elif (key == "input_filename/0"): fn(v, env, k): k(None);
    elif (key == "halt/0"): fn(v, env, k): halt();
    elif (key == "now/0"): fn(v, env, k): k(now());
    elif (key == "infinite/0"): fn(v, env, k): k(infinite());
    elif (key == "nan/0"): fn(v, env, k): k(nan());
    elif (key == "isinfinite/0"): _jq_n0(fn(v): _jq_isinfinite(v);)
    elif (key == "isnan/0"): _jq_n0(fn(v): if (!is_number(v)): error(_jq_dump(v) + " number required") else: v != v;)
    elif (key == "isnormal/0"): _jq_n0(fn(v): if (!is_number(v)): error(_jq_dump(v) + " number required") else: _jq_isnormal(v);)
    elif (key == "ldexp/2" || key == "scalb/2" || key == "scalbln/2"): _jq_n2(fn(v, a, b): _jq_check_num(a) * pow(2, _jq_check_num(b));, argcs[0], argcs[1])
    elif (key == "drem/2"): _jq_n2(fn(v, a, b): a - b * _jq_round_even(a / b);, argcs[0], argcs[1])
    elif (key == "fmod/2"): _jq_n2(fn(v, a, b): a - b * _jq_trunc(a / b);, argcs[0], argcs[1])
    elif (key == "copysign/2"): _jq_n2(fn(v, a, b): if ((b < 0) != (a < 0)): 0 - a else: a;, argcs[0], argcs[1])
    elif (key == "fma/3"): _jq_n3(fn(v, a, b, c): a * b + c;, argcs[0], argcs[1], argcs[2])
    elif (key == "hypot/2"): _jq_n2(fn(v, a, b): sqrt(a * a + b * b);, argcs[0], argcs[1])
    elif (key == "pow/2"): _jq_n2(fn(v, a, b): pow(_jq_check_num(a), _jq_check_num(b));, argcs[0], argcs[1])
    elif (key == "atan2/2"): _jq_n2(fn(v, a, b): atan2(_jq_check_num(a), _jq_check_num(b));, argcs[0], argcs[1])
    elif (key == "fmin/2"): _jq_n2(fn(v, a, b): if (a < b): a else: b;, argcs[0], argcs[1])
    elif (key == "fmax/2"): _jq_n2(fn(v, a, b): if (a > b): a else: b;, argcs[0], argcs[1])
    elif (key == "toarray/0"): _jq_n0(fn(v): if (is_array(v)): v else: [v];)
    elif (key == "tostream/0"): None
    elif (key == "gmtime/0" || key == "localtime/0"): _jq_n0(fn(v): _jq_gmtime(v);)
    elif (key == "mktime/0"): _jq_n0(fn(v): _jq_mktime(v);)
    elif (key == "strftime/1"): _jq_n1(fn(v, f): _jq_do_strftime(v, f, "strftime/1");, argcs[0])
    elif (key == "strflocaltime/1"): _jq_n1(fn(v, f): _jq_do_strftime(v, f, "strflocaltime/1");, argcs[0])
    elif (key == "strptime/1"): _jq_n1(fn(v, f): _jq_do_strptime(v, f);, argcs[0])
    elif (key == "abs/0"): _jq_n0(fn(v): if (_jq_cmp(v, 0) < 0): (if (is_number(v)): 0 - v else: error(_jq_dump(v) + " cannot be negated")) else: v;)
    elif (key == "toboolean/0"): _jq_n0(fn(v):
      if (is_bool(v)): v
      elif (is_string(v) && v == "true"): true
      elif (is_string(v) && v == "false"): false
      else: error(_jq_dump(v) + " cannot be parsed as a boolean");)
    elif (key == "have_decnum/0"): fn(v, env, k): k(false);
    elif (key == "have_literal_numbers/0"): fn(v, env, k): k(true);
    elif (key == "builtins/0"): fn(v, env, k): k(_jq_builtin_names());
    elif (key == "bsearch/1"): _jq_n1(fn(v, x): _jq_bsearch(v, x);, argcs[0])
    elif (key == "test/1"): _jq_n1(fn(v, re): !is_empty(_jq_re_match(v, re, None, true));, argcs[0])
    elif (key == "test/2"): _jq_n2(fn(v, re, fl): !is_empty(_jq_re_match(v, re, fl, true));, argcs[0], argcs[1])
    elif (key == "match/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): c1(v, env, fn(re): foreach (m, _jq_re_match(v, re, None, false)): k(m) end;);
    end
    elif (key == "match/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): c2(v, env, fn(fl): c1(v, env, fn(re): foreach (m, _jq_re_match(v, re, fl, false)): k(m) end;););
    end
    elif (key == "capture/1"): do
      let c1 = argcs[0]
      | fn(v, env, k): c1(v, env, fn(re): foreach (m, _jq_re_match(v, re, None, false)): k(_jq_re_capture_obj(m)) end;);
    end
    elif (key == "capture/2"): do
      let c1 = argcs[0]
      | let c2 = argcs[1]
      | fn(v, env, k): c2(v, env, fn(fl): c1(v, env, fn(re): foreach (m, _jq_re_match(v, re, fl, false)): k(_jq_re_capture_obj(m)) end;););
    end
    elif (key == "scan/1" || key == "scan/2"): do
      let c1 = argcs[0]
      | let c2 = if (n == 2): argcs[1] else: fn(v, env, k): k(None);
      | fn(v, env, k): c2(v, env, fn(fl): c1(v, env, fn(re):
          foreach (m, _jq_re_match(v, re, "g" + (if (is_none(fl)): "" else: fl), false)):
            k(if (is_empty(m["captures"])): m["string"] else: map(m["captures"], fn(c): c["string"];))
          end
        ;););
    end
    elif (key == "splits/1" || key == "splits/2" || key == "split/2"): do
      let c1 = argcs[0]
      | let c2 = if (n == 2): argcs[1] else: fn(v, env, k): k(None);
      | let collect = name == "split"
      | fn(v, env, k): c2(v, env, fn(fl): c1(v, env, fn(re):
          do
            let ms = _jq_re_match(v, re, "g" + (if (is_none(fl)): "" else: fl), false)
            | let cps = explode(v)
            | var prev = 0
            | var pieces = []
            | let _ = foreach (m, ms): do pieces += [implode(slice(cps, prev, m["offset"]))] | prev = m["offset"] + m["length"] end end
            | pieces += [implode(slice(cps, prev, len(cps)))]
            | if (collect): k(pieces) else: foreach (pc, pieces): k(pc) end
          end
        ;););
    end
    elif (key == "sub/2" || key == "sub/3" || key == "gsub/2" || key == "gsub/3"): do
      let c1 = argcs[0]
      | let sc = argcs[1]
      | let c3 = if (n == 3): argcs[2] else: fn(v, env, k): k(None);
      | let global = name == "gsub"
      | fn(v, env, k): c3(v, env, fn(fl): c1(v, env, fn(re): _jq_re_sub(v, re, fl, global, sc, env, k);););
    end
    else: None
end

# Path-mode natives (return None when the builtin is not path-capable).
def _jq_builtin_p(name, args, argcs):
  let n = len(args)
  | let key = name + "/" + to_string(n)
  | if (key == "empty/0"): fn(p, v, env, k): None;
    elif (key == "error/0"): fn(p, v, env, k): error(v);
    elif (key == "error/1"): do
      let c1 = argcs[0]
      | fn(p, v, env, k): c1(v, env, fn(a): error(a););
    end
    elif (key == "select/1"): do
      let c1 = argcs[0]
      | fn(p, v, env, k): c1(v, env, fn(c): if (_jq_truthy(c)): k(p, v););
    end
    elif (key == "recurse/0"): fn(p, v, env, k): _jq_recurse_all_p(_jq_path_check(p, v), v, k);
    elif (key == "recurse/1"): do
      let fp = _jq_cp(args[0])
      | fn(p, v, env, k): _jq_recurse_f_p(fp, _jq_path_check(p, v), v, env, k);
    end
    elif (key == "getpath/1"): do
      let c1 = argcs[0]
      | fn(p, v, env, k): c1(v, env, fn(path):
          if (!is_array(path)): error("Path must be specified as an array")
          else: k(_jq_path_check(p, v) + path, try: _jq_getpath(v, path) catch: None)
        ;);
    end
    elif (key == "first/1"): do
      let fp = _jq_cp(args[0])
      | fn(p, v, env, k): do let r = _jq_first_out_p(fp, p, v, env) | if (r[0]): k(r[1], r[2]) end;
    end
    elif (key == "last/1"): do
      let fp = _jq_cp(args[0])
      | fn(p, v, env, k):
          do
            var rp = None
            | var res = None
            | var got = false
            | let _ = fp(p, v, env, fn(p2, x): do rp = p2 | res = x | got = true end;)
            | if (got): k(rp, res)
          end;
    end
    elif (key == "limit/2"): do
      let c1 = argcs[0]
      | let fp = _jq_cp(args[1])
      | fn(p, v, env, k): c1(v, env, fn(nn):
          if (nn > 0): do
            var cnt = 0
            | let id = "\u0002" + _jq_uid()
            | _jq_try_run(
                fn(k2): fp(p, v, env, fn(p2, x): do cnt += 1 | k2([p2, x]) | if (cnt >= nn): error(id) end;);,
                fn(pr): k(pr[0], pr[1]);,
                fn(msg): if (msg != id): error(msg))
          end
        ;);
    end
    else: None
end

# ===== Prelude: builtins defined in jq itself =====
#
# Adapted from jq's own src/builtin.jq. Only the definitions a program (transitively)
# references are parsed and compiled.

def _jq_prelude_src():
  {
    "values/0": "def values: select(. != null);",
    "nulls/0": "def nulls: select(. == null);",
    "booleans/0": "def booleans: select(type == \"boolean\");",
    "numbers/0": "def numbers: select(type == \"number\");",
    "strings/0": "def strings: select(type == \"string\");",
    "arrays/0": "def arrays: select(type == \"array\");",
    "objects/0": "def objects: select(type == \"object\");",
    "iterables/0": "def iterables: select(type|. == \"array\" or . == \"object\");",
    "scalars/0": "def scalars: select(type|. != \"array\" and . != \"object\");",
    "isfinite/0": "def isfinite: type == \"number\" and (isinfinite | not);",
    "finites/0": "def finites: select(isfinite);",
    "normals/0": "def normals: select(isnormal);",
    "map_values/1": "def map_values(f): .[] |= f;",
    "to_entries/0": "def to_entries: [keys_unsorted[] as $k | {key: $k, value: .[$k]}];",
    "from_entries/0": "def from_entries: map({ (.key // .Key // .name // .Name): if has(\"value\") then .value else .Value end }) | add // {};",
    "with_entries/1": "def with_entries(f): to_entries | map(f) | from_entries;",
    "paths/0": "def paths: path(..)|select(length > 0);",
    "paths/1": "def paths(node_filter): . as $dot|paths|select(. as $p|$dot|getpath($p) | node_filter);",
    "leaf_paths/0": "def leaf_paths: paths(scalars);",
    "del/1": "def del(f): delpaths([path(f)]);",
    "walk/1": "def walk(f): def w: if type == \"object\" then map_values(w) elif type == \"array\" then map(w) else . end | f; w;",
    "in/1": "def in(xs): . as $x | xs | has($x);",
    "inside/1": "def inside(xs): . as $x | xs | contains($x);",
    "combinations/0": "def combinations: if length == 0 then [] else .[0][] as $x | (.[1:] | combinations) as $y | [$x] + $y end;",
    "combinations/1": "def combinations(n): . as $dot | [range(n) | $dot] | combinations;",
    "first/0": "def first: .[0];",
    "last/0": "def last: .[-1];",
    "nth/1": "def nth($n): .[$n];",
    "transpose/0": "def transpose: [range(0; map(length)|max // 0) as $i | [.[][$i]]];",
    "tostream/0": "def tostream: path(def r: (.[]?|r), .; r) as $p | getpath($p) | reduce path(.[]?) as $q ([$p, .]; [$p+$q]);",
    "fromstream/1": "def fromstream(i): {x: null, e: false} as $init | foreach i as $i ($init; if .e then $init else . end | if $i|length == 2 then setpath([\"e\"]; $i[0]|length==0) | setpath([\"x\"]+$i[0]; $i[1]) else setpath([\"e\"]; $i[0]|length==1) end; if .e then .x else empty end);",
    "truncate_stream/1": "def truncate_stream(stream): . as $n | null | stream | . as $input | if (.[0]|length) > $n then setpath([0];$input[0][$n:]) else empty end;",
    "pick/1": "def pick(pathexps): . as $in | reduce path(pathexps) as $a (null; setpath($a; $in|getpath($a)));",
    "debug/1": "def debug(msgs): (msgs | debug | empty), .;",
    "INDEX/2": "def INDEX(stream; idx_expr): reduce stream as $row ({}; .[$row|idx_expr|tostring] = $row);",
    "INDEX/1": "def INDEX(idx_expr): INDEX(.[]; idx_expr);",
    "JOIN/2": "def JOIN($idx; idx_expr): [.[] | [., $idx[idx_expr]]];",
    "JOIN/3": "def JOIN($idx; stream; idx_expr): stream | [., $idx[idx_expr]];",
    "JOIN/4": "def JOIN($idx; stream; idx_expr; join_expr): stream | [., $idx[idx_expr]] | join_expr;",
    "IN/1": "def IN(s): any(s == .; .);",
    "IN/2": "def IN(src; s): any(src == s; .);",
    "ascii/0": "def ascii: if type == \"number\" and . >= 0 and . <= 127 then [.] | implode else error(\"ascii only takes integers between 0 and 127\") end;",
    "todate/0": "def todate: strftime(\"%Y-%m-%dT%H:%M:%SZ\");",
    "fromdate/0": "def fromdate: fromdateiso8601;",
    "fromdateiso8601/0": "def fromdateiso8601: strptime(\"%Y-%m-%dT%H:%M:%SZ\")|mktime;",
    "todateiso8601/0": "def todateiso8601: strftime(\"%Y-%m-%dT%H:%M:%SZ\");",
    "dateadd/2": "def dateadd(u; n): .+n;",
    "datesub/2": "def datesub(u; n): .-n;",
    "date/0": "def date: todate;"
  }
end

# Collects "name/arity" keys of every call in an AST.
def _jq_calls(ast):
  let t = type(ast)
  | if (t == "dict"): do
      var acc = if (ast["type"] == "call"): {} else: {}
      | let own = if (ast["type"] == "call"): [ast["name"] + "/" + to_string(len(ast["args"]))] else: []
      | let _ = foreach (key, keys(ast)):
          do
            let child = ast[key]
            | let ct = type(child)
            | if (ct == "dict" || ct == "array"): acc = _jq_merge_keys(acc, _jq_calls(child))
          end
        end
      | _jq_merge_keys(acc, fold(own, {}, fn(a, x): set(a, x, true);))
    end
    elif (t == "array"):
      fold(ast, {}, fn(acc, x):
        let xt = type(x)
        | if (xt == "dict" || xt == "array"): _jq_merge_keys(acc, _jq_calls(x)) else: acc;)
    else: {}
end

def _jq_merge_keys(a, b):
  fold(keys(b), a, fn(acc, key): set(acc, key, true);)
end

def _jq_pre_visit(want, st, src):
  fold(want, st, fn(s, key):
    if (!is_none(s["seen"][key])): s
    elif (is_none(src[key])): s
    else: do
      let d = _jq_parse(src[key])
      | let s1 = set(s, "seen", set(s["seen"], key, true))
      | let s2 = _jq_pre_visit(keys(_jq_calls(d["body"])), s1, src)
      | set(s2, "order", s2["order"] + [d])
    end
  ;)
end

def _jq_with_prelude(ast):
  let src = _jq_prelude_src()
  | let want = keys(_jq_calls(ast))
  | let st = _jq_pre_visit(want, {seen: {}, order: []}, src)
  | fold(reverse(st["order"]), ast, fn(acc, d): set(d, "next", acc);)
end

# ===== Public API =====

def _jq_top_error(v):
  if (_jq_is_passing(v)): _jq_top_error(v["\u0003"])
  elif (_jq_is_break(v)): error("jq: error: break")
  elif (is_string(v)): error(v)
  else: error("jq: error (not a string): " + _jq_tojson(v))
end

def jq_compile(program):
  let ast = _jq_with_prelude(_jq_parse(program))
  | {c: _jq_c(ast), ast: ast}
end

def jq_eval(compiled, input):
  try: _jq_collect(compiled["c"], input, dict())
  catch(e): _jq_top_error(e["value"])
end

def jq_run(program, input):
  jq_eval(jq_compile(program), input)
end

def jq_run_first(program, input):
  let results = jq_run(program, input)
  | if (is_empty(results)): None else: results[0]
end

# ===== Regular expressions =====
#
# A small backtracking engine (Oniguruma/Perl flavoured) so that match offsets,
# captures, empty matches and named groups behave like jq. Patterns are parsed
# into a node tree and compiled to matcher closures:
#   matcher(s, i, caps, k) -> bool     s: array of code points, caps: array of
#   group start/end positions (-1 when unset), k(i, caps) -> bool continuation.

def _jq_re_fold(c):
  if (c >= 65 && c <= 90): c + 32
  elif (c < 128): c
  else: do
    let r = explode(downcase(implode([c])))
    | if (is_empty(r)): c else: r[0]
  end
end

def _jq_re_is_word(c):
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || (c > 127 && is_alnum(implode([c])))
end

def _jq_re_is_space(c):
  c == 32 || (c >= 9 && c <= 13) || c == 133 || c == 160 || c == 5760 || (c >= 8192 && c <= 8202) || c == 8232 || c == 8233 || c == 8239 || c == 8287 || c == 12288
end

def _jq_re_is_digit(c):
  (c >= 48 && c <= 57) || (c > 127 && is_digit(implode([c])))
end

def _jq_re_is_alpha(c):
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c > 127 && is_alpha(implode([c])))
end

def _jq_re_is_upper(c):
  (c >= 65 && c <= 90) || (c > 127 && is_upper(implode([c])))
end

def _jq_re_is_lower(c):
  (c >= 97 && c <= 122) || (c > 127 && is_lower(implode([c])))
end

def _jq_re_is_punct(c):
  (c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126)
end

# Character class predicate by name (neg handled by caller).
def _jq_re_class(name):
  if (name == "d" || name == "digit" || name == "Nd" || name == "N"): fn(c): _jq_re_is_digit(c);
  elif (name == "w" || name == "word"): fn(c): _jq_re_is_word(c);
  elif (name == "s" || name == "space" || name == "Z" || name == "Zs"): fn(c): _jq_re_is_space(c);
  elif (name == "h" || name == "xdigit"): fn(c): (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
  elif (name == "alpha" || name == "L" || name == "Alphabetic"): fn(c): _jq_re_is_alpha(c);
  elif (name == "alnum"): fn(c): _jq_re_is_alpha(c) || _jq_re_is_digit(c);
  elif (name == "upper" || name == "Lu"): fn(c): _jq_re_is_upper(c);
  elif (name == "lower" || name == "Ll"): fn(c): _jq_re_is_lower(c);
  elif (name == "punct" || name == "P"): fn(c): _jq_re_is_punct(c);
  elif (name == "blank"): fn(c): c == 32 || c == 9;
  elif (name == "cntrl"): fn(c): c < 32 || c == 127;
  elif (name == "graph"): fn(c): c > 32 && c != 127 && !_jq_re_is_space(c);
  elif (name == "print"): fn(c): c >= 32 && c != 127;
  elif (name == "ascii"): fn(c): c < 128;
  elif (name == "any" || name == "Any"): fn(c): true;
  else: error(name + " is not a valid character class")
end

# ----- parser -----
# Each parse function returns [node, pos, st]; st = {ng, names, i, x, m, s}.

def _jq_re_hex(cps, pos, maxn):
  var v = 0
  | var j = pos
  | let _ = while (j < len(cps) && j - pos < maxn && ((cps[j] >= 48 && cps[j] <= 57) || (cps[j] >= 65 && cps[j] <= 70) || (cps[j] >= 97 && cps[j] <= 102))):
      do v = v * 16 + _jq_hex_digit(implode([cps[j]])) | j += 1 | v end
    end
  | [v, j]
end

def _jq_re_char_node(c, st):
  {t: "char", c: c, ci: st["i"]}
end

# Parses an escape sequence (after the backslash) that denotes a single character;
# returns [code point, next pos] or None when it is not a plain character escape.
def _jq_re_escape_char(cps, pos):
  let e = cps[pos]
  | if (e == 110): [10, pos + 1]
    elif (e == 116): [9, pos + 1]
    elif (e == 114): [13, pos + 1]
    elif (e == 102): [12, pos + 1]
    elif (e == 118): [11, pos + 1]
    elif (e == 101): [27, pos + 1]
    elif (e == 97): [7, pos + 1]
    elif (e == 48): [0, pos + 1]
    elif (e == 120): do
      if (pos + 1 < len(cps) && cps[pos + 1] == 123): do
        let r = _jq_re_hex(cps, pos + 2, 8)
        | [r[0], r[1] + 1]
      end
      else: do
        let r = _jq_re_hex(cps, pos + 1, 2)
        | [r[0], r[1]]
      end
    end
    elif (e == 117): do
      let r = _jq_re_hex(cps, pos + 1, 4)
      | [r[0], r[1]]
    end
    else: None
end

def _jq_re_parse_set(cps, pos, st):
  # pos is just after '['
  var neg = false
  | var cur = pos
  | let _ = if (cur < len(cps) && cps[cur] == 94): do neg = true | cur += 1 end
  | var ranges = []
  | var preds = []
  | var first = true
  | var done = false
  | let n = len(cps)
  | let _ = while (!done):
      do
        if (cur >= n): error("premature end of char-class")
        | let c = cps[cur]
        | if (c == 93 && !first): do done = true | cur += 1 end
          elif (c == 91 && cur + 1 < n && cps[cur + 1] == 58): do
            # POSIX bracket [:name:]
            var j = cur + 2
            | let _ = while (j < n && cps[j] != 58): j += 1 end
            | let raw = implode(slice(cps, cur + 2, j))
            | let pneg = starts_with(raw, "^")
            | let pname = if (pneg): slice(raw, 1, len(raw)) else: raw
            | preds += [{name: pname, neg: pneg}]
            | cur = j + 2
          end
          elif (c == 91): do
            let r = _jq_re_parse_set(cps, cur + 1, st)
            | preds += [{sub: r[0], neg: false}]
            | cur = r[1]
          end
          else: do
            # single item or range start
            var lo = c
            | var is_class = false
            | cur += 1
            | let _ = if (c == 92): do
                let e = cps[cur]
                | if (e == 100 || e == 119 || e == 115 || e == 104): do
                    preds += [{name: implode([e]), neg: false}]
                    | is_class = true
                    | cur += 1
                  end
                  elif (e == 68 || e == 87 || e == 83 || e == 72): do
                    preds += [{name: implode([e + 32]), neg: true}]
                    | is_class = true
                    | cur += 1
                  end
                  elif (e == 112 || e == 80): do
                    var j = cur + 2
                    | let _ = while (j < n && cps[j] != 125): j += 1 end
                    | let raw = implode(slice(cps, cur + 2, j))
                    | let pneg = (e == 80) != starts_with(raw, "^")
                    | preds += [{name: if (starts_with(raw, "^")): slice(raw, 1, len(raw)) else: raw, neg: pneg}]
                    | is_class = true
                    | cur = j + 1
                  end
                  else: do
                    let r = _jq_re_escape_char(cps, cur)
                    | if (is_none(r)): do lo = e | cur += 1 end
                      else: do lo = r[0] | cur = r[1] end
                  end
              end
            | if (!is_class): do
                if (cur + 1 < n && cps[cur] == 45 && cps[cur + 1] != 93): do
                  var hi = cps[cur + 1]
                  | cur += 2
                  | let _ = if (hi == 92): do
                      let r = _jq_re_escape_char(cps, cur)
                      | if (is_none(r)): do hi = cps[cur] | cur += 1 end
                        else: do hi = r[0] | cur = r[1] end
                    end
                  | ranges += [[lo, hi]]
                end
                else: ranges += [[lo, lo]]
              end
          end
        | first = false
      end
    end
  | [{t: "set", neg: neg, ranges: ranges, preds: preds, ci: st["i"]}, cur]
end

def _jq_re_parse_name(cps, pos, close):
  var j = pos
  | let _ = while (j < len(cps) && cps[j] != close): j += 1 end
  | [implode(slice(cps, pos, j)), j + 1]
end

def _jq_re_parse_group(cps, pos, st):
  # pos is just after '('
  let n = len(cps)
  | let saved_flags = {i: st["i"], x: st["x"], m: st["m"], s: st["s"]}
  | let restore = fn(st2): set(set(set(set(st2, "i", saved_flags["i"]), "x", saved_flags["x"]), "m", saved_flags["m"]), "s", saved_flags["s"]);
  | let finish = fn(kind, extra, r):
      do
        if (r[1] >= n || cps[r[1]] != 41): error("end pattern with unmatched parenthesis")
        | [set(extra, "node", r[0]), r[1] + 1, restore(r[2])]
      end
    ;
  | if (pos < n && cps[pos] == 63): do
      let c1 = if (pos + 1 < n): cps[pos + 1] else: 0
      | let c2 = if (pos + 2 < n): cps[pos + 2] else: 0
      | if (c1 == 58): finish("nc", {t: "ncgroup"}, _jq_re_p_alt(cps, pos + 2, st))
        elif (c1 == 61): finish("la", {t: "look", ahead: true, neg: false}, _jq_re_p_alt(cps, pos + 2, st))
        elif (c1 == 33): finish("la", {t: "look", ahead: true, neg: true}, _jq_re_p_alt(cps, pos + 2, st))
        elif (c1 == 62): finish("at", {t: "atomic"}, _jq_re_p_alt(cps, pos + 2, st))
        elif (c1 == 60 && c2 == 61): finish("lb", {t: "look", ahead: false, neg: false}, _jq_re_p_alt(cps, pos + 3, st))
        elif (c1 == 60 && c2 == 33): finish("lb", {t: "look", ahead: false, neg: true}, _jq_re_p_alt(cps, pos + 3, st))
        elif (c1 == 35): do
          var j = pos + 2
          | let _ = while (j < n && cps[j] != 41): j += 1 end
          | [{t: "empty"}, j + 1, st]
        end
        elif (c1 == 60 || c1 == 80 || c1 == 39): do
          let start = if (c1 == 80): pos + 3 else: pos + 2
          | let nm = _jq_re_parse_name(cps, start, if (c1 == 39): 39 else: 62)
          | let idx = st["ng"] + 1
          | let st1 = set(set(st, "ng", idx), "names", st["names"] + [nm[0]])
          | finish("cap", {t: "group", idx: idx}, _jq_re_p_alt(cps, nm[1], st1))
        end
        else: do
          # inline flags: (?imsx-imsx) or (?imsx-imsx:subexpr)
          var j = pos + 1
          | var on = true
          | var st1 = st
          | let _ = while (j < n && cps[j] != 41 && cps[j] != 58):
              do
                let ch = cps[j]
                | if (ch == 45): on = false
                  elif (ch == 105): st1 = set(st1, "i", on)
                  elif (ch == 120): st1 = set(st1, "x", on)
                  elif (ch == 109): st1 = set(st1, "m", on)
                  elif (ch == 115): st1 = set(st1, "s", on)
                  else: error("undefined group option")
                | j += 1
              end
            end
          | if (j < n && cps[j] == 41): [{t: "empty"}, j + 1, st1]
            else: finish("fl", {t: "ncgroup"}, _jq_re_p_alt(cps, j + 1, st1))
        end
    end
    else: do
      let idx = st["ng"] + 1
      | let st1 = set(set(st, "ng", idx), "names", st["names"] + [None])
      | finish("cap", {t: "group", idx: idx}, _jq_re_p_alt(cps, pos, st1))
    end
end

def _jq_re_parse_quant(cps, pos, node):
  let n = len(cps)
  | if (pos >= n): [node, pos]
    else: do
      let c = cps[pos]
      | let bounds = if (c == 42): [0, 1000000000, pos + 1]
          elif (c == 43): [1, 1000000000, pos + 1]
          elif (c == 63): [0, 1, pos + 1]
          elif (c == 123): do
            # {n} {n,} {n,m} {,m}
            var j = pos + 1
            | var a = ""
            | let _ = while (j < n && cps[j] >= 48 && cps[j] <= 57): do a += implode([cps[j]]) | j += 1 end end
            | if (j < n && cps[j] == 125 && a != ""): [to_number(a), to_number(a), j + 1]
              elif (j < n && cps[j] == 44): do
                var b = ""
                | j += 1
                | let _ = while (j < n && cps[j] >= 48 && cps[j] <= 57): do b += implode([cps[j]]) | j += 1 end end
                | if (j < n && cps[j] == 125 && (a != "" || b != "")):
                    [if (a == ""): 0 else: to_number(a), if (b == ""): 1000000000 else: to_number(b), j + 1]
                  else: None
              end
              else: None
          end
          else: None
      | if (is_none(bounds)): [node, pos]
        else: do
          let after = bounds[2]
          | let lazy = after < n && cps[after] == 63
          | let poss = after < n && cps[after] == 43
          | let np = if (lazy || poss): after + 1 else: after
          | let rep = {t: "rep", node: node, min: bounds[0], max: bounds[1], lazy: lazy, poss: poss}
          | _jq_re_parse_quant(cps, np, rep)
        end
    end
end

def _jq_re_parse_atom(cps, pos, st):
  let c = cps[pos]
  | let n = len(cps)
  | if (c == 40): _jq_re_parse_group(cps, pos + 1, st)
    elif (c == 91): do
      let r = _jq_re_parse_set(cps, pos + 1, st)
      | [r[0], r[1], st]
    end
    elif (c == 46): [{t: "any", dotall: st["s"]}, pos + 1, st]
    elif (c == 94): [{t: "bol", m: st["m"]}, pos + 1, st]
    elif (c == 36): [{t: "eol", m: st["m"]}, pos + 1, st]
    elif (c == 92): do
      if (pos + 1 >= n): error("end pattern at escape")
      | let e = cps[pos + 1]
      | if (e == 100 || e == 119 || e == 115 || e == 104): [{t: "set", neg: false, ranges: [], preds: [{name: implode([e]), neg: false}], ci: false}, pos + 2, st]
        elif (e == 68 || e == 87 || e == 83 || e == 72): [{t: "set", neg: false, ranges: [], preds: [{name: implode([e + 32]), neg: true}], ci: false}, pos + 2, st]
        elif (e == 98): [{t: "wordb", neg: false}, pos + 2, st]
        elif (e == 66): [{t: "wordb", neg: true}, pos + 2, st]
        elif (e == 65): [{t: "bos"}, pos + 2, st]
        elif (e == 122): [{t: "eos"}, pos + 2, st]
        elif (e == 90): [{t: "eosnl"}, pos + 2, st]
        elif (e == 71): [{t: "empty"}, pos + 2, st]
        elif (e == 112 || e == 80): do
          # \p{Name} / \P{Name} / \p{^Name}
          if (pos + 2 >= n || cps[pos + 2] != 123): error("invalid character property name {}")
          | var j = pos + 3
          | let _ = while (j < n && cps[j] != 125): j += 1 end
          | let raw = implode(slice(cps, pos + 3, j))
          | let pneg = (e == 80) != starts_with(raw, "^")
          | [{t: "set", neg: false, ranges: [], preds: [{name: if (starts_with(raw, "^")): slice(raw, 1, len(raw)) else: raw, neg: pneg}], ci: false}, j + 1, st]
        end
        elif (e == 107): do
          # \k<name>
          let nm = _jq_re_parse_name(cps, pos + 3, 62)
          | [{t: "backref", name: nm[0], ci: st["i"]}, nm[1], st]
        end
        elif (e >= 49 && e <= 57): do
          var j = pos + 2
          | var num = e - 48
          | let _ = while (j < n && cps[j] >= 48 && cps[j] <= 57 && num * 10 + (cps[j] - 48) <= st["ng"]): do num = num * 10 + (cps[j] - 48) | j += 1 end end
          | [{t: "backref", idx: num, ci: st["i"]}, j, st]
        end
        else: do
          let r = _jq_re_escape_char(cps, pos + 1)
          | if (is_none(r)): [_jq_re_char_node(e, st), pos + 2, st]
            else: [_jq_re_char_node(r[0], st), r[1], st]
        end
    end
    else: [_jq_re_char_node(c, st), pos + 1, st]
end

def _jq_re_p_seq(cps, pos, st):
  let n = len(cps)
  | var items = []
  | var cur = pos
  | var stx = st
  | let _ = while (cur < n && cps[cur] != 124 && cps[cur] != 41):
      do
        if (stx["x"] && (_jq_re_is_space(cps[cur]))): cur += 1
        elif (stx["x"] && cps[cur] == 35): do
          let _ = while (cur < n && cps[cur] != 10): cur += 1 end
          | cur
        end
        else: do
          let r = _jq_re_parse_atom(cps, cur, stx)
          | let q = _jq_re_parse_quant(cps, r[1], r[0])
          | items += [q[0]]
          | cur = q[1]
          | stx = r[2]
        end
      end
    end
  | [{t: "seq", items: items}, cur, stx]
end

def _jq_re_p_alt(cps, pos, st):
  let n = len(cps)
  | let r = _jq_re_p_seq(cps, pos, st)
  | var alts = [r[0]]
  | var cur = r[1]
  | var stx = r[2]
  | let _ = while (cur < n && cps[cur] == 124):
      do
        let r2 = _jq_re_p_seq(cps, cur + 1, stx)
        | alts += [r2[0]]
        | cur = r2[1]
        | stx = r2[2]
      end
    end
  | [if (len(alts) == 1): alts[0] else: {t: "alt", alts: alts}, cur, stx]
end

# ----- compiler -----

def _jq_re_set_pred(node):
  let ranges = node["ranges"]
  | let preds = map(node["preds"], fn(p):
      if (!is_none(p["sub"])): {f: _jq_re_set_pred(p["sub"]), neg: false}
      else: {f: _jq_re_class(p["name"]), neg: p["neg"]};)
  | let neg = node["neg"]
  | let ci = node["ci"]
  | fn(c):
      do
        let hit_range = fold(ranges, false, fn(a, r): a || (c >= r[0] && c <= r[1]);)
        | let hit_ci = if (!hit_range && ci): do
            let fc = _jq_re_fold(c)
            | let uc = if (c >= 97 && c <= 122): c - 32 else: c
            | fold(ranges, false, fn(a, r): a || (fc >= r[0] && fc <= r[1]) || (uc >= r[0] && uc <= r[1]);)
          end
          else: false
        | let hit_pred = fold(preds, false, fn(a, p): a || (p["f"](c) != p["neg"]);)
        | (hit_range || hit_ci || hit_pred) != neg
      end;
end

# Returns a single-character predicate fn(c) for char/any/set nodes, else None.
def _jq_re_single(node):
  let t = node["t"]
  | if (t == "char"): do
      let c = node["c"]
      | if (node["ci"]): do
          let fc = _jq_re_fold(c)
          | fn(x): _jq_re_fold(x) == fc;
        end
        else: fn(x): x == c;
    end
    elif (t == "any"): do
      if (node["dotall"]): fn(x): true; else: fn(x): x != 10;
    end
    elif (t == "set"): _jq_re_set_pred(node)
    else: None
end

def _jq_re_rep_gen(m, mn, mx, lazy, s, i, caps, k, count):
  if (lazy):
    (count >= mn && k(i, caps)) || (count < mx && m(s, i, caps, fn(i2, c2):
      if (i2 == i && count >= mn): k(i2, c2) else: _jq_re_rep_gen(m, mn, mx, lazy, s, i2, c2, k, count + 1);))
  else:
    (count < mx && m(s, i, caps, fn(i2, c2):
      if (i2 == i && count >= mn): k(i2, c2) else: _jq_re_rep_gen(m, mn, mx, lazy, s, i2, c2, k, count + 1);)) || (count >= mn && k(i, caps))
end

def _jq_re_seq_chain(ms, idx):
  if (idx >= len(ms) - 1): ms[idx]
  else: do
    let a = ms[idx]
    | let rest = _jq_re_seq_chain(ms, idx + 1)
    | fn(s, i, caps, k): a(s, i, caps, fn(i2, c2): rest(s, i2, c2, k););
  end
end

def _jq_re_compile_node(node, names):
  let t = node["t"]
  | if (t == "empty"): fn(s, i, caps, k): k(i, caps);
    elif (t == "char" || t == "any" || t == "set"): do
      let pred = _jq_re_single(node)
      | fn(s, i, caps, k): if (i < len(s) && pred(s[i])): k(i + 1, caps) else: false;
    end
    elif (t == "seq"): do
      let ms = map(node["items"], fn(x): _jq_re_compile_node(x, names);)
      | if (is_empty(ms)): fn(s, i, caps, k): k(i, caps);
        else: _jq_re_seq_chain(ms, 0)
    end
    elif (t == "alt"): do
      let ms = map(node["alts"], fn(x): _jq_re_compile_node(x, names);)
      | fn(s, i, caps, k): fold(ms, false, fn(a, m): a || m(s, i, caps, k););
    end
    elif (t == "group"): do
      let m = _jq_re_compile_node(node["node"], names)
      | let a = node["idx"] * 2
      | fn(s, i, caps, k): m(s, i, caps, fn(i2, c2): k(i2, set(set(c2, a, i), a + 1, i2)););
    end
    elif (t == "ncgroup"): _jq_re_compile_node(node["node"], names)
    elif (t == "rep"): do
      let inner = node["node"]
      | let mn = node["min"]
      | let mx = node["max"]
      | let pred = _jq_re_single(inner)
      | if (!is_none(pred)):
          if (node["lazy"]):
            fn(s, i, caps, k):
              do
                let n = len(s)
                | var j = i
                | var cnt = 0
                | var ok = false
                | let _ = while (cnt < mn && j < n && pred(s[j])): do j += 1 | cnt += 1 end end
                | if (cnt < mn): false
                  else: do
                    var res = false
                    | var go = true
                    | let _ = while (go):
                        do
                          if (k(j, caps)): do res = true | go = false end
                            elif (cnt < mx && j < n && pred(s[j])): do j += 1 | cnt += 1 end
                            else: go = false
                        end
                      end
                    | res
                  end
              end;
          else:
            fn(s, i, caps, k):
              do
                let n = len(s)
                | var j = i
                | var cnt = 0
                | let _ = while (cnt < mx && j < n && pred(s[j])): do j += 1 | cnt += 1 end end
                | if (cnt < mn): false
                  elif (node["poss"]): k(j, caps)
                  else: do
                    var res = false
                    | var go = true
                    | let _ = while (go):
                        do
                          if (k(j, caps)): do res = true | go = false end
                            elif (cnt > mn): do j -= 1 | cnt -= 1 end
                            else: go = false
                        end
                      end
                    | res
                  end
              end;
        else: do
          let m = _jq_re_compile_node(inner, names)
          | let lazy = node["lazy"]
          | if (node["poss"]):
              fn(s, i, caps, k):
                do
                  var res = None
                  | let _ = _jq_re_rep_gen(m, mn, mx, false, s, i, caps, fn(i2, c2): do res = [i2, c2] | true end;, 0)
                  | if (is_none(res)): false else: k(res[0], res[1])
                end;
            else: fn(s, i, caps, k): _jq_re_rep_gen(m, mn, mx, lazy, s, i, caps, k, 0);
        end
    end
    elif (t == "bol"): do
      let ml = node["m"]
      | fn(s, i, caps, k): if (i == 0 || (ml && s[i - 1] == 10)): k(i, caps) else: false;
    end
    elif (t == "eol"): do
      let ml = node["m"]
      | fn(s, i, caps, k): if (i == len(s) || (ml && s[i] == 10)): k(i, caps) else: false;
    end
    elif (t == "bos"): fn(s, i, caps, k): if (i == 0): k(i, caps) else: false;
    elif (t == "eos"): fn(s, i, caps, k): if (i == len(s)): k(i, caps) else: false;
    elif (t == "eosnl"): fn(s, i, caps, k): if (i == len(s) || (i == len(s) - 1 && s[i] == 10)): k(i, caps) else: false;
    elif (t == "wordb"): do
      let neg = node["neg"]
      | fn(s, i, caps, k):
          do
            let a = i > 0 && _jq_re_is_word(s[i - 1])
            | let b = i < len(s) && _jq_re_is_word(s[i])
            | if ((a != b) != neg): k(i, caps) else: false
          end;
    end
    elif (t == "look"): do
      let m = _jq_re_compile_node(node["node"], names)
      | let ahead = node["ahead"]
      | let neg = node["neg"]
      | fn(s, i, caps, k):
          do
            var found = None
            | let _ = if (ahead): m(s, i, caps, fn(i2, c2): do found = c2 | true end;)
                else: do
                  var j = i
                  | var hit = false
                  | let _ = while (j >= 0 && !hit):
                      do
                        hit = m(s, j, caps, fn(i2, c2): if (i2 == i): do found = c2 | true end else: false;)
                        | j -= 1
                      end
                    end
                  | hit
                end
            | if (neg): (if (is_none(found)): k(i, caps) else: false)
              else: (if (is_none(found)): false else: k(i, found))
          end;
    end
    elif (t == "atomic"): do
      let m = _jq_re_compile_node(node["node"], names)
      | fn(s, i, caps, k):
          do
            var res = None
            | let _ = m(s, i, caps, fn(i2, c2): do res = [i2, c2] | true end;)
            | if (is_none(res)): false else: k(res[0], res[1])
          end;
    end
    elif (t == "backref"): do
      let ci = node["ci"]
      | let idx = if (is_none(node["name"])): node["idx"] else: index(names, node["name"]) + 1
      | fn(s, i, caps, k):
          do
            let a = caps[idx * 2]
            | let b = caps[idx * 2 + 1]
            | if (a < 0): false
              else: do
                let l = b - a
                | if (i + l > len(s)): false
                  else: do
                    var ok = true
                    | var j = 0
                    | let _ = while (ok && j < l):
                        do
                          let x = s[a + j]
                          | let y = s[i + j]
                          | ok = if (ci): _jq_re_fold(x) == _jq_re_fold(y) else: x == y
                          | j += 1
                        end
                      end
                    | if (ok): k(i + l, caps) else: false
                  end
              end
          end;
    end
    else: error("jq: internal regex error: " + t)
end

# Compiles a pattern with a flag string into a program.
# ----- native engine -----
# Patterns that mq's own regex engine runs the same way jq does are translated from the parsed
# pattern and run natively, which is far faster on long input. Anything else (lookaround,
# backreferences, atomic groups, possessive quantifiers, POSIX classes, \Z, patterns that can
# match the empty string) stays with the engine below.

def _jq_re_hexcp(c):
  if (c < 16): "0123456789abcdef"[c]
  else: _jq_re_hexcp(floor(c / 16)) + "0123456789abcdef"[c % 16]
end

def _jq_re_native_cp(c):
  "\\x{" + _jq_re_hexcp(c) + "}"
end

def _jq_re_native_set(node):
  let ranges = node["ranges"]
  | let preds = node["preds"]
  | let ascii_ci = !node["ci"] || fold(ranges, true, fn(a, r): a && r[1] < 128;)
  | let simple = fold(preds, true, fn(a, p):
      a && is_none(p["sub"]) && (p["name"] == "d" || p["name"] == "w" || p["name"] == "s");)
  | if (!ascii_ci || !simple || (is_empty(ranges) && is_empty(preds))): None
    else: do
      let body = fold(ranges, "", fn(a, r):
          a + (if (r[0] == r[1]): _jq_re_native_cp(r[0]) else: _jq_re_native_cp(r[0]) + "-" + _jq_re_native_cp(r[1]));)
        + fold(preds, "", fn(a, p): a + "\\" + (if (p["neg"]): upcase(p["name"]) else: p["name"]);)
      | let set = "[" + (if (node["neg"]): "^" else: "") + body + "]"
      | [if (node["ci"]): "(?i:" + set + ")" else: set, 1]
    end
end

# Returns [native source, shortest match length] or None when the node cannot be translated.
def _jq_re_native(node):
  let t = node["t"]
  | if (t == "empty"): ["", 0]
    elif (t == "char"): do
      let c = node["c"]
      | if (node["ci"] && c > 127): None
        else: do
          let lit = _jq_re_native_cp(c)
          | [if (node["ci"]): "(?i:" + lit + ")" else: lit, 1]
        end
    end
    elif (t == "any"): [if (node["dotall"]): "(?s:.)" else: ".", 1]
    elif (t == "set"): _jq_re_native_set(node)
    elif (t == "seq"): fold(node["items"], ["", 0], fn(acc, item):
        if (is_none(acc)): None
        else: do
          let r = _jq_re_native(item)
          | if (is_none(r)): None else: [acc[0] + r[0], acc[1] + r[1]]
        end
      ;)
    elif (t == "alt"): do
      let parts = map(node["alts"], _jq_re_native)
      | if (fold(parts, false, fn(a, r): a || is_none(r);)): None
        else: ["(?:" + join(map(parts, fn(r): r[0];), "|") + ")", fold(parts, 1000000000, fn(a, r): if (r[1] < a): r[1] else: a;)]
    end
    elif (t == "ncgroup"): do
      let r = _jq_re_native(node["node"])
      | if (is_none(r)): None else: ["(?:" + r[0] + ")", r[1]]
    end
    elif (t == "group"): do
      let r = _jq_re_native(node["node"])
      | if (is_none(r)): None
        else: ["(" + r[0] + ")", r[1]]
    end
    elif (t == "rep"): do
      let r = _jq_re_native(node["node"])
      | if (is_none(r) || r[1] == 0 || node["poss"] || node["max"] < node["min"]): None
        else: do
          let mx = node["max"]
          | let q = "{" + to_string(node["min"]) + (if (mx >= 1000000000): ",}" else: "," + to_string(mx) + "}")
          | ["(?:" + r[0] + ")" + q + (if (node["lazy"]): "?" else: ""), r[1] * node["min"]]
        end
    end
    elif (t == "bos" || (t == "bol" && !node["m"])): ["\\A", 0]
    elif (t == "eos" || (t == "eol" && !node["m"])): ["\\z", 0]
    elif (t == "bol"): ["(?m:^)", 0]
    elif (t == "eol"): ["(?m:$)", 0]
    elif (t == "wordb"): [if (node["neg"]): "\\B" else: "\\b", 0]
    else: None
end

def _jq_re_compile(re, flags):
  let fl = if (is_none(flags)): "" else: flags
  | if (!is_string(fl)): error(_jq_dump(fl) + " is not a string")
    else: do
      var global = false
      | var noempty = false
      | var st_i = false
      | var st_x = false
      | var st_s = false
      | let _ = foreach (c, explode(fl)):
          if (c == 103): global = true
          elif (c == 105): st_i = true
          elif (c == 120): st_x = true
          elif (c == 110): noempty = true
          elif (c == 112): do st_s = true | noempty = false end
          elif (c == 115 || c == 108): None
          else: error(fl + " is not a valid modifier string")
        end
      | let cps = explode(re)
      | let st0 = {ng: 0, names: [], i: st_i, x: st_x, m: false, s: st_s}
      | let r = _jq_re_p_alt(cps, 0, st0)
      | if (r[1] < len(cps)): error(re + " (at offset " + to_string(r[1]) + ") is not a valid regex: unmatched close parenthesis")
        else: {m: _jq_re_compile_node(r[0], r[2]["names"]), node: r[0], ng: r[2]["ng"], names: r[2]["names"], global: global, noempty: noempty}
    end
end

# Strings at least this long are matched natively when the pattern allows it; shorter ones
# are not worth translating the pattern for.
def _jq_re_native_min_input(): 32;

# Native counterpart of _jq_re_run_own, producing the same jq match objects.
def _jq_re_run_native(prog, src, str, test_only):
  if (test_only): if (is_regex_match(str, src)): [true] else: []
  else: do
    let found = regex_match_info(str, src)
    | let chosen = if (prog["global"]): found else: slice(found, 0, 1)
    | map(chosen, fn(m):
        do
          if (len(m["groups"]) != prog["ng"]): error("native engine disagrees on the group count")
          | {offset: m["char_start"], length: m["char_end"] - m["char_start"], string: m["match"],
              captures: map(if (prog["ng"] == 0): [] else: range(0, prog["ng"] - 1), fn(g):
                do
                  let c = m["groups"][g]
                  | if (is_none(c["match"])): {offset: -1, length: 0, string: None, name: prog["names"][g]}
                    else: {offset: c["char_start"], length: c["char_end"] - c["char_start"], string: c["match"], name: prog["names"][g]}
                end;)}
        end;)
  end
end

def _jq_re_run(prog, str, test_only):
  let nat = if (len(str) >= _jq_re_native_min_input()): _jq_re_native(prog["node"]) else: None
  | if (is_none(nat) || nat[1] == 0): _jq_re_run_own(prog, str, test_only)
    else: try: _jq_re_run_native(prog, nat[0], str, test_only)
      catch(e): _jq_re_run_own(prog, str, test_only)
end

# Finds all matches (or just the first, unless global) of a program in a string.
# Returns jq match objects.
def _jq_re_run_own(prog, str, test_only):
  let s = explode(str)
  | let n = len(s)
  | let ng = prog["ng"]
  | let m = prog["m"]
  | let init_caps = map(range(ng * 2 + 1), fn(_): -1;)
  | var out = []
  | var start = 0
  | var go = true
  | let _ = while (go && start <= n):
      do
        var found = None
        | var j = start
        | let _ = while (is_none(found) && j <= n):
            do
              m(s, j, init_caps, fn(e, caps): do found = [j, e, caps] | true end;)
              | if (is_none(found)): j += 1
            end
          end
        | if (is_none(found)): go = false
          else: do
            let ms = found[0]
            | let me = found[1]
            | let caps = found[2]
            | if (me == ms && prog["noempty"]): start = ms + 1
              else: do
                if (test_only): do out += [true] | go = false end
                  else: do
                    var captures = []
                    | let _ = foreach (g, if (ng == 0): [] else: range(ng - 1)):
                        do
                          let cs = caps[(g + 1) * 2]
                          | let ce = caps[(g + 1) * 2 + 1]
                          | captures += [if (cs < 0): {offset: -1, length: 0, string: None, name: prog["names"][g]}
                              else: {offset: cs, length: ce - cs, string: implode(slice(s, cs, ce)), name: prog["names"][g]}]
                        end
                      end
                    | out += [{offset: ms, length: me - ms, string: implode(slice(s, ms, me)), captures: captures}]
                    | if (!prog["global"]): go = false
                  end
                | start = if (me == ms): ms + 1 else: me
              end
          end
      end
    end
  | out
end

# ----- jq-facing regex helpers -----

def _jq_re_args(v, re, flags):
  # Handles match(["re", "flags"]) and match("re"; "flags")
  if (is_array(re)): do
    if (is_empty(re)): error("array not a string or array")
    | [re[0], if (len(re) > 1): re[1] else: flags]
  end
  elif (is_string(re)): [re, flags]
  else: error(_jq_tn(re) + " not a string or array")
end

def _jq_re_match(v, re, flags, test_only):
  if (!is_string(v)): error(_jq_dump(v) + " cannot be matched, as it is not a string")
  else: do
    let a = _jq_re_args(v, re, flags)
    | if (!is_string(a[0])): error(_jq_dump(a[0]) + " (" + _jq_tn(a[0]) + ") cannot be matched, as it is not a string")
      else: _jq_re_run(_jq_re_compile(a[0], a[1]), v, test_only)
  end
end

def _jq_re_capture_obj(m):
  var d = dict()
  | let _ = foreach (c, m["captures"]): if (!is_none(c["name"])): d = set(d, c["name"], c["string"]) end
  | d
end

# sub / gsub implementation: sc evaluates the replacement against the capture object.
def _jq_re_sub(v, re, flags, global, sc, env, k):
  if (!is_string(v)): error(_jq_dump(v) + " cannot be matched, as it is not a string")
  else: do
    let fl = (if (is_none(flags)): "" else: flags) + (if (global): "g" else: "")
    | let ms = _jq_re_match(v, re, fl, false)
    | if (is_empty(ms)): k(v)
      else: do
        let cps = explode(v)
        | var results = []
        | var prev = 0
        | let _ = foreach (m, ms):
            do
              let gap = implode(slice(cps, prev, m["offset"]))
              | let inserts = _jq_collect(sc, _jq_re_capture_obj(m), env)
              | let _ = foreach (ix, if (is_empty(inserts)): [] else: range(len(inserts) - 1)):
                  do
                    let cur = if (ix < len(results)): results[ix] else: None
                    | let piece = _jq_add(gap, inserts[ix])
                    | let nv = _jq_add(cur, piece)
                    | results = if (ix < len(results)): set(results, ix, nv) else: results + map(range(ix - len(results) - 1), fn(_): None;) + [nv]
                  end
                end
              | prev = m["offset"] + m["length"]
            end
          end
        | let tail = implode(slice(cps, prev, len(cps)))
        | if (is_empty(results)): k(v)
          else: foreach (r, results): k(_jq_add(r, tail)) end
      end
  end
end

# ===== Dates =====
# Broken-down time arrays are [year, month(0-11), day, hours, minutes, seconds, wday, yday]
# and always refer to UTC (jq's *localtime functions are treated as UTC here).

def _jq_days_from_civil(y0, m, d):
  let y = if (m <= 2): y0 - 1 else: y0
  | let era = floor(y / 400)
  | let yoe = y - era * 400
  | let mp = if (m > 2): m - 3 else: m + 9
  | let doy = floor((153 * mp + 2) / 5) + d - 1
  | let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
  | era * 146097 + doe - 719468
end

def _jq_civil_from_days(z0):
  let z = z0 + 719468
  | let era = floor(z / 146097)
  | let doe = z - era * 146097
  | let yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365)
  | let y = yoe + era * 400
  | let doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100))
  | let mp = floor((5 * doy + 2) / 153)
  | let d = doy - floor((153 * mp + 2) / 5) + 1
  | let m = if (mp < 10): mp + 3 else: mp - 9
  | [if (m <= 2): y + 1 else: y, m, d]
end

def _jq_fmod(a, b):
  a - b * floor(a / b)
end

def _jq_gmtime(t):
  if (!is_number(t)): error("gmtime() requires a number")
  else: do
    let secs = floor(t)
    | let frac = t - secs
    | let days = floor(secs / 86400)
    | let rem = secs - days * 86400
    | let c = _jq_civil_from_days(days)
    | let h = floor(rem / 3600)
    | let mi = floor((rem - h * 3600) / 60)
    | let s = rem - h * 3600 - mi * 60 + frac
    | [c[0], c[1] - 1, c[2], h, mi, s, _jq_fmod(days + 4, 7),
       days - _jq_days_from_civil(c[0], 1, 1)]
  end
end

def _jq_check_tm(tm, who):
  if (!is_array(tm) || len(tm) < 3): error(who + " requires array of 6 numbers")
  else: do
    let _ = foreach (x, tm): if (!is_number(x)): error(who + " requires parsed datetime inputs") end
    | tm
  end
end

def _jq_tm_get(tm, i):
  if (i < len(tm)): tm[i] else: 0
end

def _jq_mktime(tm0):
  if (!is_array(tm0)): error("mktime requires array of 6 numbers")
  else: do
    let tm = _jq_check_tm(tm0, "mktime")
    | let mon = _jq_tm_get(tm, 1)
    | let y = tm[0] + floor(mon / 12)
    | let m = _jq_fmod(mon, 12)
    | _jq_days_from_civil(y, m + 1, tm[2]) * 86400 + _jq_tm_get(tm, 3) * 3600 + _jq_tm_get(tm, 4) * 60 + floor(_jq_tm_get(tm, 5))
  end
end

def _jq_pad(n, width, ch):
  let s = to_string(floor(n))
  | if (len(s) >= width): s else: fold(range(width - len(s) - 1), "", fn(a, _): a + ch;) + s
end

def _jq_weekdays():
  ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
end

def _jq_months():
  ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
end

def _jq_strftime_one(spec, tm):
  let y = tm[0]
  | let mon = tm[1]
  | let d = tm[2]
  | let h = _jq_tm_get(tm, 3)
  | let mi = _jq_tm_get(tm, 4)
  | let s = floor(_jq_tm_get(tm, 5))
  | let days = _jq_days_from_civil(y, mon + 1, d)
  | let wday = _jq_fmod(days + 4, 7)
  | let yday = days - _jq_days_from_civil(y, 1, 1)
  | let h12 = if (_jq_fmod(h, 12) == 0): 12 else: _jq_fmod(h, 12)
  | if (spec == "Y"): to_string(y)
    elif (spec == "C"): _jq_pad(floor(y / 100), 2, "0")
    elif (spec == "y"): _jq_pad(_jq_fmod(y, 100), 2, "0")
    elif (spec == "m"): _jq_pad(mon + 1, 2, "0")
    elif (spec == "d"): _jq_pad(d, 2, "0")
    elif (spec == "e"): _jq_pad(d, 2, " ")
    elif (spec == "H"): _jq_pad(h, 2, "0")
    elif (spec == "k"): _jq_pad(h, 2, " ")
    elif (spec == "I"): _jq_pad(h12, 2, "0")
    elif (spec == "l"): _jq_pad(h12, 2, " ")
    elif (spec == "M"): _jq_pad(mi, 2, "0")
    elif (spec == "S"): _jq_pad(s, 2, "0")
    elif (spec == "p"): if (h >= 12): "PM" else: "AM"
    elif (spec == "P"): if (h >= 12): "pm" else: "am"
    elif (spec == "Z"): "UTC"
    elif (spec == "z"): "+0000"
    elif (spec == "a"): slice(_jq_weekdays()[wday], 0, 3)
    elif (spec == "A"): _jq_weekdays()[wday]
    elif (spec == "b" || spec == "h"): slice(_jq_months()[mon], 0, 3)
    elif (spec == "B"): _jq_months()[mon]
    elif (spec == "j"): _jq_pad(yday + 1, 3, "0")
    elif (spec == "u"): to_string(if (wday == 0): 7 else: wday)
    elif (spec == "w"): to_string(wday)
    elif (spec == "s"): to_string(days * 86400 + h * 3600 + mi * 60 + s)
    elif (spec == "U"): _jq_pad(floor((yday + 7 - wday) / 7), 2, "0")
    elif (spec == "W"): _jq_pad(floor((yday + 7 - _jq_fmod(wday + 6, 7)) / 7), 2, "0")
    elif (spec == "T"): _jq_strftime(tm, "%H:%M:%S")
    elif (spec == "D" || spec == "x"): _jq_strftime(tm, "%m/%d/%y")
    elif (spec == "F"): _jq_strftime(tm, "%Y-%m-%d")
    elif (spec == "R"): _jq_strftime(tm, "%H:%M")
    elif (spec == "r"): _jq_strftime(tm, "%I:%M:%S %p")
    elif (spec == "X"): _jq_strftime(tm, "%H:%M:%S")
    elif (spec == "c"): _jq_strftime(tm, "%a %b %e %H:%M:%S %Y")
    elif (spec == "n"): "\n"
    elif (spec == "t"): "\t"
    elif (spec == "%"): "%"
    else: "%" + spec
end

def _jq_strftime(tm, fmt):
  var out = ""
  | var i = 0
  | let cps = to_array(fmt)
  | let n = len(cps)
  | let _ = while (i < n):
      if (cps[i] == "%" && i + 1 < n): do out += _jq_strftime_one(cps[i + 1], tm) | i += 2 end
      else: do out += cps[i] | i += 1 end
    end
  | out
end

def _jq_do_strftime(v, fmt, who):
  if (!is_string(fmt)): error(who + " requires a string format")
  else: do
    let tm = if (is_number(v)): _jq_gmtime(v) elif (is_array(v)): _jq_check_tm(v, who) else: error(who + " requires parsed datetime inputs")
    | _jq_strftime(tm, fmt)
  end
end

# ----- strptime -----

def _jq_read_digits(cps, pos, maxn):
  var j = pos
  | let _ = while (j < len(cps) && j - pos < maxn && cps[j] >= "0" && cps[j] <= "9"): j += 1 end
  | if (j == pos): None else: [to_number(join(slice(cps, pos, j), "")), j]
end

def _jq_read_name(cps, pos, names):
  var found = None
  | let _ = foreach (i, range(len(names) - 1)):
      if (is_none(found)):
        do
          let full = names[i]
          | let ab = slice(full, 0, 3)
          | let rest = join(slice(cps, pos, len(cps)), "")
          | if (starts_with(downcase(rest), downcase(full))): found = [i, pos + len(full)]
            elif (starts_with(downcase(rest), downcase(ab))): found = [i, pos + 3]
        end
    end
  | found
end

def _jq_strptime(str, fmt):
  var y = 1900
  | var mon = 0
  | var d = 1
  | var h = 0
  | var mi = 0
  | var sec = 0
  | var pm = None
  | var yday_given = None
  | var epoch = None
  | var ok = true
  | var si = 0
  | var fi = 0
  | let sc = to_array(str)
  | let fc = to_array(fmt)
  | let sn = len(sc)
  | let fnn = len(fc)
  | let _ = while (ok && fi < fnn):
      do
        let f = fc[fi]
        | if (f == "%" && fi + 1 < fnn): do
            let spec = fc[fi + 1]
            | fi += 2
            | let num = fn(maxn, store):
                do
                  let r = _jq_read_digits(sc, si, maxn)
                  | if (is_none(r)): ok = false
                    else: do store(r[0]) | si = r[1] end
                end
              ;
            | if (spec == "Y"): num(4, fn(x): y = x;)
              elif (spec == "m"): num(2, fn(x): mon = x - 1;)
              elif (spec == "d" || spec == "e"): do
                let _ = while (si < sn && sc[si] == " "): si += 1 end
                | num(2, fn(x): d = x;)
              end
              elif (spec == "H" || spec == "k"): num(2, fn(x): h = x;)
              elif (spec == "I" || spec == "l"): num(2, fn(x): h = _jq_fmod(x, 12);)
              elif (spec == "M"): num(2, fn(x): mi = x;)
              elif (spec == "S"): num(2, fn(x): sec = x;)
              elif (spec == "y"): num(2, fn(x): y = if (x < 69): 2000 + x else: 1900 + x;)
              elif (spec == "j"): num(3, fn(x): yday_given = x - 1;)
              elif (spec == "s"): num(20, fn(x): epoch = x;)
              elif (spec == "p"): do
                let rest = downcase(join(slice(sc, si, sn), ""))
                | if (starts_with(rest, "am")): do pm = false | si += 2 end
                  elif (starts_with(rest, "pm")): do pm = true | si += 2 end
                  else: ok = false
              end
              elif (spec == "a" || spec == "A"): do
                let r = _jq_read_name(sc, si, _jq_weekdays())
                | if (is_none(r)): ok = false else: si = r[1]
              end
              elif (spec == "b" || spec == "B" || spec == "h"): do
                let r = _jq_read_name(sc, si, _jq_months())
                | if (is_none(r)): ok = false else: do mon = r[0] | si = r[1] end
              end
              elif (spec == "Z"): do
                let _ = while (si < sn && ((sc[si] >= "A" && sc[si] <= "Z") || (sc[si] >= "a" && sc[si] <= "z"))): si += 1 end
                | si
              end
              elif (spec == "z"): do
                if (si < sn && sc[si] == "Z"): si += 1
                elif (si < sn && (sc[si] == "+" || sc[si] == "-")): do
                  si += 1
                  | let r = _jq_read_digits(sc, si, 2)
                  | if (is_none(r)): ok = false
                    else: do
                      si = r[1]
                      | let _ = if (si < sn && sc[si] == ":"): si += 1
                      | let r2 = _jq_read_digits(sc, si, 2)
                      | if (!is_none(r2)): si = r2[1]
                    end
                end
                else: ok = false
              end
              elif (spec == "T"): do
                let r = _jq_strptime_parts(sc, si, "%H:%M:%S")
                | if (is_none(r)): ok = false else: do h = r[0] | mi = r[1] | sec = r[2] | si = r[3] end
              end
              elif (spec == "F"): do
                let r = _jq_strptime_parts(sc, si, "%Y-%m-%d")
                | if (is_none(r)): ok = false else: do y = r[0] | mon = r[1] | d = r[2] | si = r[3] end
              end
              elif (spec == "%"): if (si < sn && sc[si] == "%"): si += 1 else: ok = false
              elif (spec == "n" || spec == "t"): do
                let _ = while (si < sn && _jq_re_is_space(first(explode(sc[si])))): si += 1 end
                | si
              end
              else: ok = false
          end
          elif (f == " " || f == "\t" || f == "\n"): do
            let _ = while (si < sn && _jq_re_is_space(first(explode(sc[si])))): si += 1 end
            | fi += 1
          end
          else: if (si < sn && sc[si] == f): do si += 1 | fi += 1 end
            else: ok = false
      end
    end
  | if (!ok || si < sn): error("date \"" + str + "\" does not match format \"" + fmt + "\"")
    else: do
      let hh = if (is_none(pm)): h elif (pm): h + 12 else: h
      | if (!is_none(epoch)): _jq_gmtime(epoch)
        else: do
          let days = _jq_days_from_civil(y, mon + 1, d)
          | [y, mon, d, hh, mi, sec, _jq_fmod(days + 4, 7), days - _jq_days_from_civil(y, 1, 1)]
        end
    end
end

# Parses a fixed numeric format like %H:%M:%S; returns the numbers and the new position.
def _jq_strptime_parts(sc, pos, fmt):
  var vals = []
  | var si = pos
  | var ok = true
  | let fc = to_array(fmt)
  | var fi = 0
  | let _ = while (ok && fi < len(fc)):
      if (fc[fi] == "%"): do
        let maxn = if (fc[fi + 1] == "Y"): 4 else: 2
        | let r = _jq_read_digits(sc, si, maxn)
        | if (is_none(r)): ok = false
          else: do vals += [r[0]] | si = r[1] end
        | fi += 2
      end
      else: do
        if (si < len(sc) && sc[si] == fc[fi]): si += 1 else: ok = false
        | fi += 1
      end
    end
  | if (!ok): None
    elif (fmt == "%H:%M:%S"): [vals[0], vals[1], vals[2], si]
    else: [vals[0], vals[1] - 1, vals[2], si]
end

def _jq_do_strptime(v, fmt):
  if (!is_string(v) || !is_string(fmt)): error("strptime/1 requires string inputs and arguments")
  else: _jq_strptime(v, fmt)
end
